func _capacity(receiver: Dictionary,added: Dictionary) -> bool:
	var n=receiver.crew.able+receiver.crew.wounded+receiver.crew.prisoners+added.able+added.wounded+added.prisoners
	if not _require(_count(n) and n<=Catalog.DATA.profiles[receiver.profileId].maxCrew,"insufficient-crew-capacity"):return false
