		if receipt.get("kind")=="shipment-arrived":delivered+=receipt.grain;last_arrival=max(last_arrival,receipt.arrivedAt)
		elif not voyage.is_empty() and voyage.status!="lost":pending+=s.vessels[voyage.vesselId].cargo.get("grain",0)
		finished=finished and not voyage.is_empty() and voyage.status in ["arrived","lost"]
