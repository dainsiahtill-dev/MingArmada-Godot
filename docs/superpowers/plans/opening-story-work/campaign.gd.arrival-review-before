		var v=s.vessels.get(id,{});var ship=_ship(native.snapshot,id)
		if not _require(not v.is_empty() and not ship.is_empty() and ship.hull>0 and v.damage.hull>0 and v.damage.fire<=0 and v.damage.flooding<=0,"prize-unavailable"):return
