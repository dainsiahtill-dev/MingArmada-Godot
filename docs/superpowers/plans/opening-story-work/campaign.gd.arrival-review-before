	var ct=s.contracts[cid];var quantity=40 if cid=="convoy-001" else 20;var bonus=100 if cid=="convoy-001" else 50
	var loaded=0
	for r in s.settlements.values():
		if r.get("details",{}).get("kind")=="convoy-load" and r.details.contractId==cid:loaded=r.details.loaded;break
	var delivered=0;var pending=0;var last_arrival=0;var finished=loaded>0 and not ct.voyageIds.is_empty()
	for vid in ct.voyageIds:
		var voyage=s.voyages.get(vid,{})
