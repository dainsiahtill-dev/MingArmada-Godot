func prize_state(target_id: String,state: Dictionary={}) -> Dictionary:
	var s=_state if state.is_empty() else state
	var target=s.vessels.get(target_id,{})
	if target.is_empty():return {}
	for role in Catalog.DATA.roles:
		if target_id==s.campaignId+"-"+role.suffix and role.ownerId!="enemy":return {}
	var b={}
	for boarding in s.boardings.values():
		if boarding.targetId==target_id and _winning(s,boarding):b=boarding;break
	if b.is_empty():return {}
	var allocation=s.settlements.get(s.campaignId+":prize:"+target_id,{});var d=allocation.get("details",{})
	var allocated=allocation.get("kind")=="allocate-prize" and d.get("kind")=="prize" and d.targetId==target_id and d.fromShipId!=target_id and d.crew>=max(12,target.crew.minimum)
	var recorded=s.prizes.get(target_id,{})
	if not recorded.is_empty():
		if recorded.targetId!=target_id or recorded.boardingId!=b.id or recorded.originalOwnerId!="enemy":return {}
		if recorded.status in ["held","crewed"]:
			if recorded.resolutionReceiptId!=null or recorded.status=="held" and (allocated or target.ownerId!="enemy") or recorded.status=="crewed" and (not allocated or target.ownerId!="captain"):return {}
		else:
			var id=s.campaignId+":prize-disposition:"+target_id;var receipt=s.settlements.get(id,{});var detail=receipt.get("details",{})
			if recorded.resolutionReceiptId!=id:return {}
			if recorded.status in ["released","abandoned"]:
				if allocated or target.ownerId!=("released-prize" if recorded.status=="released" else "abandoned-prize") or receipt.get("kind")!="resolve-prize" or detail.get("kind")!="prize-resolution" or detail.targetId!=target_id or detail.boardingId!=b.id or detail.choice!=("release" if recorded.status=="released" else "abandon"):return {}
			elif not allocated or target.ownerId!=("port-prize" if recorded.status=="sold" else "captain") or receipt.get("kind")!=("sell-prize" if recorded.status=="sold" else "incorporate-prize") or detail.get("kind")!="prize-port" or detail.shipId!=target_id or detail.action!=("sell" if recorded.status=="sold" else "incorporate"):return {}
		return recorded.duplicate(true)
	if target.ownerId!=("captain" if allocated else "enemy"):return {}
	return {"targetId":target_id,"boardingId":b.id,"originalOwnerId":"enemy","status":"crewed" if allocated else "held","resolutionReceiptId":null}
func is_retired_prize(id: String) -> bool:return prize_state(id).get("status")=="sold"
func quote_prize_sale(id: String,state: Dictionary={}) -> int:
