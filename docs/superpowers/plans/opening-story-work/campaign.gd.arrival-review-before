func _quote_port(s: Dictionary,c: Dictionary) -> Dictionary:
	if not c.get("type") in ["repair","refit","treat-wounded"]:return {"ok":false,"reason":"invalid-service"}
	var v=s.vessels.get(c.get("shipId"),{})
	if v.is_empty():return {"ok":false,"reason":"unknown-ship"}
	if s.currentPortId==null or not s.ports.has(s.currentPortId):return {"ok":false,"reason":"not-in-port"}
	if v.damage.hull<=0:return {"ok":false,"reason":"ship-not-docked"}
	for w in s.works.values():
		if w.shipId==v.id and w.status=="active":return {"ok":false,"reason":"ship-working"}
	if v.id in _boarding_ids(s):return {"ok":false,"reason":"ship-boarding"}
	if s.works.size()>=128:return {"ok":false,"reason":"work-buffer-full"}
	var p=Catalog.DATA.profiles[v.profileId];var light=s.currentPortId=="forward-supply";var hull=0;var sail=0;var cost=0;var duration=0;var quantity=0;var target=null
	if c.type=="treat-wounded":
		if not _count(v.crew.able+v.crew.wounded+v.crew.prisoners) or v.crew.able+v.crew.wounded+v.crew.prisoners>p.maxCrew:return {"ok":false,"reason":"invalid-treatment-reservation"}
		quantity=c.get("quantity")
		if not _count(quantity) or quantity<=0:return {"ok":false,"reason":"invalid-quantity"}
		cost=4*quantity;duration=30*quantity
		if not _count(cost) or not _count(duration):return {"ok":false,"reason":"numeric-overflow"}
		if not v.crew.wounded:return {"ok":false,"reason":"no-wounded"}
		if quantity>v.crew.wounded:return {"ok":false,"reason":"insufficient-wounded"}
	elif c.type=="refit":
		if c.get("slot")!="sails" or s.currentPortId!="xiamen" or v.ownerId!="captain" or p.refitProfileId==null:return {"ok":false,"reason":"refit-forbidden"}
		cost=150;duration=120;target=p.refitProfileId
	else:
		hull=min(20 if light else p.maxHull,p.maxHull-v.damage.hull);sail=min(20 if light else p.maxSail,p.maxSail-v.damage.sail);cost=ceil((hull+sail)*2);duration=max(1,ceil((hull+sail)/2.0))
		if not cost:return {"ok":false,"reason":"no-damage"}
	if not _finite(s.simulationSeconds+duration) or s.simulationSeconds+duration>MAX_SAFE:return {"ok":false,"reason":"numeric-overflow"}
	if s.captain.silver<cost:return {"ok":false,"reason":"insufficient-silver"}
	return {"ok":true,"cost":cost,"duration":duration,"hull":hull,"sail":sail,"targetProfileId":target,"quantity":quantity}
func _port_command(s: Dictionary,c: Dictionary,native: Dictionary,policy: Dictionary) -> Dictionary:
	if c.type=="dock":
		_safe_dock(s,native,policy,c.portId)
