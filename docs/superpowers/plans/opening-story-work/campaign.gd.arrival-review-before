		s.currentPortId=c.portId;var anchors=[]
		for ship in native.snapshot.ships:
			if ship.id in policy.controllableShipIds and _distance(ship.visual.position,s.ports[c.portId].position)<=55:
				anchors.append(ship.id);var v=s.vessels[ship.id];v.pose.speed=0;v.controls.rudder=0;v.controls.sailDeployment=0;v.controlsRevision+=1
