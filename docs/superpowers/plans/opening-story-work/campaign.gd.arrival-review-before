func near_field_setup(vessel: Dictionary,team: String="neutral") -> Dictionary:
	_error=""
	if not Catalog.DATA.profiles.has(vessel.get("profileId")):return {}
	var p=Catalog.DATA.profiles[vessel.profileId];var draft=effective_draft(vessel)
	if not _error.is_empty():return {}
	var setup={"id":vessel.id,"name":vessel.name,"kind":p.modelKind,"team":team,"position":vessel.pose.position.duplicate(),"heading":vessel.pose.heading,"speed":vessel.pose.speed,"hull":vessel.damage.hull,"sail":vessel.damage.sail,"crew":vessel.crew.able,"ammo":vessel.combat.ammo.duplicate(),"ammoType":vessel.combat.ammoType,"cooldownSeconds":vessel.combat.cooldownSeconds.duplicate(),"stats":{"maxHull":p.maxHull,"maxCrew":p.maxCrew,"speedMultiplier":p.speedMultiplier,"cargoMass":_sum(vessel.cargo)*100,"draftMeters":draft}}
	setup.merge(vessel.controls.duplicate())
	return setup
