static func _count(n) -> bool: return typeof(n) in [TYPE_INT,TYPE_FLOAT] and is_finite(float(n)) and n>=0 and n<=MAX_SAFE and n==floor(float(n))
static func _finite(n) -> bool: return typeof(n) in [TYPE_INT,TYPE_FLOAT] and is_finite(float(n))
static func _has_controls(s: String) -> bool:
	for i in s.length():
		if s.unicode_at(i)<32 or s.unicode_at(i)==127: return true
	return false
static func _utf16_length(s: String) -> int:
	var count=0
	for i in s.length():count+=2 if s.unicode_at(i)>65535 else 1
	return count
static func _valid_id(s, maximum: int=128) -> bool: return s is String and not s.strip_edges().is_empty() and _utf16_length(s)<=maximum and not _has_controls(s) and not s in ["__proto__","prototype","constructor"]
static func _exact(d, keys: Array) -> bool:
	if not d is Dictionary or d.size()!=keys.size(): return false
	for k in keys:
		if not d.has(k): return false
	return true
static func _sum(d: Dictionary) -> float:
	var n = 0.0
	for q in d.values(): n += q
	return n
static func _distance(a: Dictionary,b: Dictionary) -> float: return sqrt(pow(a.x-b.x,2)+pow(a.z-b.z,2))
static func _failure(code: String) -> Dictionary: return {"ok":false,"code":code,"reason":code}
func _require(condition: bool, code: String) -> bool:
	if not condition and _error.is_empty(): _error = code
	return condition
static func calendar_at(seconds: float) -> Dictionary:
	var days = int(floor(seconds/1800.0))
	var year = 1650
	var cycles = int(floor(days/146097.0))
	days -= cycles*146097
	year += cycles*400
	while true:
		var length = 366 if year%4==0 and (year%100!=0 or year%400==0) else 365
		if days<length: break
		days -= length
		year += 1
	var months = [31,29 if year%4==0 and (year%100!=0 or year%400==0) else 28,31,30,31,30,31,31,30,31,30,31]
	var month = 0
	while days>=months[month]:
		days -= months[month]
		month += 1
	return {"year":year,"month":month+1,"day":days+1}
func _record(s: Dictionary,id: String,kind: String,message: String,causes: Array,details = null):
	if s.settlements.has(id): return
	if not _require(s.chronicle.size()<4096,"event-buffer-full"): return
	var receipt = {"id":id,"commandId":id,"revision":s.revision,"kind":kind,"message":message}
	if details!=null: receipt.details=details.duplicate(true)
	s.settlements[id]=receipt
	s.chronicle.append({"id":id,"simTime":s.simulationSeconds,"date":s.calendar.duplicate(true),"causeIds":causes.duplicate(true),"kind":kind,"message":message})
func effective_draft(v: Dictionary) -> float:
	var p = Catalog.DATA.profiles.get(v.profileId,{})
	if not _require(not p.is_empty(),"Unknown vessel profile"): return NAN
	for q in v.cargo.values():
		if not _require(_count(q),"Invalid cargo quantity"): return NAN
	var units = _sum(v.cargo)
	if not _require(_count(units) and units<=p.capacity,"Cargo exceeds capacity"): return NAN
	return p.baseDraftMeters+units*p.cargoDraftMetersPerUnit
static func locate_route(v: Dictionary,r: Dictionary) -> Dictionary:
	var best = {"leg":0,"progress":0}
	var closest = INF
	for leg in r.points.size()-1:
		var a=r.points[leg]; var b=r.points[leg+1]
		var dx=b.x-a.x; var dz=b.z-a.z; var length2=dx*dx+dz*dz
		var progress = clamp(((v.pose.position.x-a.x)*dx+(v.pose.position.z-a.z)*dz)/length2,0,1) if length2 else 1
		var separation = sqrt(pow(v.pose.position.x-a.x-progress*dx,2)+pow(v.pose.position.z-a.z-progress*dz,2))
		if separation<closest:
			closest=separation;best={"leg":leg,"progress":progress}
	if best.progress>=1-1e-10 and best.leg<r.points.size()-2: return {"leg":best.leg+1,"progress":0}
	return best
func route_for_vessel(r: Dictionary,v: Dictionary) -> Dictionary:
	_error=""
	if not _finite(r.get("minimumDepth")) or r.minimumDepth<=0 or not r.get("points") is Array or r.points.size()<2:return {"ok":false,"reason":"Unknown or invalid route depth/geometry"}
	for point in r.points:
		if not point is Dictionary or not _finite(point.get("x")) or not _finite(point.get("z")):return {"ok":false,"reason":"Unknown or invalid route depth/geometry"}
	var draft=effective_draft(v)
	if not _error.is_empty(): return {"ok":false,"reason":_error}
	return {"ok":true} if draft<r.minimumDepth else {"ok":false,"reason":"Draft %.1fm requires deeper water than %.1fm"%[draft,r.minimumDepth]}
func quote_trade(type: String, good: String, quantity) -> Dictionary:
	return _quote_trade(_state,type,good,quantity)
func _quote_trade(s: Dictionary,type: String,good: String,quantity) -> Dictionary:
	if not type in ["buy","sell"] or not _count(quantity) or quantity<=0: return {"ok":false,"reason":"invalid-quantity"}
	if good!="grain": return {"ok":false,"reason":"unsupported-good"}
	if s.currentPortId==null or not s.ports.has(s.currentPortId): return {"ok":false,"reason":"not-in-port"}
	var v=s.vessels.get(s.flagshipId,{})
	if v.is_empty(): return {"ok":false,"reason":"unknown-ship"}
	if v.voyageId!=null: return {"ok":false,"reason":"contract-cargo"}
	if v.ownerId!="captain" and not (v.ownerId=="house-lin" and v.profileId=="flagship"): return {"ok":false,"reason":"not-authorized"}
	if v.pose.speed>0.5 or v.damage.hull<=0 or v.damage.fire>0 or v.damage.flooding>0 or v.controls.sailDeployment>0: return {"ok":false,"reason":"unsafe-port"}
	var profile=Catalog.DATA.profiles.get(v.profileId,{})
	if profile.is_empty(): return {"ok":false,"reason":"unknown-profile"}
	var stock=s.ports[s.currentPortId].stock.get("grain",0);var cargo=v.cargo.get("grain",0);var occupied=_sum(v.cargo)
	for n in [stock,cargo,occupied,s.captain.silver]:
		if not _count(n): return {"ok":false,"reason":"invalid-resources"}
	if type=="buy" and quantity>stock: return {"ok":false,"reason":"insufficient-stock"}
	if type=="buy" and quantity>profile.capacity-occupied: return {"ok":false,"reason":"insufficient-capacity"}
	if type=="sell" and quantity>cargo: return {"ok":false,"reason":"insufficient-cargo"}
	if occupied>profile.capacity or not _count(stock+(quantity if type=="sell" else 0)): return {"ok":false,"reason":"numeric-overflow"}
	var total=0
	for unit in int(quantity):
		total += max(2,10+floor((100-(stock-1 if type=="buy" else stock))/20.0))+(1 if type=="buy" else -1)
		stock += -1 if type=="buy" else 1
	if not _count(total) or total<=0 or (type=="sell" and not _count(s.captain.silver+total)): return {"ok":false,"reason":"numeric-overflow"}
	if type=="buy" and total>s.captain.silver: return {"ok":false,"reason":"insufficient-silver"}
	return {"ok":true,"total":total}

func _valid_order(o) -> bool:
	if not _exact(o,["id","shipIds","intent","issuedAt"]) or not _valid_id(o.id) or not o.shipIds is Array or o.shipIds.is_empty() or o.shipIds.size()>64 or not _finite(o.issuedAt) or o.issuedAt<0 or not o.intent is Dictionary: return false
	var seen={}
	for id in o.shipIds:
		if not _valid_id(id,256) or seen.has(id): return false
		seen[id]=true
	var i=o.intent
	if i.get("kind")=="rally": return _exact(i,["kind","point"]) and _exact(i.point,["x","z"]) and _finite(i.point.x) and _finite(i.point.z)
	if i.get("kind")=="keep-distance": return _exact(i,["kind","targetId","range"]) and _valid_id(i.targetId,256) and _finite(i.range) and i.range>0 and i.range<=10000
	return i.get("kind") in ["protect","intercept","focus","prepare-boarding"] and _exact(i,["kind","targetId"]) and _valid_id(i.targetId,256)
func _valid_command(c: Dictionary) -> bool:
	if not _valid_id(c.get("commandId")) or not _count(c.get("expectedRevision")): return false
	var fields=["type","commandId","expectedRevision"]
	match c.get("type"):
		"story-choice":
			fields.append_array(["sceneId","choiceId"])
			if not c.get("sceneId") is String or not c.get("choiceId") is String or OpeningStory.choice_definition(c.sceneId,c.choiceId).is_empty():return false
		"repay-debt":
			fields.append("quantity")
			if not _count(c.get("quantity")) or c.quantity<=0:return false
		"accept-convoy":
			if c.has("contractId"):
				fields.append("contractId")
				if not c.contractId in ["convoy-001","convoy-002"]: return false
		"depart": pass
		"buy","sell":
			fields.append_array(["good","quantity"])
			if not c.get("good") in GOODS or not _count(c.get("quantity")) or c.quantity<=0:return false
		"choose-route": fields.append_array(["voyageId","routeId"])
		"assign-order":
			fields.append("order")
			if not _valid_order(c.get("order")):return false
		"dock":fields.append("portId")
		"repair","release-prisoners","incorporate-prize":fields.append("shipId")
		"treat-wounded":
			fields.append_array(["shipId","quantity"])
			if not _count(c.get("quantity")) or c.quantity<=0:return false
		"sell-prize":fields.append_array(["shipId","crewToShipId"])
		"resolve-prize":
			fields.append_array(["targetId","choice"])
			if c.get("choice")=="abandon":fields.append("toShipId")
			elif c.get("choice")!="release":return false
		"take-prize-cargo":
			fields.append_array(["targetId","toShipId","cargo"])
			if not c.get("cargo") is Dictionary:return false
			for g in c.cargo:
				if not g in GOODS or not _count(c.cargo[g]):return false
			if not _count(_sum(c.cargo)) or _sum(c.cargo)<=0:return false
		"refit":
			fields.append_array(["shipId","slot"])
			if c.get("slot")!="sails":return false
		"claim-convoy":fields.append("contractId")
		"start-boarding":fields.append_array(["targetId","fromShipId"])
		"allocate-prize":
			fields.append_array(["targetId","fromShipId","crew"])
			if not _count(c.get("crew")) or c.crew<=0:return false
		"board-action":
			fields.append_array(["encounterId","point","action"])
			if not c.get("point") in ["bow","deck","helm"] or not c.get("action") in ["advance","hold","cut-lines"]:return false
		_:return false
	if not _exact(c,fields):return false
	for key in ["shipId","targetId","fromShipId","toShipId","crewToShipId","voyageId"]:
		if c.has(key) and not _valid_id(c[key],256):return false
	for key in ["routeId","portId","contractId","encounterId"]:
		if c.has(key) and not _valid_id(c[key]):return false
	return true

func command(input: Dictionary, context: Dictionary={}) -> Dictionary:
	_error=""
	if _reconciling:return _failure("reentrant-handoff")
	if not SaveCodec.command_data(input) or not _valid_command(input):return _failure("invalid-command")
	var c=input.duplicate(true)
	for r in _state.settlements.values():
		if r.kind in BUSINESS and r.commandId==c.commandId:return {"ok":true,"receipt":r.duplicate(true)}
	if c.expectedRevision!=_state.revision:return _failure("stale-revision")
	var refs=[]
	if c.type=="assign-order":
		refs.append_array(c.order.shipIds)
		if c.order.intent.has("targetId"):refs.append(c.order.intent.targetId)
	else:
		for k in ["shipId","fromShipId","targetId","toShipId","crewToShipId"]:
			if c.has(k):refs.append(c[k])
	for id in refs:
		if not _state.vessels.has(id):return _failure("unknown-ship")
	if c.type=="choose-route" and not _state.voyages.has(c.voyageId):return _failure("unknown-voyage")
	if c.type=="dock" and not _state.ports.has(c.portId):return _failure("unknown-port")
	if c.type=="claim-convoy" and not _state.contracts.has(c.contractId):return _failure("unknown-contract")
	if _state.chronicle.size()>=4096:return _failure("event-buffer-full")
	if not _count(_state.revision+1) or not _count(_state.nextId+1):return _failure("numeric-overflow")
	var s=_state.duplicate(true)
	var native=context.get("native",{})
	if not native.is_empty():
		if not _native_valid(native):return {"ok":false,"code":"native-context-rejected","reason":_error}
		_sync(s,native.snapshot,native.get("events",[]))
	var policy=native_policy(_near_ids(s),s)
	if (c.type in NEEDS_NATIVE or c.type=="accept-convoy" and c.get("contractId")=="convoy-002") and native.is_empty():return _failure("native-context-required")
	if not _error.is_empty():return _failure(_error)
	var working=[]
	for w in s.works.values():
		if w.status=="active":working.append(w.shipId)
	if c.type=="depart" and not working.is_empty():return _failure("ship-working")
	if c.type=="assign-order":
		for id in c.order.shipIds:
			if id in working:return _failure("ship-working")
	var id="";var message="";var details=null;var anchors=[]
	match c.type:
		"story-choice":
			var definition=OpeningStory.choice_definition(c.sceneId,c.choiceId)
			if s.currentPortId!=definition.portId:return _failure("not-in-story-port")
			_docked(s,native,policy,s.flagshipId)
			if not _error.is_empty():return _failure(_error)
			if definition.routeId!=null:
				for suffix in ["grain-a","grain-b"]:
					var v=s.vessels[s.campaignId+"-"+suffix]
					if not route_for_vessel(Catalog.DATA.routes[definition.routeId],v).ok:return _failure("route-too-shallow")
			var result=OpeningStory.apply(s,c.sceneId,c.choiceId)
			if not result.ok:return _failure(result.reason)
			if definition.routeId!=null:
				for suffix in ["grain-a","grain-b"]:
					var voyage=s.voyages[s.campaignId+"-"+suffix+"-voyage"]
					voyage.merge(locate_route(s.vessels[voyage.vesselId],Catalog.DATA.routes[definition.routeId]),true)
			id=OpeningStory.receipt_id(s,c.sceneId);details=result.details;message=result.message
		"repay-debt":
			if s.currentPortId!="xiamen":return _failure("not-in-port")
			_docked(s,native,policy,s.flagshipId)
			if not _error.is_empty():return _failure(_error)
			if c.quantity>s.debt.principal:return _failure("exceeds-debt")
			if c.quantity>s.captain.silver:return _failure("insufficient-silver")
			var before=s.debt.principal; var after=before-c.quantity; var award=6 if after==0 else 0
			s.captain.silver-=c.quantity;s.debt.principal=after;s.reputations.merchantCredit=clamp(s.reputations.merchantCredit+award,-100,100)
			id=s.campaignId+":repay-debt:"+c.commandId;message="向林家商行偿还%d两本金，剩余%d两。"%[c.quantity,after]
			details={"kind":"repay-debt","portId":"xiamen","amount":c.quantity,"beforePrincipal":before,"afterPrincipal":after,"creditAward":award}
		"accept-convoy":
			var cid=c.get("contractId","convoy-001")
			var contract=s.contracts.get(cid,{})
			if contract.is_empty():return _failure("contract-unavailable")
			id=s.campaignId+"-"+cid+"-accept"
			if contract.status!="offered" or s.settlements.has(id):return _failure("already-accepted")
			if cid=="convoy-002":
				if s.currentPortId!="kinmen":return _failure("not-in-port")
				_safe_dock(s,native,policy,"kinmen")
				if s.ports.kinmen.stock.get("grain",0)<20:return _failure("insufficient-stock")
				var ships=[]
				for suffix in ["grain-a","grain-b"]:
