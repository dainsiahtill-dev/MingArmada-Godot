		able=target.crew.able;wounded=target.crew.wounded;prisoners=target.crew.prisoners;receiver_id=to.id;to.crew.able+=able;to.crew.wounded+=wounded;to.crew.prisoners+=prisoners;to.revision+=1;target.crew.able=0;target.crew.wounded=0;target.crew.prisoners=0;target.ownerId="port-prize";_transfer_people(s,target_id,to.id);s.captain.silver+=silver;p.status="sold";_crew_transition(s,id,"prize-sale",before)
