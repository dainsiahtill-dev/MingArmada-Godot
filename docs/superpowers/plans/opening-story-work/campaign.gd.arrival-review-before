		target.revision+=1;p.resolutionReceiptId=id;s.prizes[target_id]=p;_crew_transition(s,id,"prize-release" if c.choice=="release" else "prize-rescue",before)
		return {"id":id,"details":{"kind":"prize-resolution","targetId":target_id,"boardingId":p.boardingId,"choice":c.choice,"toShipId":c.toShipId if c.choice=="abandon" else null,"movedWounded":wounded,"movedPrisoners":prisoners,"restoredAble":restored}}
	if not _require(port,"unknown-prize-command") or not _require(s.currentPortId in ["xiamen","kinmen"],"prize-market-unavailable"):return {}
