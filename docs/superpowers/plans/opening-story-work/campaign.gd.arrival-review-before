	var id=s.campaignId+":work:"+str(int(s.nextId));s.captain.silver-=quote.cost;v.representation="near"
	var work={"id":id,"shipId":v.id,"portId":s.currentPortId,"startAt":s.simulationSeconds,"completeAt":s.simulationSeconds+quote.duration,"cost":quote.cost,"status":"active","kind":"treatment" if c.type=="treat-wounded" else c.type,"hull":quote.hull,"sail":quote.sail,"targetProfileId":quote.targetProfileId}
