func _speed(v: Dictionary) -> float:return 0 if v.crew.able<v.crew.minimum else 2*max(0.25,v.damage.sail/100.0)*max(0.25,v.damage.hull/100.0)
func _remaining(v: Dictionary,voyage: Dictionary) -> float:
