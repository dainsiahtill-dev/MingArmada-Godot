		if not _require(native.get("supportsPrizeRetirement")==true,"native-retirement-unavailable") or not _require(_sum(target.cargo)==0,"prize-cargo-not-empty") or not _require(c.crewToShipId!=target_id,"invalid-prize-receiver"):return {}
