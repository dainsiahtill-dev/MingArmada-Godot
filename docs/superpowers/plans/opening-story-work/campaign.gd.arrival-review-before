		var before=_buckets(s,v.id);v.crew.prisoners=0;v.revision+=1;_crew_transition(s,s.campaignId+":release-prisoners:"+c.commandId,"release-prisoners",[{"shipId":v.id,"before":before}]);return {"anchors":[v.id]}
