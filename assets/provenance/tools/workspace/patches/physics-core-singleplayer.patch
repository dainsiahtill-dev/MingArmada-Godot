+})
+
+describe('ocean descriptor contract', () => {
+  it.each([{ x: 1, y: 0 }, { x: 0, y: 1 }, { x: -3, y: 4 }])('descriptors reproduce height and normal after heading %j', (heading) => {
+    const ocean = new GerstnerOcean()
+    ocean.setHeading(heading)
+    const waves: readonly OceanWave[] = ocean.getWaves()
+    expect(waves).toHaveLength(5)
+    for (const [x, z, time] of [[0, 0, 0], [17, -9, 1.5], [-31, 40, 12]]) {
+      let height = 0
+      let slopeX = 0
+      let slopeZ = 0
+      for (const wave of waves) {
+        const k = 2 * Math.PI / wave.wavelength
+        const phase = k * (wave.direction.x * x + wave.direction.y * z) + wave.speed * time
+        height += wave.amplitude * Math.sin(phase)
+        slopeX += wave.amplitude * k * wave.direction.x * Math.cos(phase)
+        slopeZ += wave.amplitude * k * wave.direction.y * Math.cos(phase)
+      }
+      const sampled = ocean.sample(x, z, time)
+      const magnitude = Math.hypot(slopeX, 1, slopeZ)
+      expect(sampled.height).toBeCloseTo(height, 12)
+      expect(sampled.normal.x).toBeCloseTo(-slopeX / magnitude, 12)
+      expect(sampled.normal.y).toBeCloseTo(1 / magnitude, 12)
+      expect(sampled.normal.z).toBeCloseTo(-slopeZ / magnitude, 12)
+    }
+  })
+
+  it('returned descriptors cannot corrupt sampler or later heading updates', () => {
+    const ocean = new GerstnerOcean()
+    const before = ocean.sample(5, 8, 2)
+    const waves = ocean.getWaves()
+    // A GPU consumer may repack/mutate its copy; the ocean remains authoritative.
+    const writable = waves as Array<{ direction: { x: number; y: number }; amplitude: number; wavelength: number; speed: number }>
+    writable[0].amplitude = 999
+    writable[0].direction.x = 999
+    writable.splice(1)
