+      if(Math.abs(q.x)>12||Math.abs(q.z)>6||old.above<-.2||q.above>.4)return undefined
+      touched.add('deck')
+      const yaw=.1+.08*Math.sin(t),sin=Math.sin(q.roll),cos=Math.cos(q.roll)
+      return {point:{x:p.x,y:p.y-q.above,z:p.z},normal:{x:-sin*Math.cos(yaw),y:cos,z:sin*Math.sin(yaw)}}
+    },
+  }
