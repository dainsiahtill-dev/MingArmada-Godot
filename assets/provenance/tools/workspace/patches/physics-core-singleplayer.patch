+import { createHash } from 'node:crypto'
+import { expect, test } from 'vitest'
+import { NormPhysicsEngine } from '../src/index.js'
+
+const ship = { length: 14, beam: 4.2, draft: 1, height: 3.15, mass: 18000, sailArea: 110 }
+
+test('optional travel bound permits buoyancy to follow a crest above the spawn-relative draft cap', () => {
+  const defaultEngine = new NormPhysicsEngine(1.225, ship), expanded = new NormPhysicsEngine(1.225, ship)
+  let level = 0
+  for (const engine of [defaultEngine, expanded]) {
+    engine.setBaseY(-1)
+    engine.setWaveSampler(() => level)
+    engine.stepBuoyancy({ deltaSeconds: 1 / 60 })
+  }
+  expanded.setConfig({ heaveTravelLimit: 9 })
+  level = 4
+  for (let i = 0; i < 600; i++) for (const engine of [defaultEngine, expanded]) engine.stepBuoyancy({ deltaSeconds: 1 / 60 })
+  expect(defaultEngine.getVisualState().position.y).toBe(1)
+  expect(expanded.getVisualState().position.y).toBeGreaterThan(2.8)
+  expect(expanded.getVisualState().position.y).toBeLessThan(3.2)
+})
+
+test.each([-1, 0, NaN, Infinity, -Infinity, null, '9'])('invalid travel bound %s rejects the whole config update before mutation', heaveTravelLimit => {
+  const engine = new NormPhysicsEngine(1.225, ship)
+  engine.setConfig({ heaveTravelLimit: 9 })
+  const before = { ...engine.getConfig() }
+  // Deliberately malformed external input; not a type-safe client call.
+  expect(() => engine.setConfig({ waterCd: .99, heaveTravelLimit } as never)).toThrow(RangeError)
+  expect(engine.getConfig()).toEqual(before)
+})
+
+test.each([-1, 1])('explicit travel limit bounds heave in direction %s and undefined restores draft default', sign => {
+  const engine = new NormPhysicsEngine(1.225, ship)
+  let level = 0
+  engine.setWaveSampler(() => level)
+  engine.stepBuoyancy({ deltaSeconds: 1 / 60 })
+  engine.setConfig({ heaveTravelLimit: .75 })
+  level = 100 * sign
+  for (let i = 0; i < 600; i++) engine.stepBuoyancy({ deltaSeconds: 1 / 60 })
+  expect(engine.getVisualState().position.y).toBe(.75 * sign)
+  engine.setConfig({ heaveTravelLimit: undefined })
+  for (let i = 0; i < 600; i++) engine.stepBuoyancy({ deltaSeconds: 1 / 60 })
+  expect(engine.getVisualState().position.y).toBe(2 * sign)
+})
+
+test('absent heave bound retains exact pre-repair 60-second moving/turning/wave trajectory', () => {
+  const engine = new NormPhysicsEngine(1.225, ship)
+  engine.setState({ x: 13, y: -27 }, .4); engine.setBaseY(-1); engine.setSpeed(3)
+  engine.setWind({ x: -1, y: .3 }, 9); engine.setSailAngle(.8)
+  engine.setControls({ throttle: .1, rudderAngleDeg: 12 })
+  let time = 0
+  engine.setWaveSampler((x, z) => 3 * Math.sin(time * .7 + x * .03) * Math.cos(z * .02))
+  const hash = createHash('sha256')
+  for (let i = 0; i < 3600; i++) {
+    time = (i + 1) / 60; engine.step({ deltaSeconds: 1 / 60 })
+    hash.update(JSON.stringify(engine.getVisualState()))
+  }
+  // Captured before production repair; covers position, velocity, heading, pitch and heel every tick.
+  expect(hash.digest('hex')).toBe('5bea87de40610bed5eab7aa2d08c2a916449f0c7f4c600821e3ee1119316bd17')
+})
