+    expect(Math.abs(before.position.y - 2)).toBeGreaterThan(0.01)
+    expect(Math.abs(before.pitch)).toBeGreaterThan(0.001)
+    expect(Math.abs(before.heel)).toBeGreaterThan(0.001)
+    const position = { x: 10, y: 6 } // Same water height: .03 * 10 - .05 * 6 = 0.
+    const velocity = { x: 3, y: -2 }
+    engine.correctHorizontalMotion(position, velocity)
