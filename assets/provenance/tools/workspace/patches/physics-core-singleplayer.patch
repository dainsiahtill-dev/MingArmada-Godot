+++ b/test/merge-contract.test.ts
@@ -0,0 +1,105 @@
+import { expect, test } from 'vitest'
+import { NormPhysicsEngine, type CannonConfig } from '../src/index.js'
+
+test('ordinary sail angles keep their exact value while malformed and wrapped inputs are sanitized', () => {
+  const engine = new NormPhysicsEngine(1.225, { sailArea: 100 })
+  engine.setWind({ x: -1, y: 0 }, 8)
+  for (const [angle, expected] of [[.8, .8], [-.4, -.4], [NaN, 0], [Infinity, 0], [5 * Math.PI, -Math.PI]]) {
+    engine.setSailAngle(angle)
+    engine.step({ deltaSeconds: 1 / 60 })
+    expect(engine.getSailDebugInfo().sailAngleRad).toBe(expected)
+  }
+})
+
+test('continuous heading survives the pi boundary without resetting the marine trajectory', () => {
+  const engine = new NormPhysicsEngine()
+  engine.setState({ x: 0, y: 0 }, Math.PI + .2)
+  engine.step({ deltaSeconds: 1 / 60 })
+  expect(engine.getVisualState().heading).toBe(Math.PI + .2)
+})
+
+test('tiny no-go fades retain the existing radian cutoff for full sail force outside the zone', () => {
+  const sharp = new NormPhysicsEngine(1.225, { sailArea: 100 })
+  const tiny = new NormPhysicsEngine(1.225, { sailArea: 100 })
+  const windAngle = (35 + .0005) * Math.PI / 180
+  for (const engine of [sharp, tiny]) {
+    engine.setWind({ x: Math.cos(windAngle), y: Math.sin(windAngle) }, 8)
+    engine.setSailAngle(Math.PI / 4)
+  }
+  sharp.setConfig({ noGoFadeDeg: 0 })
+  tiny.setConfig({ noGoFadeDeg: .001 })
+  for (const engine of [sharp, tiny]) engine.step({ deltaSeconds: 1 / 60 })
+  expect(Math.abs(sharp.getSailDebugInfo().forwardForce)).toBeGreaterThan(1)
+  expect(tiny.getVisualState()).toEqual(sharp.getVisualState())
+})
+
+const cannon: CannonConfig = {
+  barrelLength: 0, elevationRad: 0, azimuthRad: 0, muzzleVelocity: 100,
+  reloadSeconds: .15,
+  ammo: { massKg: 8, dragCd: 0, crossSectionArea: .01, explosionRadius: 0, baseDamage: 60, damageType: 'AP' },
+}
+
+test.each(['step', 'stepBuoyancy'] as const)('%s advances reload and real projectile impacts once per accepted tick', method => {
+  const engine = new NormPhysicsEngine()
+  engine.stopHorizontalMotion()
+  const gun = engine.addCannon(cannon, { x: 0, y: 2, z: 0 })
+  engine.addTarget({ id: 'target', material: 'metal', shape: {
+    kind: 'sphere', center: { x: 10, y: 2, z: 0 }, radius: .5,
+  } })
+  const hits: string[] = []
+  engine.onImpact(event => hits.push(event.targetId!))
+  expect(engine.fireCannon(0)).toBe(true)
+  const before = engine.getVisualState()
+  for (const deltaSeconds of [0, -1, NaN, Infinity, -Infinity]) engine[method]({ deltaSeconds })
+  expect(engine.getVisualState()).toEqual(before)
+  expect(hits).toEqual([])
+  expect(gun.canFire()).toBe(false)
+  engine[method]({ deltaSeconds: 1 }) // Existing marine cap consumes 0.05 seconds.
+  expect(hits).toEqual([])
+  expect(gun.canFire()).toBe(false)
+  engine[method]({ deltaSeconds: .05 })
+  expect(hits).toEqual(['target'])
+  expect(gun.canFire()).toBe(false)
+  engine[method]({ deltaSeconds: .05 })
+  expect(gun.canFire()).toBe(true)
+  expect(hits).toEqual(['target'])
+  expect(engine.getHorizontalMotion()).toEqual({ speed: 0, yawRate: 0 })
+})
+
+test('explicit water density changes real drag while constructor density defaults stay compatible', () => {
+  const standard = new NormPhysicsEngine(), vacuum = new NormPhysicsEngine(0, { rhoWater: 0 })
+  for (const engine of [standard, vacuum]) {
+    engine.setSpeed(4)
+    engine.step({ deltaSeconds: .05 })
+  }
+  expect(standard.getHorizontalMotion().speed).toBeLessThan(4)
+  expect(vacuum.getHorizontalMotion().speed).toBe(4)
+  const explicit = new NormPhysicsEngine(9, { rhoAir: 1.1, rhoWater: 1000, sailCEHeight: 7, GMt: 2 })
+  expect([explicit.airDensity, explicit.waterDensity, explicit.sailCEHeight, explicit.rollGM]).toEqual([1.1, 1000, 7, 2])
+  const fallback = new NormPhysicsEngine(NaN, { rhoAir: NaN, rhoWater: Infinity })
+  expect([fallback.airDensity, fallback.waterDensity]).toEqual([1.225, 1025])
+})
+
+test.each(['step', 'stepBuoyancy'] as const)('%s uses wind speed independently of direction magnitude for actual cannon impacts', method => {
+  const fire = (direction: { x: number; y: number }) => {
+    const engine = new NormPhysicsEngine()
+    engine.setWind(direction, 10)
+    engine.addCannon({ ...cannon, ammo: { ...cannon.ammo, dragCd: .3, crossSectionArea: .1 } }, { x: 0, y: 2, z: 0 })
+    const impacts: { point: { x: number; y: number; z: number }; targetId: string | null }[] = []
+    engine.onImpact(event => impacts.push(event))
+    engine.addTarget({ id: 'wall', material: 'metal', shape: {
+      kind: 'aabb', min: { x: 20, y: -50, z: -50 }, max: { x: 21, y: 50, z: 50 },
+    } })
+    expect(engine.fireCannon(0)).toBe(true)
+    for (let i = 0; i < 60; i++) engine[method]({ deltaSeconds: 1 / 60 })
+    expect(impacts).toHaveLength(1)
+    expect(impacts[0].targetId).toBe('wall')
+    expect(Object.values(impacts[0].point).every(Number.isFinite)).toBe(true)
+    return impacts[0]
+  }
+  expect(fire({ x: 2, y: 0 })).toEqual(fire({ x: 1, y: 0 }))
+  expect(fire({ x: 6, y: 8 })).toEqual(fire({ x: 3, y: 4 }))
+  expect(fire({ x: 0, y: 0 })).toEqual(fire({ x: 1, y: 0 }))
+  // Match the marine near-zero fallback even above setWind's validation floor.
+  expect(fire({ x: 0, y: .00001 })).toEqual(fire({ x: 1, y: 0 }))
+})
