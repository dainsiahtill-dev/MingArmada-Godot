+// Run after package build, against the saved pre-merge source supplied as argv[2].
+// Both engines execute real code; no state injection, mocks, or golden-only result.
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+import { pathToFileURL } from 'node:url'
+import { resolve } from 'node:path'
+import ts from 'typescript'
+import { NormPhysicsEngine } from '../../dist/index.js'
+import { GerstnerOcean } from '../../dist/ocean.js'
+
+const baselinePath = resolve(process.argv[2])
+const baselineSource = await readFile(baselinePath, 'utf8')
+const baselineJs = ts.transpileModule(baselineSource, {
+  compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ES2022 },
+}).outputText.replaceAll("'./math.js'", JSON.stringify(new URL('../../dist/math.js', import.meta.url).href))
+  .replaceAll("'./ocean.js'", JSON.stringify(new URL('../../dist/ocean.js', import.meta.url).href))
+const { NormPhysicsEngine: BaselineEngine } = await import(`data:text/javascript;base64,${Buffer.from(baselineJs).toString('base64')}`)
+const originalWaves = [[1, .02, .015, .9], [1, .02, -.015, .1], [1, .05, 0, -.6], [.25, .1, .11, 2.05], [.25, .1, -.11, -.05]]
+const originalHeight = (x, z, time) => originalWaves.reduce((height, [a, kx, kz, speed]) => {
+  const k = Math.hypot(kx, kz), wavelength = 2 * Math.PI / k
+  return height + a * Math.sin(2 * Math.PI / wavelength * (kx / k * x + kz / k * z) + speed * time)
+}, 0)
+let comparedTicks = 0
+for (const scenario of ['default', 'original-waves', 'cargo-draft-anchor-shore']) {
+  for (const steps of [[1 / 60], [1 / 30], [1 / 120], [0, 1 / 120, 1 / 60, .2, 1 / 30]]) {
+    const ship = scenario === 'default' ? undefined : { length: 14, beam: 4.2, draft: 1, height: 3.15, mass: 18000, sailArea: 110 }
+    const actual = new NormPhysicsEngine(1.225, ship), baseline = new BaselineEngine(1.225, ship)
+    let time = 0
+    const ocean = new GerstnerOcean()
+    for (const engine of [actual, baseline]) {
+      engine.setState({ x: 13, y: -27 }, .4)
+      engine.setBaseY(-1)
+      engine.setSpeed(3)
+      engine.setWind({ x: -1, y: .3 }, 9)
+      engine.setSailAngle(.8)
+      engine.setControls({ throttle: .1, rudderAngleDeg: 12 })
+      engine.setWaveSampler((x, z) => scenario === 'default' ? ocean.sample(x, z, time).height : originalHeight(x, z, time))
+    }
+    for (let tick = 0; tick < 3600; tick++) {
+      const deltaSeconds = steps[tick % steps.length]
+      time += Math.min(deltaSeconds, .05)
+      for (const engine of [actual, baseline]) {
+        if (scenario === 'cargo-draft-anchor-shore') {
+          if (tick === 300) { engine.setCargoMass(6000); engine.setDraftMeters(1.3) }
+          if (tick === 600) engine.setSailDeployment(0)
+          if (tick === 700) engine.resolveHorizontalContact({ x: 1, y: 0 }, { x: 4, y: 2 })
+          if (tick === 800) engine.stopHorizontalMotion()
+          if (tick === 1200) engine.setControls({ throttle: 0, rudderAngleDeg: 30, crewSteeringForce: 7000 })
+          if (tick === 1600) { engine.setSailDeployment(.7); engine.setSailCondition(.8); engine.setSailPowerScale(1.2) }
+        }
+        const anchored = scenario === 'cargo-draft-anchor-shore' && tick >= 800 && tick < 1200
+        engine[anchored ? 'stepBuoyancy' : 'step']({ deltaSeconds })
+      }
+      const label = `${scenario}; steps=${steps}; tick=${tick}`
+      assert.deepStrictEqual(actual.getVisualState(), baseline.getVisualState(), label)
+      assert.deepStrictEqual(actual.getHorizontalMotion(), baseline.getHorizontalMotion(), label)
+      assert.deepStrictEqual(actual.getWaveSampleDebugInfo(), baseline.getWaveSampleDebugInfo(), label)
+      comparedTicks++
+    }
+  }
+}
+console.log(JSON.stringify({ baselinePath: pathToFileURL(baselinePath).href, baselineSha256: createHash('sha256').update(baselineSource).digest('hex'), scenarios: 3, stepSequences: 4, comparedTicks, result: 'exact state/motion/wave parity at every tick' }, null, 2))
