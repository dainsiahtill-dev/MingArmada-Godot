+    ocean.setHeading({ x: 0, y: 1 })
+    expect(ocean.getWaves()).toHaveLength(5)
+    expect(ocean.getWaves()[0].direction.y).toBeCloseTo(1, 12)
+  })
+})
+
+describe('collision correction', () => {
+  it('changes only planar state and preserves vertical rates and buoyancy reference', () => {
+    const engine = sailingEngine()
