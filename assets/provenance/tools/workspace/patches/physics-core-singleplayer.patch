+    expect(corrected.position).toEqual({ x: 10, y: before.position.y, z: 6 })
+    expect(corrected.velocity).toEqual({ x: 3, y: 0, z: -2 })
+    expect(corrected.heading).toBe(before.heading)
+    expect(corrected.pitch).toBe(before.pitch)
+    expect(corrected.heel).toBe(before.heel)
+    // Equal local water profiles isolate retained heave/pitch/heel rates and offset.
+    engine.stepBuoyancy({ deltaSeconds: dt })
+    reference.stepBuoyancy({ deltaSeconds: dt })
+    expect(engine.getVisualState().position.y).toBeCloseTo(reference.getVisualState().position.y, 12)
+    expect(engine.getVisualState().pitch).toBeCloseTo(reference.getVisualState().pitch, 12)
+    expect(engine.getVisualState().heel).toBeCloseTo(reference.getVisualState().heel, 12)
+  })
+})
