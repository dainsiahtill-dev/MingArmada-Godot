index 0000000000000000000000000000000000000000..93be9e0e040c4d66fdae134f2c25c27463d46f2a
--- /dev/null
+++ b/test/utils/frozen-sailor-impact.ts
@@ -0,0 +1,157 @@
+import * as THREE from 'three'
+
+const STEP=1/120,LIFETIME=7,CAP=12
+type Particle={bone:THREE.Bone;p:THREE.Vector3;previous:THREE.Vector3;v:THREE.Vector3;orientation:THREE.Quaternion;radius:number}
+type Link={a:number;b:number;min:number;max:number}
+type Hinge={a:number;b:number;c:number;sign:number}
+type Body={root:THREE.Object3D;targetId:string;eventId:string;slot:number;casualty:boolean;age:number;wet:number;contact:'air'|'deck'|'water';particles:Particle[];links:Link[];hinges:Hinge[];materials:THREE.Material[];originals:Map<THREE.Mesh,THREE.Material|THREE.Material[]>;release:(recover:boolean)=>void}
+export type ImpactSource={root:THREE.Object3D;targetId:string;eventId:string;slot:number;casualty?:boolean;velocity:THREE.Vector3;release:(recover:boolean)=>void}
+export type ImpactSurface={point:THREE.Vector3;normal:THREE.Vector3}
+export type ImpactEnvironment={water:(x:number,z:number,time:number)=>number;deck:(targetId:string,point:THREE.Vector3,previous:THREE.Vector3)=>ImpactSurface|undefined}
+
+/** Actual loaded walkable deck/hull triangles, expressed in the moving vessel frame. */
+export function loadedDeckCollider(prototype:THREE.Object3D,matrix:THREE.Matrix4){
+  const inverse=matrix.clone().invert(),normalMatrix=new THREE.Matrix3().getNormalMatrix(matrix)
+  const surfaces=['hull','deck'].map(name=>prototype.getObjectByName(name)!).filter(Boolean)
+  const bounds=new THREE.Box3().setFromObject(surfaces.find(s=>s.name==='deck')!)
+  return (point:THREE.Vector3,previous:THREE.Vector3):ImpactSurface|undefined=>{
+    const p=point.clone().applyMatrix4(inverse),before=previous.clone().applyMatrix4(inverse)
+    if(p.x<bounds.min.x||p.x>bounds.max.x||p.z<bounds.min.z||p.z>bounds.max.z||p.y>bounds.max.y+.4||before.y<bounds.min.y-.3)return
+    const hit=new THREE.Raycaster(new THREE.Vector3(p.x,Math.max(p.y,before.y)+1,p.z),new THREE.Vector3(0,-1,0)).intersectObjects(surfaces,false)[0]
+    if(!hit?.face||before.y<hit.point.y-.2||p.y>hit.point.y+.4)return
+    return {point:hit.point.clone().applyMatrix4(matrix),normal:hit.face.normal.clone().applyNormalMatrix(new THREE.Matrix3().getNormalMatrix(hit.object.matrixWorld)).applyNormalMatrix(normalMatrix).normalize()}
+  }
+}
+
+/** World-space position solver. Only accepted Native time advances its fixed substeps. */
+export class SailorImpactPhysics {
+  readonly group=new THREE.Group()
+  private bodies:Body[]=[]
+  private remainder=0
+  private spawned=0
+  private expired=0
+  private disposed=false
+  constructor(parent:THREE.Object3D){this.group.name='sailor_impacts';parent.add(this.group)}
+  get available(){return this.disposed?0:CAP-this.bodies.length}
+  occupied(targetId:string){return new Set(this.bodies.filter(b=>b.targetId===targetId).map(b=>b.slot))}
+  recovering(targetId:string){return this.bodies.filter(b=>b.targetId===targetId&&!b.casualty).length}
+  spawn(source:ImpactSource,reducedMotion=false){
+    if(!this.available)return false
+    source.root.updateWorldMatrix(true,true)
+    const skin=source.root.getObjectByName('sailor_body')
+    if(!(skin instanceof THREE.SkinnedMesh))return false
+    const centre=skin.skeleton.bones[1].getWorldPosition(new THREE.Vector3())
+    const forward=source.velocity.clone();forward.y=0
+    if(forward.lengthSq()<1e-8)return false
+    forward.normalize()
+    const casualty=source.casualty!==false,speed=casualty?source.velocity.length():.4,impulse=forward.clone().multiplyScalar(speed*(reducedMotion?.65:1))
+    impulse.y=(casualty?(speed>8?6:5.5):.7)*(reducedMotion?.7:1)
+    const spin=new THREE.Vector3().crossVectors(new THREE.Vector3(0,1,0),forward).multiplyScalar((reducedMotion?.7:2.3)*(casualty?1:.15))
+    const particles=skin.skeleton.bones.map(bone=>{
+      const p=bone.getWorldPosition(new THREE.Vector3()),v=impulse.clone().add(new THREE.Vector3().crossVectors(spin,p.clone().sub(centre)))
+      return {bone,p,previous:p.clone(),v,orientation:bone.getWorldQuaternion(new THREE.Quaternion()),radius:bone.name.includes('head')?.16:bone.name.includes('chest')?.17:.075}
+    })
+    const links:Link[]=[]
+    const link=(a:number,b:number,range=0)=>{const length=particles[a].p.distanceTo(particles[b].p);links.push({a,b,min:length*(1-range),max:length})}
+    for(let b=1;b<particles.length;b++){
+      const a=particles.findIndex(p=>p.bone===particles[b].bone.parent)
+      if(a>=0){link(a,b);const grand=particles.findIndex(p=>p.bone===particles[a].bone.parent);if(grand>=0)link(grand,b,/elbow|wrist|knee|ankle/.test(particles[b].bone.name)?.35:.04)}
+    }
+    // Shoulder/hip braces stop torso collapse and left/right limb inversion.
+    for(const names of [['arm_L','arm_R'],['thigh_L','thigh_R'],['arm_L','thigh_R'],['arm_R','thigh_L']]){
+      const [a,b]=names.map(name=>particles.findIndex(p=>p.bone.name==='sailor_'+name));if(a>=0&&b>=0)link(a,b,.02)
+    }
+    const hinges:Hinge[]=[]
+    for(const side of ['L','R'])for(const [upper,middle,end,sign] of [['thigh','knee','ankle',1],['arm','elbow','wrist',-1]] as const){
+      const [a,b,c]=[upper,middle,end].map(name=>particles.findIndex(p=>p.bone.name===`sailor_${name}_${side}`));hinges.push({a,b,c,sign})
+    }
+    this.group.attach(source.root)
+    const materials:THREE.Material[]=[],copies=new Map<THREE.Material,THREE.Material>(),originals=new Map<THREE.Mesh,THREE.Material|THREE.Material[]>()
+    source.root.traverse(o=>{if(o instanceof THREE.Mesh){originals.set(o,o.material);const own=(material:THREE.Material)=>{let copy=copies.get(material);if(!copy){copy=material.clone();copy.transparent=true;copies.set(material,copy);materials.push(copy)}return copy};o.material=Array.isArray(o.material)?o.material.map(own):own(o.material)}})
+    this.bodies.push({...source,casualty,particles,links,hinges,materials,originals,age:0,wet:0,contact:'air'})
+    this.spawned++;return true
+  }
+  update(acceptedSeconds:number,phase:number,environment:ImpactEnvironment){
+    if(this.disposed||!Number.isFinite(acceptedSeconds)||acceptedSeconds<=0)return
+    // Every body expires by 7s, so an arbitrarily large accepted batch is bounded.
+    const seconds=Math.min(acceptedSeconds,LIFETIME),total=this.remainder+seconds
+    const steps=Math.floor((total+1e-10)/STEP);this.remainder=Math.max(0,total-steps*STEP)
+    for(let step=0;step<steps;step++){
+      const time=phase-seconds+(step+1)*STEP
+      for(const body of this.bodies){
+        body.age+=STEP
+        if(body.contact==='water')body.wet+=STEP
+        else body.contact='air'
+        for(const p of body.particles){p.previous.copy(p.p);p.v.y-=9.81*STEP;p.p.addScaledVector(p.v,STEP)}
+        const surfaces=body.particles.map(p=>environment.deck(body.targetId,p.p,p.previous))
+        for(let iteration=0;iteration<12;iteration++){
+          for(const link of body.links){
+            const a=body.particles[link.a].p,b=body.particles[link.b].p,dx=b.x-a.x,dy=b.y-a.y,dz=b.z-a.z,length=Math.hypot(dx,dy,dz)
+            if(length<1e-8)continue
+            const target=THREE.MathUtils.clamp(length,link.min,link.max)
+            const correction=(length-target)/length*.5
+            a.x+=dx*correction;a.y+=dy*correction;a.z+=dz*correction
+            b.x-=dx*correction;b.y-=dy*correction;b.z-=dz*correction
+          }
+          this.hinges(body)
+          // Resolve the same loaded moving deck plane each iteration; underwater
+          // bodies cannot snap through a hull onto its deck.
+          for(let index=0;index<body.particles.length;index++){
+            const p=body.particles[index],surface=surfaces[index]
+            if(surface){const depth=(p.p.x-surface.point.x)*surface.normal.x+(p.p.y-surface.point.y)*surface.normal.y+(p.p.z-surface.point.z)*surface.normal.z-p.radius;if(depth<0){p.p.addScaledVector(surface.normal,-depth);body.contact='deck'}}
+          }
+        }
+        // Rendered bone lengths are hard constraints, not a tolerated solver
+        // residual. A tree pass restores them exactly; whole-body contact
+        // correction then preserves every length, including first water impact.
+        for(const link of body.links)if(body.particles[link.b].bone.parent===body.particles[link.a].bone){
+          const a=body.particles[link.a].p,b=body.particles[link.b].p,axis=b.clone().sub(a)
+          if(axis.lengthSq()>1e-12)b.copy(a).addScaledVector(axis.normalize(),link.max)
+        }
+        for(let index=0;index<body.particles.length;index++){
+          const p=body.particles[index],surface=surfaces[index]
+          if(surface){const depth=p.p.clone().sub(surface.point).dot(surface.normal)-p.radius;if(depth<0)for(const joint of body.particles)joint.p.addScaledVector(surface.normal,-depth)}
+          const water=environment.water(p.p.x,p.p.z,time)
+          if(p.p.y-p.radius<=water){body.contact='water';const lift=Math.max(0,water+p.radius-body.wet*.45-p.p.y);for(const joint of body.particles)joint.p.y+=lift}
+        }
+        for(const p of body.particles){
+          p.v.copy(p.p).sub(p.previous).multiplyScalar(1/STEP)
+          if(body.contact==='water')p.v.multiplyScalar(.94)
+          else if(body.contact==='deck')p.v.multiplyScalar(.985)
+        }
+      }
+      for(let i=this.bodies.length-1;i>=0;i--)if(this.bodies[i].age>=(this.bodies[i].casualty?LIFETIME:1.25)-1e-8||this.bodies[i].wet>=1.2)this.remove(i,true)
+    }
+    for(const body of this.bodies){this.pose(body);const opacity=Math.min(1,(LIFETIME-body.age)/.7,body.wet?1-body.wet/1.2:1);body.materials.forEach(m=>m.opacity=Math.max(0,opacity))}
+  }
+  private hinges(body:Body){
+    const named=(name:string)=>body.particles.find(p=>p.bone.name==='sailor_'+name)!.p
+    const forward=new THREE.Vector3().crossVectors(named('arm_L').clone().sub(named('arm_R')),named('chest').clone().sub(named('hips'))).normalize()
+    for(const hinge of body.hinges){
+      const a=body.particles[hinge.a].p,b=body.particles[hinge.b].p,c=body.particles[hinge.c].p,axis=c.clone().sub(a).normalize()
+      const pole=forward.clone().addScaledVector(axis,-forward.dot(axis)).normalize().multiplyScalar(hinge.sign)
+      const bend=b.clone().sub(a).dot(pole)
+      // Knees cannot bend backward; elbows flex oppositely in this authored rig.
+      // Torso-derived poles rotate with the body, never with the ship or camera.
+      if(bend<-.002){const correction=(-.002-bend)*2/3;b.addScaledVector(pole,correction);a.addScaledVector(pole,-correction/2);c.addScaledVector(pole,-correction/2)}
+    }
+  }
+  private pose(body:Body){
