+    engine.setCargoMass(10000)
+    expect(engine.mass).toBe(100000)
+    expect(() => Reflect.set(engine, 'mass', 1)).not.toThrow()
+    expect(Reflect.set(engine, 'mass', 1)).toBe(false)
