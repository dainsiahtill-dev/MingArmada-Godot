+++ b/src/dynamics/articulated.ts
@@ -0,0 +1,192 @@
+/** Detached numeric world-space data; renderer resources belong to the adapter. */
+export type ArticulatedVector = {x:number;y:number;z:number}
+export type ArticulatedQuaternion = {x:number;y:number;z:number;w:number}
+export type ArticulatedNodeDefinition = {
+  position:ArticulatedVector;velocity:ArticulatedVector;orientation?:ArticulatedQuaternion
+  radius:number;parentIndex:number;childAxis?:ArticulatedVector
+}
+export type ArticulatedLink = {a:number;b:number;min:number;max:number;hard?:boolean}
+export type ArticulatedHinge = {a:number;b:number;c:number;sign:number}
+export type ArticulatedFrame = {left:number;right:number;top:number;bottom:number}
+export type ArticulatedBodyDefinition = {
+  bodyId:string;nodes:ArticulatedNodeDefinition[];links:ArticulatedLink[]
+  hinges:ArticulatedHinge[];frame?:ArticulatedFrame;lifetime:number;wetLifetime?:number
+}
+export type ArticulatedContact = 'air'|'deck'|'water'
+export type ArticulatedSnapshot = {
+  bodyId:string;age:number;wet:number;contact:ArticulatedContact
+  nodes:{position:ArticulatedVector;velocity:ArticulatedVector;orientation:ArticulatedQuaternion;radius:number}[]
+}
+export type ArticulatedSurface = {point:ArticulatedVector;normal:ArticulatedVector}
+export type ArticulatedEnvironment = {
+  water:(x:number,z:number,phase:number)=>number
+  contact:(bodyId:string,position:ArticulatedVector,previous:ArticulatedVector,phase:number,previousPhase:number)=>ArticulatedSurface|undefined
+}
+
+const STEP=1/120,CAP=12
+const copy=(v:ArticulatedVector):ArticulatedVector=>({x:v.x,y:v.y,z:v.z})
+const sub=(a:ArticulatedVector,b:ArticulatedVector):ArticulatedVector=>({x:a.x-b.x,y:a.y-b.y,z:a.z-b.z})
+const dot=(a:ArticulatedVector,b:ArticulatedVector)=>a.x*b.x+a.y*b.y+a.z*b.z
+const cross=(a:ArticulatedVector,b:ArticulatedVector):ArticulatedVector=>({x:a.y*b.z-a.z*b.y,y:a.z*b.x-a.x*b.z,z:a.x*b.y-a.y*b.x})
+const length=(v:ArticulatedVector)=>Math.sqrt(v.x*v.x+v.y*v.y+v.z*v.z)
+const scale=(v:ArticulatedVector,s:number)=>{v.x*=s;v.y*=s;v.z*=s;return v}
+const addScaled=(a:ArticulatedVector,b:ArticulatedVector,s:number)=>{a.x+=b.x*s;a.y+=b.y*s;a.z+=b.z*s;return a}
+const normalize=(v:ArticulatedVector)=>scale(v,1/(length(v)||1))
+const finite=(v:ArticulatedVector)=>Number.isFinite(v.x)&&Number.isFinite(v.y)&&Number.isFinite(v.z)
+function rotation(a:ArticulatedVector,b:ArticulatedVector):ArticulatedQuaternion {
+  let w=dot(a,b)+1,v:ArticulatedVector
+  if(w<1e-6){w=0;v=Math.abs(a.x)>Math.abs(a.z)?{x:-a.y,y:a.x,z:0}:{x:0,y:-a.z,z:a.y}}
+  else v=cross(a,b)
+  const inv=1/(Math.sqrt(dot(v,v)+w*w)||1)
+  return {x:v.x*inv,y:v.y*inv,z:v.z*inv,w:w*inv}
+}
+function multiply(a:ArticulatedQuaternion,b:ArticulatedQuaternion):ArticulatedQuaternion {
+  return {x:a.x*b.w+a.w*b.x+a.y*b.z-a.z*b.y,y:a.y*b.w+a.w*b.y+a.z*b.x-a.x*b.z,z:a.z*b.w+a.w*b.z+a.x*b.y-a.y*b.x,w:a.w*b.w-a.x*b.x-a.y*b.y-a.z*b.z}
+}
+type Node=ArticulatedNodeDefinition & {previous:ArticulatedVector;orientation:ArticulatedQuaternion;child:number;axis?:ArticulatedVector;waterSupported:boolean}
+type Body=Omit<ArticulatedBodyDefinition,'nodes'> & {nodes:Node[];hardLinks:ArticulatedLink[];wetLifetime:number;age:number;wet:number;contact:ArticulatedContact}
+
+/** Original 120 Hz position solver; initial node velocities already contain the impulse. */
+export class ArticulatedPhysics {
+  private bodies:Body[]=[]
+  private remainder=0
+  private spawned=0
+  private expired=0
+  get available(){return CAP-this.bodies.length}
+  spawn(definition:ArticulatedBodyDefinition):boolean {
+    const {nodes,links,hinges,frame}=definition,n=nodes.length,index=(i:number)=>Number.isInteger(i)&&i>=0&&i<n
+    if(!this.available||this.bodies.some(b=>b.bodyId===definition.bodyId))return false
+    if(!definition.bodyId||!n||!Number.isFinite(definition.lifetime)||definition.lifetime<=0||
+      (definition.wetLifetime!==undefined&&(!Number.isFinite(definition.wetLifetime)||definition.wetLifetime<=0)))return false
+    if(nodes.some(p=>!finite(p.position)||!finite(p.velocity)||!Number.isFinite(p.radius)||p.radius<0||
+      (p.parentIndex!==-1&&(!index(p.parentIndex)||p.parentIndex===nodes.indexOf(p)))||
+      (p.orientation&&![p.orientation.x,p.orientation.y,p.orientation.z,p.orientation.w].every(Number.isFinite))||
+      (p.childAxis&&!finite(p.childAxis))))return false
+    if(links.some(l=>!index(l.a)||!index(l.b)||l.a===l.b||!Number.isFinite(l.min)||!Number.isFinite(l.max)||l.min<0||l.max<l.min)||
+      hinges.some(h=>!index(h.a)||!index(h.b)||!index(h.c)||!Number.isFinite(h.sign))||
+      (frame&&Object.values(frame).some(i=>!index(i))))return false
+    const depth=(i:number):number=>{
+      const visited=new Set<number>();let d=0
+      while(nodes[i].parentIndex>=0){if(visited.has(i))return -1;visited.add(i);i=nodes[i].parentIndex;d++}
+      return d
+    }
+    const depths=nodes.map((_,i)=>depth(i));if(depths.some(d=>d<0))return false
+    const hardLinks:ArticulatedLink[]=[]
+    for(let b=0;b<n;b++)if(nodes[b].parentIndex>=0){
+      const a=nodes[b].parentIndex,l=links.find(l=>(l.a===a&&l.b===b)||(l.a===b&&l.b===a))
+      const max=l?.max??length(sub(nodes[b].position,nodes[a].position))
+      hardLinks.push({a,b,min:max,max,hard:true})
+    }
+    hardLinks.sort((a,b)=>depths[a.b]-depths[b.b])
+    const particles:Node[]=nodes.map((p,i)=>{
+      const child=nodes.findIndex(q=>q.parentIndex===i)
+      return {...p,position:copy(p.position),velocity:copy(p.velocity),previous:copy(p.position),
+        orientation:p.orientation?{...p.orientation}:{x:0,y:0,z:0,w:1},child,waterSupported:false,
+        axis:child<0?undefined:normalize(p.childAxis?copy(p.childAxis):sub(nodes[child].position,p.position))}
+    })
+    this.bodies.push({bodyId:definition.bodyId,nodes:particles,links:links.map(l=>({...l})),hinges:hinges.map(h=>({...h})),
+      frame:frame?{...frame}:undefined,lifetime:definition.lifetime,wetLifetime:definition.wetLifetime??1.2,
+      hardLinks,age:0,wet:0,contact:'air'})
+    this.spawned++;return true
+  }
+  advance(acceptedSeconds:number,phase:number,environment:ArticulatedEnvironment):ArticulatedSnapshot[] {
+    if(!Number.isFinite(acceptedSeconds)||acceptedSeconds<=0||!Number.isFinite(phase))return []
+    if(!this.bodies.length){this.remainder=0;return []}
+    const oldRemainder=this.remainder
+    // Query the actual beginning of the accepted interval, even if all bodies
+    // expire long before a very large batch ends. Bound work by their lifetimes.
+    const duration=Math.min(acceptedSeconds,Math.max(...this.bodies.map(b=>b.lifetime-b.age))+STEP)
+    const total=oldRemainder+duration,steps=Math.floor((total+1e-10)/STEP)
+    this.remainder=Math.max(0,total-steps*STEP)
+    const start=phase-acceptedSeconds-oldRemainder,removed:ArticulatedSnapshot[]=[]
+    for(let step=0;step<steps&&this.bodies.length;step++){
+      const time=start+(step+1)*STEP
+      for(const body of this.bodies)this.integrate(body,time,time-STEP,environment)
+      for(let i=this.bodies.length-1;i>=0;i--){
+        const body=this.bodies[i]
+        if(body.age>=body.lifetime-1e-8||body.wet>=body.wetLifetime){removed.push(this.read(body));this.bodies.splice(i,1);this.expired++}
+      }
+    }
+    if(!this.bodies.length)this.remainder=0
+    return removed
+  }
+  snapshot(bodyId?:string):ArticulatedSnapshot[]{return this.bodies.filter(b=>bodyId===undefined||b.bodyId===bodyId).map(b=>this.read(b))}
+  remove(bodyId:string):ArticulatedSnapshot|undefined {
+    const index=this.bodies.findIndex(b=>b.bodyId===bodyId);if(index<0)return undefined
+    const [body]=this.bodies.splice(index,1);this.expired++
+    if(!this.bodies.length)this.remainder=0
+    return this.read(body)
+  }
+  reset():ArticulatedSnapshot[]{const removed=this.snapshot();this.expired+=this.bodies.length;this.bodies=[];this.remainder=0;return removed}
+  diagnostics(){return {active:this.bodies.length,cap:CAP,spawned:this.spawned,expired:this.expired,bodies:this.snapshot()}}
+  private read(body:Body):ArticulatedSnapshot {
+    return {bodyId:body.bodyId,age:body.age,wet:body.wet,contact:body.contact,nodes:body.nodes.map(p=>({
+      position:copy(p.position),velocity:copy(p.velocity),radius:p.radius,
+      orientation:p.child<0?{...p.orientation}:multiply(rotation(p.axis!,normalize(sub(body.nodes[p.child].position,p.position))),p.orientation),
+    }))}
+  }
+  private integrate(body:Body,time:number,previousTime:number,environment:ArticulatedEnvironment) {
+    body.age+=STEP
+    if(body.contact==='water')body.wet+=STEP
+    else body.contact='air'
+    for(const p of body.nodes){
+      p.previous=copy(p.position)
+      // Surface support is unilateral: first observe the node on/above the
+      // actual preceding-phase water surface. Nodes spawned below it sink;
+      // projecting them to the surface would manufacture a launch impulse.
+      const previousWater=environment.water(p.previous.x,p.previous.z,previousTime)
+      if(Number.isFinite(previousWater)&&p.previous.y-p.radius>=previousWater)p.waterSupported=true
+      p.velocity.y-=9.81*STEP;addScaled(p.position,p.velocity,STEP)
+    }
+    const surfaces=body.nodes.map(p=>{
+      const surface=environment.contact(body.bodyId,copy(p.position),copy(p.previous),time,previousTime)
+      if(!surface||!finite(surface.point)||!finite(surface.normal)||length(surface.normal)<1e-8)return undefined
+      return {point:copy(surface.point),normal:normalize(copy(surface.normal))}
+    })
+    for(let iteration=0;iteration<12;iteration++){
+      for(const link of body.links){
+        const a=body.nodes[link.a].position,b=body.nodes[link.b].position,dx=b.x-a.x,dy=b.y-a.y,dz=b.z-a.z,len=Math.hypot(dx,dy,dz)
+        if(len<1e-8)continue
+        const target=Math.min(link.max,Math.max(link.min,len)),correction=(len-target)/len*.5
+        a.x+=dx*correction;a.y+=dy*correction;a.z+=dz*correction
+        b.x-=dx*correction;b.y-=dy*correction;b.z-=dz*correction
+      }
+      this.hinges(body)
+      for(let index=0;index<body.nodes.length;index++){
+        const p=body.nodes[index],surface=surfaces[index]
+        if(surface){const depth=dot(sub(p.position,surface.point),surface.normal)-p.radius;if(depth<0){addScaled(p.position,surface.normal,-depth);body.contact='deck'}}
+      }
+    }
+    // Exact tree lengths, followed only by whole-body translations. Contact
+    // correction therefore cannot stretch the authored bones.
+    for(const link of body.hardLinks){
+      const a=body.nodes[link.a].position,b=body.nodes[link.b].position,axis=sub(b,a)
+      if(dot(axis,axis)>1e-12){const target=addScaled(copy(a),normalize(axis),link.max);b.x=target.x;b.y=target.y;b.z=target.z}
+    }
+    for(let index=0;index<body.nodes.length;index++){
+      const p=body.nodes[index],surface=surfaces[index]
+      if(surface){const depth=dot(sub(p.position,surface.point),surface.normal)-p.radius;if(depth<0)for(const joint of body.nodes)addScaled(joint.position,surface.normal,-depth)}
+      const water=environment.water(p.position.x,p.position.z,time)
+      if(Number.isFinite(water)&&p.position.y-p.radius<=water){
+        body.contact='water';const lift=p.waterSupported?Math.max(0,water+p.radius-body.wet*.45-p.position.y):0
+        for(const joint of body.nodes)joint.position.y+=lift
+      }
+    }
+    for(const p of body.nodes){
+      p.velocity=scale(sub(p.position,p.previous),1/STEP)
+      if(body.contact==='water')scale(p.velocity,.94)
+      else if(body.contact==='deck')scale(p.velocity,.985)
+    }
+  }
+  private hinges(body:Body) {
+    if(!body.frame)return
+    const f=body.frame,n=body.nodes
+    const forward=normalize(cross(sub(n[f.left].position,n[f.right].position),sub(n[f.top].position,n[f.bottom].position)))
+    for(const h of body.hinges){
+      const a=n[h.a].position,b=n[h.b].position,c=n[h.c].position,axis=normalize(sub(c,a))
+      const pole=scale(normalize(addScaled(copy(forward),axis,-dot(forward,axis))),h.sign)
+      const bend=dot(sub(b,a),pole)
+      if(bend<-.002){const correction=(-.002-bend)*2/3;addScaled(b,pole,correction);addScaled(a,pole,-correction/2);addScaled(c,pole,-correction/2)}
+    }
+  }
+}
