+  return {
+    water:(x,z,t)=>.09*Math.sin(.8*x+.5*z-1.1*t),
+    contact:(_id,p,previous,t,before)=>{
+      // Moving, rotating and heaving local rectangular support, queried at both phases.
+      const local=(q:typeof p,phase:number)=>{
+        const yaw=.1+.08*Math.sin(phase),dx=q.x-.25*phase,dz=q.z-.1*phase
+        const x=Math.cos(yaw)*dx-Math.sin(yaw)*dz,z=Math.sin(yaw)*dx+Math.cos(yaw)*dz
