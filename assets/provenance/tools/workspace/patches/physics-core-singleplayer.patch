diff --git a/test/sailing-contract.test.ts b/test/sailing-contract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..210db6f995e6b724c7b2c5024d31b5644d27f028
--- /dev/null
+++ b/test/sailing-contract.test.ts
@@ -0,0 +1,389 @@
+import { describe, expect, it } from 'vitest'
+import { GerstnerOcean, NormPhysicsEngine, type OceanWave } from '../src/index.js'
+
+// Existing physics-lab BoatParams: preserve massKg and summed sail-area semantics.
+const ship = {
+  length: 30, width: 6, draft: 2, height: 4.5, massKg: 120000,
+  foreSailArea: 30, mainSailArea: 80, aftSailArea: 40,
+}
+const dt = 1 / 60
+
+function sailingEngine(windSide = 1) {
+  const engine = new NormPhysicsEngine(1.225, ship)
+  engine.setState({ x: 0, y: 0 }, 0)
+  engine.setControls({ throttle: 0, rudderAngleDeg: 0 })
+  engine.setWind({ x: 0, y: windSide }, 10)
+  engine.setSailAngle(windSide * Math.PI / 4)
+  engine.setConfig({ buoyancyEnabled: false })
+  return engine
+}
+
+function run(engine: NormPhysicsEngine, seconds = 5) {
+  for (let frame = 0; frame < seconds / dt; frame++) engine.step({ deltaSeconds: dt })
+  return engine.getVisualState()
+}
+
+describe('sail deployment and damage', () => {
+  it('keeps zero-wind ships still without throttle', () => {
+    const engine = sailingEngine()
+    engine.setWind({ x: 0, y: 1 }, 0)
+    expect(run(engine).velocity).toEqual({ x: 0, y: 0, z: 0 })
+    expect(engine.getSailDebugInfo().forwardForce).toBe(0)
+  })
+
+  it.each(['deployment', 'condition'] as const)('zero %s removes every sail force and heel', (kind) => {
+    const engine = sailingEngine()
+    if (kind === 'deployment') engine.setSailDeployment(0)
+    else engine.setSailCondition(0)
+    const state = run(engine)
+    expect(state.velocity).toEqual({ x: 0, y: 0, z: 0 })
+    expect(state.position).toEqual({ x: 0, y: 0, z: 0 })
+    expect(state.heel).toBe(0)
+    expect(engine.getSailDebugInfo().forwardForce).toBe(0)
+  })
+
+  it.each(['setSailDeployment', 'setSailCondition'] as const)('%s zero lets a ship coast through the sail no-go zone', (setter) => {
+    const furled = sailingEngine()
+    const calm = sailingEngine()
+    furled[setter](0)
+    furled.setWind({ x: 1, y: 0 }, 10)
+    calm.setWind({ x: 1, y: 0 }, 0)
+    for (const engine of [furled, calm]) engine.setSpeed(5)
+    const coasting = run(furled, 1)
+    expect(coasting.velocity.x).toBeGreaterThan(1)
+    expect(coasting).toEqual(run(calm, 1))
+  })
+
+  it.each([0, 5])('half deployment halves total force and heeling, pressure scale %s', (pressureScale) => {
+    const full = sailingEngine()
+    const half = sailingEngine()
+    full.setConfig({ sailPressureScale: pressureScale })
+    half.setConfig({ sailPressureScale: pressureScale })
+    half.setSailDeployment(0.5)
+    full.step({ deltaSeconds: dt })
+    half.step({ deltaSeconds: dt })
+    const force = full.getSailDebugInfo().forwardForce
+    expect(Math.abs(force)).toBeGreaterThan(1)
+    expect(half.getSailDebugInfo().forwardForce).toBeCloseTo(force * 0.5, 10)
+    expect(Math.abs(full.getVisualState().heel)).toBeGreaterThan(0)
+    expect(half.getVisualState().heel).toBeCloseTo(full.getVisualState().heel * 0.5, 12)
+  })
+
+  it('combines deployment and condition while retaining full-sail defaults', () => {
+    const full = sailingEngine()
+    const explicit = sailingEngine()
+    const reduced = sailingEngine()
+    explicit.setSailDeployment(1)
+    explicit.setSailCondition(1)
+    reduced.setSailDeployment(0.5)
+    reduced.setSailCondition(0.4)
+    for (const engine of [full, explicit, reduced]) engine.step({ deltaSeconds: dt })
+    expect(explicit.getVisualState()).toEqual(full.getVisualState())
+    expect(reduced.getSailDebugInfo().forwardForce).toBeCloseTo(full.getSailDebugInfo().forwardForce * 0.2, 10)
+    expect(reduced.mass).toBe(120000)
+    expect(reduced.sailArea).toBe(150)
+  })
+
+  it.each([-1, 2, NaN, Infinity, -Infinity])('clamps unsafe sail scale %s to a finite force', (scale) => {
+    for (const setter of ['setSailDeployment', 'setSailCondition'] as const) {
+      const engine = sailingEngine()
+      const reference = sailingEngine()
+      engine[setter](scale)
+      reference[setter](Number.isFinite(scale) ? Math.max(0, Math.min(1, scale)) : 0)
+      engine.step({ deltaSeconds: dt })
+      reference.step({ deltaSeconds: dt })
+      expect(engine.getVisualState()).toEqual(reference.getVisualState())
+      expect(Number.isFinite(engine.getSailDebugInfo().forwardForce)).toBe(true)
+    }
+  })
+
+  it('sails forward on both mirrored beam reaches with mirrored leeway and heel', () => {
+    const starboardWind = sailingEngine(1)
+    const portWind = sailingEngine(-1)
+    const starboard = run(starboardWind, 20)
+    const port = run(portWind, 20)
+    expect(starboard.velocity.x).toBeGreaterThan(0.5)
+    expect(port.velocity.x).toBeGreaterThan(0.5)
+    expect(starboard.velocity.x).toBeCloseTo(port.velocity.x, 10)
+    expect(starboard.velocity.z).toBeLessThan(0)
+    expect(port.velocity.z).toBeGreaterThan(0)
+    expect(starboard.velocity.z).toBeCloseTo(-port.velocity.z, 10)
+    expect(starboard.heel).toBeCloseTo(-port.heel, 10)
+  })
+
+  it('rotates forward and starboard with heading instead of using fixed world axes', () => {
+    const original = sailingEngine()
+    const rotated = sailingEngine()
+    rotated.setState({ x: 0, y: 0 }, Math.PI / 2)
+    rotated.setWind({ x: -1, y: 0 }, 10)
+    const east = run(original, 20)
+    const south = run(rotated, 20)
+    expect(south.velocity.z).toBeGreaterThan(0.5)
+    expect(south.velocity.z).toBeCloseTo(east.velocity.x, 10)
+    expect(south.velocity.x).toBeCloseTo(-east.velocity.z, 10)
+    expect(south.heel).toBeCloseTo(east.heel, 10)
+  })
+
+  it.each([60, 90, 120, 180, -60, -90, -120])('auto trim at wind bearing %s sails forward at 8 m/s wind', (bearing) => {
+    const engine = sailingEngine()
+    const angle = bearing * Math.PI / 180
+    engine.setWind({ x: Math.cos(angle), y: Math.sin(angle) }, 8)
+    engine.setSailAngle(Math.sign(bearing) * Math.min(Math.PI / 2, Math.abs(angle) * 0.5))
+    engine.step({ deltaSeconds: dt })
+    expect(engine.getSailDebugInfo().forwardForce).toBeGreaterThan(0)
+    // Re-trim from apparent wind each tick, matching the naval simulation contract.
+    for (let frame = 1; frame < 30 / dt; frame++) {
+      const state = engine.getVisualState()
+      const fromAngle = Math.atan2(Math.sin(angle) * 8 + state.velocity.z, Math.cos(angle) * 8 + state.velocity.x)
+      let relative = fromAngle - state.heading
+      while (relative > Math.PI) relative -= Math.PI * 2
+      while (relative < -Math.PI) relative += Math.PI * 2
+      engine.setSailAngle(relative * 0.5)
+      engine.step({ deltaSeconds: dt })
+    }
+    const state = engine.getVisualState()
+    expect(state.velocity.x).toBeGreaterThan(0.2)
+    expect(state.position.x).toBeGreaterThan(3)
+  })
+})
+
+describe('sail power upgrades', () => {
+  it.each([0, 5])('doubles total sail force and heeling at power 2, pressure scale %s', (pressureScale) => {
+    const normal = sailingEngine()
+    const upgraded = sailingEngine()
+    for (const engine of [normal, upgraded]) engine.setConfig({ sailPressureScale: pressureScale })
+    upgraded.setSailPowerScale(2)
+    normal.step({ deltaSeconds: dt })
+    upgraded.step({ deltaSeconds: dt })
+    expect(Math.abs(normal.getSailDebugInfo().forwardForce)).toBeGreaterThan(1)
+    expect(upgraded.getSailDebugInfo().forwardForce).toBeCloseTo(normal.getSailDebugInfo().forwardForce * 2, 10)
+    expect(upgraded.getVisualState().heel).toBeCloseTo(normal.getVisualState().heel * 2, 12)
+    expect(Math.abs(upgraded.getVisualState().velocity.z)).toBeGreaterThan(Math.abs(normal.getVisualState().velocity.z))
+  })
+
+  it('default power remains one and composes with deployment and condition', () => {
+    const normal = sailingEngine()
+    const explicit = sailingEngine()
+    const combined = sailingEngine()
+    explicit.setSailPowerScale(1)
+    combined.setSailDeployment(0.5)
+    combined.setSailCondition(0.4)
+    combined.setSailPowerScale(2.5)
+    for (const engine of [normal, explicit, combined]) engine.step({ deltaSeconds: dt })
+    expect(explicit.getVisualState()).toEqual(normal.getVisualState())
+    expect(combined.getSailDebugInfo().forwardForce).toBeCloseTo(normal.getSailDebugInfo().forwardForce * 0.5, 10)
+  })
+
+  it('zero power removes sail force and permits inertial coasting through headwind', () => {
+    const zero = sailingEngine()
+    zero.setSailPowerScale(0)
+    expect(run(zero).velocity).toEqual({ x: 0, y: 0, z: 0 })
+    expect(zero.getVisualState().heel).toBe(0)
+    expect(zero.getSailDebugInfo().forwardForce).toBe(0)
+    zero.setSpeed(5)
+    zero.setWind({ x: 1, y: 0 }, 10)
+    const calm = sailingEngine()
+    calm.setWind({ x: 1, y: 0 }, 0)
+    calm.setSpeed(5)
+    const coasting = run(zero, 1)
+    expect(coasting.velocity.x).toBeGreaterThan(1)
+    expect(coasting.velocity).toEqual(run(calm, 1).velocity)
+  })
+
+  it.each([
+    { input: -1, expected: 0 }, { input: 5, expected: 4 },
+    { input: NaN, expected: 0 }, { input: Infinity, expected: 0 }, { input: -Infinity, expected: 0 },
+  ])('sanitizes power $input without changing nominal ship properties or current motion', ({ input, expected }) => {
+    const engine = sailingEngine()
+    const reference = sailingEngine()
+    for (const item of [engine, reference]) {
+      item.setState({ x: 12, y: -4 }, 0.25)
+      item.setSpeed(3)
+    }
+    const before = engine.getVisualState()
+    const area = engine.sailArea
+    const coefficient = engine.sailRunCd
+    engine.setSailPowerScale(input)
+    reference.setSailPowerScale(expected)
+    expect(engine.getVisualState()).toEqual(before)
+    expect(engine.sailArea).toBe(area)
+    expect(engine.sailRunCd).toBe(coefficient)
+    expect(engine.mass).toBe(120000)
+    engine.step({ deltaSeconds: dt })
+    reference.step({ deltaSeconds: dt })
+    expect(engine.getVisualState()).toEqual(reference.getVisualState())
+    expect(Number.isFinite(engine.getSailDebugInfo().forwardForce)).toBe(true)
+  })
+})
+
+describe('live cargo mass', () => {
+  it('reduces sail acceleration, travel and heeling through larger live mass/inertia', () => {
+    const unloaded = sailingEngine()
+    const loaded = sailingEngine()
+    loaded.setCargoMass(120000)
+    expect(loaded.mass).toBe(240000)
+    expect(loaded.sailArea).toBe(unloaded.sailArea)
+    for (const engine of [unloaded, loaded]) engine.step({ deltaSeconds: dt })
+    expect(loaded.getSailDebugInfo().forwardForce).toBe(unloaded.getSailDebugInfo().forwardForce)
+    const light = unloaded.getVisualState()
+    const heavy = loaded.getVisualState()
+    expect(light.velocity.x).toBeGreaterThan(0)
+    expect(heavy.velocity.x).toBeGreaterThan(0)
+    expect(heavy.velocity.x).toBeLessThan(light.velocity.x * 0.51)
+    expect(heavy.position.x).toBeLessThan(light.position.x * 0.51)
+    expect(Math.abs(light.heel)).toBeGreaterThan(0)
+    expect(heavy.heel).toBeCloseTo(light.heel * 0.5, 12)
+    expect(run(loaded, 5).position.x).toBeLessThan(run(unloaded, 5).position.x)
+  })
+
+  it('preserves exact pose/motion and all vertical rates while recalculating mass-dependent buoyancy', () => {
+    const loaded = sailingEngine()
+    const unloaded = sailingEngine()
+    let level = 0
+    for (const engine of [loaded, unloaded]) {
+      engine.setState({ x: 4, y: -3 }, 0.4)
+      engine.setWind({ x: 0, y: 1 }, 0)
+      engine.setSpeed(3)
+      engine.setConfig({ buoyancyEnabled: true })
+      engine.setBaseY(2)
+      engine.setWaveSampler((x, z) => level + x * 0.03 - z * 0.05)
+      engine.step({ deltaSeconds: dt })
+    }
+    level = 0.8
+    for (let frame = 0; frame < 20; frame++) {
+      loaded.step({ deltaSeconds: dt })
+      unloaded.step({ deltaSeconds: dt })
+    }
+    const before = loaded.getVisualState()
+    expect(Math.abs(before.position.y - 2)).toBeGreaterThan(0.01)
+    expect(Math.abs(before.pitch)).toBeGreaterThan(0.001)
