+import type {ArticulatedBodyDefinition} from '../../src/dynamics/articulated.js'
+
+// Exact rest topology/coordinates from tools/sailor-models/build-sailor.mjs rig().
+// Numeric extraction keeps this headless fixture independent of GLB/Three.
+export const authoredNodes = [
+  ['root',-1,0,0,0],['hips',0,0,.87,0],['spine',1,0,1.05,0],
+  ['chest',2,0,1.27,0],['neck',3,0,1.425,0],['head',4,0,1.49,0],
+  ['arm_L',3,.205,1.355,0],['elbow_L',6,.265,1.115,0],['wrist_L',7,.3,.895,.015],
+  ['thigh_L',1,.115,.86,0],['knee_L',9,.13,.455,0],['ankle_L',10,.13,.095,0],
+  ['arm_R',3,-.205,1.355,0],['elbow_R',12,-.265,1.115,0],['wrist_R',13,-.3,.895,.015],
+  ['thigh_R',1,-.115,.86,0],['knee_R',15,-.13,.455,0],['ankle_R',16,-.13,.095,0],
+] as const
+
+export function authoredBody(bodyId='body',height=8,speed=7,lifetime=7): ArticulatedBodyDefinition {
+  const nodes=authoredNodes.map(([name,parentIndex,x,y,z])=>({
+    position:{x,y:y+height,z},velocity:{x:speed+2.3*(y-.87),y:5.5-2.3*x,z:0},
+    radius:name.includes('head')?.16:name.includes('chest')?.17:.075,
+    orientation:{x:0,y:0,z:0,w:1},parentIndex,
+  }))
+  const links:ArticulatedBodyDefinition['links']=[]
+  const link=(a:number,b:number,range=0,hard=false)=>{
+    const p=nodes[a].position,q=nodes[b].position,max=Math.hypot(q.x-p.x,q.y-p.y,q.z-p.z)
+    links.push({a,b,min:max*(1-range),max,hard})
+  }
+  for(let b=1;b<nodes.length;b++){
+    const a=nodes[b].parentIndex;link(a,b,0,true)
+    const grand=nodes[a].parentIndex
+    if(grand>=0)link(grand,b,/elbow|wrist|knee|ankle/.test(authoredNodes[b][0])?.35:.04)
+  }
+  for(const [a,b] of [[6,12],[9,15],[6,15],[12,9]])link(a,b,.02)
+  return {bodyId,nodes,links,hinges:[{a:9,b:10,c:11,sign:1},{a:6,b:7,c:8,sign:-1},{a:15,b:16,c:17,sign:1},{a:12,b:13,c:14,sign:-1}],frame:{left:6,right:12,top:3,bottom:1},lifetime}
+}
