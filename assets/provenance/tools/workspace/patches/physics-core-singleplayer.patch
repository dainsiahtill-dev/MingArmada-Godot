index 0000000000000000000000000000000000000000..918cb691f87e31236ce64f55490aecb8c82c34e1
--- /dev/null
+++ b/src/manualHandling.ts
@@ -0,0 +1,47 @@
+/** Opt-in manual handling request. Rates use radians and accepted physics time. */
+export type ManualHandlingAssist = {
+  targetYawRateRad: number
+  maxYawAccelerationRad: number
+  powerFraction: number
+  neutralYawDamping: number
+  brakeDeceleration: number
+  coastInNoGo: boolean
+}
+
+const MAX_YAW_RATE = 12 * Math.PI / 180
+const MAX_YAW_ACCELERATION = 16 * Math.PI / 180
+const YAW_TRACKING_GAIN = 4
+
+const within = (value: unknown, low: number, high: number): value is number =>
+  typeof value === 'number' && Number.isFinite(value) && value >= low && value <= high
+
+/** Invalid requests clear the whole assist; accepted data is detached from callers. */
+export function sanitizeManualHandlingAssist(value: unknown): ManualHandlingAssist | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const request = value as Partial<ManualHandlingAssist>
+  if (!within(request.targetYawRateRad, -MAX_YAW_RATE, MAX_YAW_RATE) ||
+    !within(request.maxYawAccelerationRad, 0, MAX_YAW_ACCELERATION) ||
+    !within(request.powerFraction, 0, 1) ||
+    !within(request.neutralYawDamping, 0, 3) ||
+    !within(request.brakeDeceleration, 0, .2) ||
+    typeof request.coastInNoGo !== 'boolean') return undefined
+  return {
+    targetYawRateRad: request.targetYawRateRad,
+    maxYawAccelerationRad: request.maxYawAccelerationRad,
+    powerFraction: request.powerFraction,
+    neutralYawDamping: request.neutralYawDamping,
+    brakeDeceleration: request.brakeDeceleration,
+    coastInNoGo: request.coastInNoGo,
+  }
+}
+
+/** Dry hull torque budget remains fixed while cargo contributes to live inertia. */
+export function manualHandlingTorque(request: ManualHandlingAssist | undefined, yawRate: number, dryYawInertia: number): number {
+  if (!request || request.powerFraction === 0 || !Number.isFinite(yawRate) ||
+    !Number.isFinite(dryYawInertia) || dryYawInertia <= 0) return 0
+  const desiredAcceleration = (request.targetYawRateRad - yawRate) * YAW_TRACKING_GAIN -
+    request.neutralYawDamping * yawRate
+  const boundedAcceleration = Math.max(-request.maxYawAccelerationRad,
+    Math.min(request.maxYawAccelerationRad, desiredAcceleration))
+  return dryYawInertia * boundedAcceleration * request.powerFraction
+}
