new file mode 100644
index 0000000000000000000000000000000000000000..41447e03571b4696fae6c66b1b7326eef61a7473
--- /dev/null
+++ b/test/horizontal-anchor.test.ts
@@ -0,0 +1,107 @@
+import { expect, test } from 'vitest'
+import { NormPhysicsEngine } from '../src/index.js'
+import { GerstnerOcean } from '../src/ocean.js'
+
+const dt = 1 / 60
+function movingEngine() {
+  const engine = new NormPhysicsEngine(1.225, {
+    length: 32, beam: 9, width: 9, height: 3.9, draft: 2, mass: 95000, sailArea: 430,
+  })
+  engine.setState({ x: 12, y: -7 }, .3)
+  engine.setBaseY(2)
+  engine.setSpeed(3)
+  engine.setCargoMass(12000)
+  engine.setWind({ x: 0, y: 1 }, 8)
+  engine.setSailAngle(.6)
+  engine.setSailDeployment(.7)
+  engine.setSailCondition(.8)
+  engine.setSailPowerScale(1.4)
+  engine.setControls({ throttle: .2, rudderAngleDeg: 30, crewSteeringForce: 7400 })
+  return engine
+}
+function expectMotionApi(engine: NormPhysicsEngine) {
+  expect(engine.getHorizontalMotion, 'actual horizontal speed and yaw rate must be public').toBeTypeOf('function')
+  expect(engine.stopHorizontalMotion, 'anchor must stop both actual linear and angular motion').toBeTypeOf('function')
+}
+
+test('stop removes real steering momentum without altering pose, buoyancy rates or continuing waves', () => {
+  const engine = movingEngine(), reference = movingEngine(), ocean = new GerstnerOcean()
+  let time = 0
+  for (const body of [engine, reference]) body.setWaveSampler((x, z) => ocean.sample(x, z, time).height)
+  for (let frame = 0; frame < 120; frame++) {
+    time += dt
+    engine.step({ deltaSeconds: dt }); reference.step({ deltaSeconds: dt })
+  }
+  expectMotionApi(engine)
+  const before = engine.getVisualState(), motion = engine.getHorizontalMotion()
+  expect(motion.speed).toBeGreaterThan(0)
+  expect(Math.abs(motion.yawRate)).toBeGreaterThan(.00001)
+  expect(Math.abs(before.position.y - 2)).toBeGreaterThan(.001)
+  expect(Math.abs(before.heel)).toBeGreaterThan(.001)
+  expect(Math.abs(before.pitch)).toBeGreaterThan(.001)
+  const config = { ...engine.getConfig() }, sail = engine.getSailDebugInfo(), wave = engine.getWaveSampleDebugInfo()
+  engine.stopHorizontalMotion()
+  expect(engine.getHorizontalMotion()).toEqual({ speed: 0, yawRate: 0 })
+  expect(engine.resolveHorizontalContact({ x: 0, y: 0 }, { x: 0, y: 0 })).toBe(0)
+  expect(engine.getVisualState()).toEqual({ ...before, velocity: { x: 0, y: 0, z: 0 } })
+  expect(engine.mass).toBe(107000)
+  expect(engine.getConfig()).toEqual(config)
+  expect(engine.getSailDebugInfo()).toEqual(sail)
+  expect(engine.getWaveSampleDebugInfo()).toEqual(wave)
+  // Matching subsequent floating trajectories also protects hidden vertical rates/offset.
+  for (let frame = 0; frame < 90; frame++) {
+    time += dt
+    engine.stepBuoyancy({ deltaSeconds: dt }); reference.stepBuoyancy({ deltaSeconds: dt })
+    const actual = engine.getVisualState(), expected = reference.getVisualState()
+    expect(actual.position).toEqual(expected.position)
+    expect(actual.heading).toBe(before.heading)
+    expect(actual.heel).toBe(expected.heel)
+    expect(actual.pitch).toBe(expected.pitch)
+    expect(engine.getHorizontalMotion()).toEqual({ speed: 0, yawRate: 0 })
+  }
+  expect(Math.abs(engine.getVisualState().position.y - before.position.y)).toBeGreaterThan(.001)
+  engine.stopHorizontalMotion()
+  expect(engine.getHorizontalMotion()).toEqual({ speed: 0, yawRate: 0 })
+  // Stopping momentum does not erase drive, wind, sails, steering or their live configuration.
+  engine.step({ deltaSeconds: dt })
+  expect(engine.getHorizontalMotion().speed).toBeGreaterThan(0)
+  expect(Math.abs(engine.getHorizontalMotion().yawRate)).toBeGreaterThan(0)
+  expect(Math.abs(engine.getSailDebugInfo().forwardForce)).toBeGreaterThan(1)
+})
+
+test('horizontal motion getter returns detached actual values and leaves normal sailing trajectory untouched', () => {
+  const engine = movingEngine(), reference = movingEngine()
+  expectMotionApi(engine)
+  for (let frame = 0; frame < 120; frame++) {
+    engine.step({ deltaSeconds: dt }); reference.step({ deltaSeconds: dt })
+    const before = engine.getVisualState(), motion = engine.getHorizontalMotion()
+    expect(motion.speed).toBe(Math.hypot(before.velocity.x, before.velocity.z))
+    // A zero contact normal is inert and exposes the existing actual yaw rate directly.
+    expect(motion.yawRate).toBe(engine.resolveHorizontalContact({ x: 0, y: 0 }, { x: 0, y: 0 }))
+    const next = engine.getHorizontalMotion()
+    expect(next).not.toBe(motion)
+    motion.speed = 999; motion.yawRate = 999
+    expect(engine.getHorizontalMotion()).toEqual(next)
+    expect(engine.getVisualState()).toEqual(before)
+    expect(engine.getVisualState()).toEqual(reference.getVisualState())
+  }
+  expect(Math.abs(engine.getHorizontalMotion().yawRate)).toBeGreaterThan(.00001)
+})
+
+test('existing horizontal collision correction retains yaw momentum and reports corrected actual speed', () => {
+  const engine = movingEngine()
+  for (let frame = 0; frame < 60; frame++) engine.step({ deltaSeconds: dt })
+  expectMotionApi(engine)
+  const before = engine.getVisualState(), yaw = engine.getHorizontalMotion().yawRate
+  expect(Math.abs(yaw)).toBeGreaterThan(.00001)
+  engine.correctHorizontalMotion({ x: 14, y: -10 }, { x: -3, y: 4 }, .7)
+  expect(engine.getHorizontalMotion()).toEqual({ speed: 5, yawRate: yaw })
+  const corrected = engine.getVisualState()
+  expect(corrected.position).toEqual({ x: 14, y: before.position.y, z: -10 })
+  expect(corrected.heading).toBe(.7)
+  expect(corrected.heel).toBe(before.heel)
+  expect(corrected.pitch).toBe(before.pitch)
+  engine.stopHorizontalMotion()
+  expect(engine.getHorizontalMotion()).toEqual({ speed: 0, yawRate: 0 })
+  expect(engine.getVisualState()).toEqual({ ...corrected, velocity: { x: 0, y: 0, z: 0 } })
+})
