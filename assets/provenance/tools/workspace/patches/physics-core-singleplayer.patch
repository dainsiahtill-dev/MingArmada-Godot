+import { expect, test } from 'vitest'
+import * as physics from '../src/index.js'
+import type { OceanWave } from '../src/ocean.js'
+
+const descriptors = (): OceanWave[] => [[.02,.015,.9,1],[.02,-.015,.1,1],[.05,0,-.6,1],[.1,.11,2.05,.25],[.1,-.11,-.05,.25]].map(([kx,kz,speed,amplitude]) => {
+  const k = Math.hypot(kx,kz)
+  return { direction: { x:kx/k,y:kz/k }, wavelength:2*Math.PI/k, speed, amplitude }
+})
+
+// Retained pre-extraction evaluator, including its operation order.
+const savedImplementation = (waves: readonly OceanWave[], x: number, z: number, time: number) => {
+  let height = 0, dx = 0, dz = 0
+  for (const wave of waves) {
+    const k = 2 * Math.PI / wave.wavelength
+    const phase = k * (wave.direction.x * x + wave.direction.y * z) + wave.speed * time
+    height += wave.amplitude * Math.sin(phase)
+    const derivative = wave.amplitude * k * Math.cos(phase)
+    dx += derivative * wave.direction.x; dz += derivative * wave.direction.y
+  }
+  const length = Math.hypot(dx, 1, dz)
+  return { height, normal: { x: -dx / length, y: 1 / length, z: -dz / length } }
+}
+
+test('physics-core publicly exports DescribedOcean', () => {
+  expect(physics.DescribedOcean).toBeTypeOf('function')
+  expect(new physics.DescribedOcean([]).heaveExcursion).toBe(0)
+})
+
+test('physics-core publicly exports the articulated solver', () => {
+  expect(physics.ArticulatedPhysics).toBeTypeOf('function')
+})
+
+test('samples match the saved described-wave implementation exactly', () => {
+  const waves = descriptors()
+  const ocean = new physics.DescribedOcean(waves)
+  for (const [x, z, time] of [[0,0,0],[894.671,337.14,0],[23,-15,12.5],[-333,639,150],[1287,-750,1000]]) {
+    expect(ocean.sample(x, z, time)).toEqual(savedImplementation(waves, x, z, time))
+  }
+  expect(ocean.heaveExcursion).toBe(7)
+})
+
+test('validates wave limits and numeric fields while keeping detached descriptors', () => {
+  const wave = descriptors()[0]
+  for (const invalid of [
+    Array(9).fill(wave),
+    [{ ...wave, wavelength: 0 }],
+    [{ ...wave, wavelength: -1 }],
+    [{ ...wave, wavelength: Number.MIN_VALUE }],
+    [{ ...wave, speed: Infinity }],
+    [{ ...wave, amplitude: NaN }],
+    [{ ...wave, direction: { x: NaN, y: 0 } }],
+    Array.from({ length: 2 }, () => ({ ...wave, amplitude: Number.MAX_VALUE })),
+  ]) {
+    expect(() => new physics.DescribedOcean(invalid)).toThrow()
+  }
+
+  const input = descriptors()
+  const ocean = new physics.DescribedOcean(input)
+  const before = ocean.sample(23, -15, 12.5)
+  input[0].amplitude = 99
+  input[1].direction.x = 99
+  const output = ocean.getWaves()
+  output[0].direction.y = 99
+  expect(ocean.sample(23, -15, 12.5)).toEqual(before)
+  expect(ocean.getWaves()).toEqual(descriptors())
+})
+
+test('empty wave set samples a flat surface', () => {
+  expect(new physics.DescribedOcean([]).sample(1, 2, 3)).toEqual({
+    height: 0,
+    normal: { x: -0, y: 1, z: -0 },
+  })
+})
