index 0000000000000000000000000000000000000000..83b2c46aa6c56a0297645075cae54d9f63db3aaf
--- /dev/null
+++ b/src/DescribedOcean.ts
@@ -0,0 +1,32 @@
+import type { Ocean, OceanSample, OceanWave } from './ocean.js'
+
+/** Fixed renderer-authored waves. Wind changes do not rotate these world-space descriptors. */
+export class DescribedOcean implements Ocean {
+  private readonly waves: readonly OceanWave[]
+  /** Maximum crest-to-trough displacement, independent of spawn phase. */
+  readonly heaveExcursion: number
+  constructor(waves: readonly OceanWave[]) {
+    if (!Array.isArray(waves) || waves.length > 8) throw new RangeError('At most eight ocean waves are supported')
+    for (const wave of waves) {
+      if (!wave?.direction || ![wave.direction.x, wave.direction.y, wave.amplitude, wave.speed, wave.wavelength].every(Number.isFinite) || wave.wavelength <= 0 || !Number.isFinite(2 * Math.PI / wave.wavelength)) {
+        throw new TypeError('Ocean waves need finite values and a positive wavelength')
+      }
+    }
+    this.heaveExcursion = 2 * waves.reduce((sum, wave) => sum + Math.abs(wave.amplitude), 0)
+    if (!Number.isFinite(this.heaveExcursion)) throw new RangeError('Ocean wave travel envelope must be finite')
+    this.waves = waves.map(wave => ({ ...wave, direction: { ...wave.direction } }))
+  }
+  getWaves(): OceanWave[] { return this.waves.map(wave => ({ ...wave, direction: { ...wave.direction } })) }
+  sample(x: number, z: number, time: number): OceanSample {
+    let height = 0, dx = 0, dz = 0
+    for (const wave of this.waves) {
+      const k = 2 * Math.PI / wave.wavelength
+      const phase = k * (wave.direction.x * x + wave.direction.y * z) + wave.speed * time
+      height += wave.amplitude * Math.sin(phase)
+      const derivative = wave.amplitude * k * Math.cos(phase)
+      dx += derivative * wave.direction.x; dz += derivative * wave.direction.y
+    }
+    const length = Math.hypot(dx, 1, dz)
+    return { height, normal: { x: -dx / length, y: 1 / length, z: -dz / length } }
+  }
+}
