+import { DescribedOcean } from '../../naval-core/src/DescribedOcean.js'
+
+const params = { length: 36, beam: 10, height: 4.3, mass: 150000, sailArea: 450 }
+function engine(draft: number) {
+  const value = new NormPhysicsEngine(1.225, { ...params, draft })
+  value.setState({ x: 12, y: 15 }, .1)
+  value.setSpeed(8)
+  value.setSailDeployment(0)
+  value.setWaveSampler(() => 0)
+  return value
+}
+function change(value: NormPhysicsEngine, draft: number) {
+  expect(value.setDraftMeters, 'public setter keeps cached hydrodynamics and buoyancy consistent').toBeTypeOf('function')
+  value.setDraftMeters(draft)
+}
+function advance(value: NormPhysicsEngine, ticks: number) {
+  for (let i = 0; i < ticks; i++) value.step({ deltaSeconds: 1 / 60 })
+}
+test('updated draft has constructor-equivalent real drag without resetting movement', () => {
+  const changed = engine(2.8), expected = engine(1.6)
+  changed.setConfig({ buoyancyEnabled: false }); expected.setConfig({ buoyancyEnabled: false })
+  const before = changed.getVisualState()
+  change(changed, 1.6)
+  expect(changed.getVisualState()).toEqual(before)
+  expect(changed.waterFrontalArea).toBeCloseTo(12.8)
+  advance(changed, 120); advance(expected, 120)
+  expect(changed.getVisualState()).toEqual(expected.getVisualState())
+})
+test('draft change preserves current floating state and converges without moving flat-water equilibrium', () => {
+  const value = engine(2.8)
+  value.setSpeed(0); advance(value, 30)
+  const before = value.getVisualState()
+  change(value, 1.2)
+  expect(value.getVisualState()).toEqual(before)
+  advance(value, 600)
+  const visual = value.getVisualState()
+  expect(Object.values(visual.position).every(Number.isFinite)).toBe(true)
+  expect(visual.position.y).toBeCloseTo(0, 8)
+  expect(visual.pitch).toBeCloseTo(0, 8); expect(visual.heel).toBeCloseTo(0, 8)
+})
+test.each([0, -1, NaN, Infinity, Number.MAX_VALUE, 1e-320, 1e-100, .001])('invalid draft %s leaves state and subsequent dynamics intact', draft => {
+  const value = engine(2.8), expected = engine(2.8)
+  expect(value.setDraftMeters).toBeTypeOf('function')
