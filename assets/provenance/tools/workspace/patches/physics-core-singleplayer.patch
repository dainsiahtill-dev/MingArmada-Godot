+  })
+
+  it('replaces cargo rather than accumulating and restores exact dry mass at zero', () => {
+    const restored = sailingEngine()
+    const dry = sailingEngine()
+    restored.setCargoMass(30000)
+    expect(restored.mass).toBe(150000)
+    restored.setCargoMass(10000)
+    expect(restored.mass).toBe(130000)
+    restored.setCargoMass(0)
