+import {expect,test} from 'vitest'
+import {NormPhysicsEngine} from '../src/index.js'
+
+function engine(force=7400,mass=95000,speed=0,rudder=30) {
+  const body=new NormPhysicsEngine(1.225,{length:32,width:9,beam:9,draft:2,height:3.9,massOverride:mass,sailArea:430})
+  body.setState({x:0,y:0},0);body.setSpeed(speed);body.setWind({x:1,y:0},0);body.setSailDeployment(0)
+  body.setControls({throttle:0,rudderAngleDeg:rudder,crewSteeringForce:force})
+  return body
+}
+function run(body:NormPhysicsEngine,seconds=5){for(let i=0;i<seconds*60;i++)body.step({deltaSeconds:1/60});return body.getVisualState()}
+
+test('opt-in crew steering from rest integrates bounded stern force and yaw without teleport',()=>{
+  const body=engine(),before=body.getVisualState()
+  body.step({deltaSeconds:1/60});const first=body.getVisualState()
+  expect(first.heading).toBeGreaterThan(before.heading);expect(first.heading).toBeLessThan(.012/3600+.000001)
+  expect(Math.hypot(first.position.x,first.position.z)).toBeLessThan(.00003)
+  const state=run(body)
+  expect(state.heading).toBeGreaterThan(.025);expect(state.heading).toBeLessThan(.035*5.1)
+})
+
+test('zero crew zero rudder and legacy default have no auxiliary motion or spin',()=>{
+  const legacy=engine()
+  legacy.setControls({throttle:0,rudderAngleDeg:30})
+  for(const body of[legacy,engine(0),engine(7400,95000,0,0),engine(Infinity),engine(-7400)]){
+    const state=run(body)
+    expect(state.heading).toBe(0);expect(state.velocity).toEqual({x:0,y:0,z:0});expect(state.position.x).toBe(0);expect(state.position.z).toBe(0)
+  }
+})
+
+test('normal water speed disables helper exactly while low-speed crew and inertia determine response',()=>{
+  const assisted=engine(7400,95000,3),normal=engine(0,95000,3)
+  for(let i=0;i<60;i++) {
+    assisted.step({deltaSeconds:1/60});normal.step({deltaSeconds:1/60})
+    expect(assisted.getVisualState()).toEqual(normal.getVisualState())
+  }
+  const full=run(engine()),low=run(engine(2000)),heavy=run(engine(7400,190000))
+  expect(full.heading).toBeGreaterThan(low.heading);expect(full.heading).toBeGreaterThan(heavy.heading)
+})
+
+test('crew helper does not change sail no-go force or generate direct forward thrust',()=>{
+  const assisted=engine(),normal=engine(0)
+  for(const body of[assisted,normal]){body.setWind({x:1,y:0},9);body.setSailDeployment(1);body.setSailAngle(0)}
+  assisted.step({deltaSeconds:1/60});normal.step({deltaSeconds:1/60})
+  expect(assisted.getSailDebugInfo()).toEqual(normal.getSailDebugInfo())
+  expect(assisted.getSailDebugInfo().forwardForce).toBe(0)
+  expect(assisted.getVisualState().velocity.x).toBe(0)
+})
+
+test('a bow contact impulse constrains contact-point velocity and leaves stern steering free to pivot',()=>{
+  const body=engine()
+  run(body,1)
+  const before=body.getVisualState(),offset={x:16,y:-4.5},normal={x:0,y:1}
+  const yaw=body.resolveHorizontalContact(normal,offset)
+  const after=body.getVisualState()
+  expect(after.position).toEqual(before.position)
+  expect(after.pitch).toBe(before.pitch);expect(after.heel).toBe(before.heel)
+  expect(after.velocity.z+offset.x*yaw).toBeCloseTo(0,10)
+  expect(yaw).toBeGreaterThan(0)
+  expect(after.velocity.z).toBeLessThan(0)
+})
diff --git a/test/manual-handling.test.ts b/test/manual-handling.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..80236816ea851d2576f85abb365b7fb2f69b8746
--- /dev/null
+++ b/test/manual-handling.test.ts
@@ -0,0 +1,277 @@
+import { describe, expect, it } from 'vitest'
+import { NormPhysicsEngine, type ManualHandlingAssist as Assist } from '../src/index.js'
+const dt = 1 / 60
+const radians = (degrees: number) => degrees * Math.PI / 180
+const ship = { length: 32, width: 9, beam: 9, draft: 2, height: 3.9, massOverride: 95000, sailArea: 430 }
+const assist = (partial: Partial<Assist> = {}): Assist => ({
+  targetYawRateRad: radians(8), maxYawAccelerationRad: radians(11),
+  powerFraction: 1, neutralYawDamping: 0, brakeDeceleration: 0, coastInNoGo: false,
+  ...partial,
+})
+
+function body(cargo = 0, params = ship) {
+  const engine = new NormPhysicsEngine(1.225, params)
+  engine.setState({ x: 0, y: 0 }, 0)
+  engine.setWind({ x: 1, y: 0 }, 0)
+  engine.setSailDeployment(0)
+  engine.setConfig({ buoyancyEnabled: false })
+  engine.setCargoMass(cargo)
+  return engine
+}
+
+function controls(engine: NormPhysicsEngine, manualAssist?: Assist, rudderAngleDeg = 0) {
+  engine.setControls({ throttle: 0, rudderAngleDeg, manualAssist })
+}
+
+function run(engine: NormPhysicsEngine, seconds: number) {
+  for (let frame = 0; frame < seconds * 60; frame++) engine.step({ deltaSeconds: dt })
+  return engine.getVisualState()
+}
+
+describe('optional manual force integration', () => {
+  it('preserves the captured original sailing trajectory without a request', () => {
+    const engine = body()
+    engine.setWind({ x: 0, y: 1 }, 8)
+    engine.setSailDeployment(1)
+    engine.setSailAngle(Math.PI / 4)
+    controls(engine, undefined, 15)
+    const result = run(engine, 4)
+    // Captured before adding assistance; exact equality detects default-path drift.
+    expect(result).toEqual({
+      heading: .007133665685521487, heel: -.03500724070736211, pitch: 0,
+      position: { x: 3.41046206508643, y: 0, z: -3.3777166197911366 },
+      velocity: { x: 1.45708832331003, y: 0, z: -1.3009671272929952 },
+    })
+    expect(engine.getHorizontalMotion()).toEqual({ speed: 1.953361678804881, yawRate: .00535287391061237 })
+  })
+
+  it.each([-1, 1])('tracks a bounded yaw intent %s from rest without positional or velocity overrides', direction => {
+    const engine = body()
+    controls(engine, assist({ targetYawRateRad: direction * radians(8) }))
+    engine.step({ deltaSeconds: dt })
+    const first = engine.getVisualState()
+    expect(direction * first.heading).toBeGreaterThan(0)
+    expect(Math.abs(engine.getHorizontalMotion().yawRate)).toBeLessThanOrEqual(radians(11) * dt)
+    expect(first.position).toEqual({ x: 0, y: 0, z: 0 })
+    expect(first.velocity).toEqual({ x: 0, y: 0, z: 0 })
+    run(engine, 3)
+    expect(direction * engine.getVisualState().heading).toBeGreaterThan(radians(10))
+    expect(Math.abs(engine.getHorizontalMotion().yawRate)).toBeLessThan(radians(8))
+  })
+
+  it('neutral and reverse requests decelerate accumulated yaw smoothly through the torque budget', () => {
+    const neutral = body(), reverse = body(), legacy = body()
+    for (const engine of [neutral, reverse, legacy]) {
+      controls(engine, assist())
+      run(engine, 2)
+    }
+    const before = neutral.getVisualState()
+    const yawBefore = neutral.getHorizontalMotion().yawRate
+    expect(yawBefore).toBeGreaterThan(radians(1))
+    controls(neutral, assist({ targetYawRateRad: 0, neutralYawDamping: 3 }))
+    controls(reverse, assist({ targetYawRateRad: -radians(8), neutralYawDamping: 1 }))
+    controls(legacy)
+    expect(neutral.getVisualState()).toEqual(before)
+    neutral.step({ deltaSeconds: dt })
+    expect(neutral.getHorizontalMotion().yawRate).toBeGreaterThan(0)
+    expect(neutral.getHorizontalMotion().yawRate).toBeLessThan(yawBefore)
+    const released = run(neutral, 5)
+    expect(released.heading - before.heading).toBeLessThan(radians(4))
+    expect(run(legacy, 5).heading - before.heading).toBeGreaterThan(radians(10))
+    run(reverse, 2)
+    expect(reverse.getHorizontalMotion().yawRate).toBeLessThan(-radians(1))
+  })
+
+  it('live cargo and reduced crew power each reduce the acceleration delivered by a fixed hull budget', () => {
+    const light = body(), heavy = body(95000), weak = body(), zero = body()
+    controls(light, assist())
+    controls(heavy, assist())
+    controls(weak, assist({ powerFraction: .25 }))
+    controls(zero, assist({ powerFraction: 0 }))
+    for (const engine of [light, heavy, weak, zero]) engine.step({ deltaSeconds: dt })
+    const yaw = light.getHorizontalMotion().yawRate
+    expect(yaw).toBeGreaterThan(0)
+    expect(heavy.getHorizontalMotion().yawRate).toBeCloseTo(yaw * .5, 12)
+    expect(weak.getHorizontalMotion().yawRate).toBeCloseTo(yaw * .25, 12)
+    expect(zero.getHorizontalMotion().yawRate).toBe(0)
+  })
+
+  it.each([ship, { ...ship, length: 52, width: 14, beam: 14, massOverride: 480000 }])('uses each hull inertia with a finite requested angular acceleration', params => {
+    const engine = body(0, params)
+    controls(engine, assist({ targetYawRateRad: radians(12), maxYawAccelerationRad: radians(16) }))
+    engine.step({ deltaSeconds: dt })
+    expect(engine.getHorizontalMotion().yawRate).toBeCloseTo(radians(16) * dt, 12)
+  })
+
+  it('contact impulses remain authoritative and the next assist tick adds only bounded torque', () => {
+    const engine = body()
+    controls(engine, assist())
+    run(engine, 2)
+    const before = engine.getVisualState()
+    const yawBefore = engine.getHorizontalMotion().yawRate
+    const offset = { x: 16, y: -4.5 }, normal = { x: 0, y: 1 }
+    const contactYaw = engine.resolveHorizontalContact(normal, offset)
+    const contacted = engine.getVisualState()
+    expect(contacted.position).toEqual(before.position)
+    expect(contacted.velocity.z + offset.x * contactYaw).toBeCloseTo(0, 12)
+    expect(contactYaw).toBeGreaterThan(0)
+    expect(contactYaw).toBeLessThan(yawBefore)
+    engine.step({ deltaSeconds: dt })
+    expect(Math.abs(engine.getHorizontalMotion().yawRate - contactYaw)).toBeLessThanOrEqual(radians(11) * dt)
+    expect(engine.getVisualState().velocity.z).toBeLessThan(0)
+  })
+})
+
+describe('no-go coasting and finite braking', () => {
+  it('opt-in headwind coasting retains momentum while the original active-sail rule stops forward travel', () => {
+    const assisted = body(), old = body(), calm = body()
+    for (const engine of [assisted, old, calm]) {
+      engine.setSpeed(5)
+      engine.setSailDeployment(1)
+      engine.setWind({ x: 1, y: 0 }, engine === calm ? 0 : 9)
+    }
+    controls(assisted, assist({ targetYawRateRad: 0, coastInNoGo: true }))
+    controls(old)
+    controls(calm)
+    const coasting = run(assisted, 1)
+    expect(coasting.velocity.x).toBeGreaterThan(1)
+    expect(coasting).toEqual(run(calm, 1))
+    expect(assisted.getSailDebugInfo().forwardForce).toBe(0)
+    expect(run(old, 1).velocity.x).toBe(0)
+  })
+
+  it.each([0, 1])('coasting policy with power %s adds no persistent headwind propulsion', powerFraction => {
+    const moving = body(), stopped = body()
+    for (const engine of [moving, stopped]) {
+      engine.setWind({ x: 1, y: 0 }, 9)
+      engine.setSailDeployment(1)
+      controls(engine, assist({ targetYawRateRad: 0, powerFraction, coastInNoGo: true }))
+    }
+    moving.setSpeed(2)
+    run(moving, 20)
+    expect(moving.getHorizontalMotion().speed).toBeGreaterThan(0)
+    expect(moving.getHorizontalMotion().speed).toBeLessThan(2)
+    expect(moving.getSailDebugInfo().forwardForce).toBe(0)
+    expect(run(stopped, 20).velocity).toEqual({ x: 0, y: 0, z: 0 })
+  })
+
+  it.each([1, -1])('braking opposes existing velocity %s and stops without reversing', direction => {
+    const braking = body(), free = body()
+    for (const engine of [braking, free]) {
+      engine.setSpeed(direction * .03)
+      engine.setConfig({ waterCd: 0, keelAreaFactor: 0 })
+    }
+    controls(braking, assist({ targetYawRateRad: 0, brakeDeceleration: .2 }))
+    controls(free)
+    braking.step({ deltaSeconds: dt })
+    free.step({ deltaSeconds: dt })
+    const signed = direction * braking.getVisualState().velocity.x
+    expect(signed).toBeGreaterThan(0)
+    expect(signed).toBeLessThan(direction * free.getVisualState().velocity.x)
+    expect(free.getHorizontalMotion().speed - braking.getHorizontalMotion().speed).toBeCloseTo(.2 * dt, 12)
+    expect(run(braking, 1).velocity).toEqual({ x: 0, y: 0, z: 0 })
+    expect(run(braking, 5).velocity).toEqual({ x: 0, y: 0, z: 0 })
+  })
+
+  it('braking respects cargo and power, including exact zero-force legacy dynamics', () => {
+    const full = body(), heavy = body(95000), weak = body(), zero = body(), old = body()
+    for (const engine of [full, heavy, weak, zero, old]) {
+      engine.setSpeed(4)
+      engine.setConfig({ keelAreaFactor: 0 })
+    }
+    controls(full, assist({ targetYawRateRad: 0, brakeDeceleration: .2 }))
+    controls(heavy, assist({ targetYawRateRad: 0, brakeDeceleration: .2 }))
+    controls(weak, assist({ targetYawRateRad: 0, powerFraction: .25, brakeDeceleration: .2 }))
+    controls(zero, assist({ targetYawRateRad: 0, powerFraction: 0, brakeDeceleration: .2 }))
+    controls(old)
+    for (const engine of [full, heavy, weak, zero, old]) engine.step({ deltaSeconds: dt })
+    expect(full.getHorizontalMotion().speed).toBeLessThan(weak.getHorizontalMotion().speed)
+    expect(zero.getVisualState()).toEqual(old.getVisualState())
+    const heavyFree = body(95000)
+    heavyFree.setSpeed(4)
+    heavyFree.setConfig({ keelAreaFactor: 0 })
+    controls(heavyFree)
+    heavyFree.step({ deltaSeconds: dt })
+    expect(heavyFree.getHorizontalMotion().speed - heavy.getHorizontalMotion().speed).toBeCloseTo(.1 * dt, 12)
+  })
+})
+
+describe('request boundary and accepted physics time', () => {
+  it.each([
+    { targetYawRateRad: NaN }, { targetYawRateRad: Infinity }, { targetYawRateRad: radians(12) + .001 },
+    { targetYawRateRad: -radians(12) - .001 }, { maxYawAccelerationRad: -1 },
+    { maxYawAccelerationRad: radians(16) + .001 }, { maxYawAccelerationRad: Infinity },
+    { powerFraction: -.01 }, { powerFraction: 1.01 }, { powerFraction: NaN },
+    { neutralYawDamping: -1 }, { neutralYawDamping: 3.01 }, { neutralYawDamping: Infinity },
+    { brakeDeceleration: -.01 }, { brakeDeceleration: .201 }, { brakeDeceleration: NaN },
+    { coastInNoGo: 1 },
+  ])('invalid request %j clears the entire previous assist before the next tick', malformed => {
+    const engine = body(), reference = body()
+    for (const item of [engine, reference]) {
+      controls(item, assist())
+      run(item, 1)
+    }
+    expect(engine.getVisualState().heading).toBeGreaterThan(0)
+    controls(engine, { ...assist(), ...malformed } as Assist)
+    controls(reference)
+    expect(run(engine, 1)).toEqual(run(reference, 1))
+    expect(Object.values(engine.getVisualState().velocity).every(Number.isFinite)).toBe(true)
+  })
+
+  it('copies accepted numeric controls and clears them when the optional request is omitted', () => {
+    const engine = body(), reference = body()
+    const request = assist()
+    controls(engine, request)
+    controls(reference, assist())
+    request.targetYawRateRad = NaN
+    request.powerFraction = 0
+    expect(run(engine, 1)).toEqual(run(reference, 1))
+    expect(engine.getVisualState().heading).toBeGreaterThan(0)
+    controls(engine)
+    controls(reference)
+    expect(run(engine, 1)).toEqual(run(reference, 1))
+  })
+
+  it('30/60/120 caller batches produce the same fixed 60 Hz force trajectory', () => {
+    const sample = (batchHz: number) => {
+      const engine = body()
+      let pending = 0
+      for (let batch = 0; batch < batchHz * 4; batch++) {
+        pending += 1 / batchHz
+        controls(engine, assist())
+        while (pending + 1e-10 >= dt) {
+          engine.step({ deltaSeconds: dt })
+          pending -= dt
+        }
+      }
+      return engine.getVisualState()
+    }
+    expect(sample(30)).toEqual(sample(60))
+    expect(sample(120)).toEqual(sample(60))
+    expect(sample(60).heading).toBeGreaterThan(radians(10))
+  })
+
+  it('large dt retains the original .05 second cap and invalid ticks add no force or travel', () => {
+    const engine = body(), reference = body()
+    for (const item of [engine, reference]) {
+      item.setSpeed(2)
+      controls(item, assist({ brakeDeceleration: .2 }))
+    }
+    const before = engine.getVisualState()
+    for (const deltaSeconds of [0, -1, NaN, Infinity, -Infinity]) engine.step({ deltaSeconds })
+    expect(engine.getVisualState()).toEqual(before)
+    engine.step({ deltaSeconds: 20 })
+    reference.step({ deltaSeconds: .05 })
+    expect(engine.getVisualState()).toEqual(reference.getVisualState())
+    expect(engine.getHorizontalMotion().yawRate).toBeGreaterThan(0)
+    expect(engine.getHorizontalMotion().yawRate).toBeLessThanOrEqual(radians(11) * .05)
+  })
+
+  it('wave-only anchored ticks do not consume assisted steering or braking', () => {
+    const engine = body()
+    engine.setSpeed(2)
+    controls(engine, assist({ brakeDeceleration: .2 }))
+    engine.stepBuoyancy({ deltaSeconds: dt })
+    expect(engine.getHorizontalMotion()).toEqual({ speed: 2, yawRate: 0 })
+  })
+})
