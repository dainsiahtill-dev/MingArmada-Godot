+import type { PhysicsControlInput } from './protocol.js'
+
+export type ShouldSendControl = (lastSent: PhysicsControlInput | null) => boolean
+
+export class ControlSender {
+  private lastSentControl: PhysicsControlInput | null = null
+  private lastSentAtMs = 0
+
+  constructor(private readonly intervalMs = 100) {}
+
+  shouldSend(nowMs: number, shouldSendDelta: ShouldSendControl) {
+    const forceSend = nowMs - this.lastSentAtMs >= this.intervalMs
+    return forceSend || shouldSendDelta(this.lastSentControl)
+  }
+
+  commit(nowMs: number, input: PhysicsControlInput) {
+    this.lastSentAtMs = nowMs
+    this.lastSentControl = { ...input }
+  }
+}
