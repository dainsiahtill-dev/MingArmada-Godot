+import { describe, expect, it } from 'vitest'
+import { ControlSender } from '../src/controlSend.js'
+
+describe('ControlSender', () => {
+  it('uses detached last control and forces heartbeat at interval boundary', () => {
+    const sender = new ControlSender(100)
+    const input = { throttle: 0.5, rudderAngleDeg: 3, driveEnabled: true, sailAngleRad: 0.2 }
+    expect(sender.shouldSend(0, (last) => last === null)).toBe(true)
+    sender.commit(0, input)
+    input.throttle = 1
+    expect(sender.shouldSend(99, (last) => last?.throttle !== 0.5)).toBe(false)
+    expect(sender.shouldSend(100, () => false)).toBe(true)
+    expect(sender.shouldSend(1, (last) => last?.rudderAngleDeg !== 4)).toBe(true)
+  })
+})
diff --git a/tests/physicsClient.test.ts b/tests/physicsClient.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..70b43dd227176ec913e822705906ec1bb93bc99c
--- /dev/null
+++ b/tests/physicsClient.test.ts
@@ -0,0 +1,290 @@
+import { Client, Room } from 'colyseus.js'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { PhysicsClient, type PhysicsClientOptions } from '../src/physicsClient.js'
+import type { SnapshotMessage } from '../src/protocol.js'
+
+// Keep Colyseus subscriptions real; replace only external join/send/close transport.
+class TransportRoom extends Room {
+  readonly sent: { type: string | number; payload: unknown }[] = []
+  leaveCalls = 0
+
+  constructor(id: string) {
+    super('sailing')
+    this.roomId = id
+  }
+
+  override send<T>(type: string | number, payload?: T) {
+    this.sent.push({ type, payload })
+  }
+
+  override async leave() {
+    this.leaveCalls += 1
+    return 1000
+  }
+
+  message(type: string, payload: unknown) {
+    this.onMessageHandlers.emit(type, payload)
+  }
+}
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((done) => { resolve = done })
+  return { promise, resolve }
+}
+
+const snapshot: SnapshotMessage = {
+  type: 'snapshot', selfId: 'captain', role: 'player', time: 10,
+  windDirection: { x: 1, y: 0 }, windSpeed: 5,
+  players: [{
+    id: 'captain', name: 'Captain', rudderAngleDeg: 0, sailAngleRad: 0,
+    ship: { length: 10, width: 3 },
+    state: { position: { x: 0, y: 0, z: 0 }, velocity: { x: 2, y: 0, z: 0 }, heading: 0, heel: 0, pitch: 0 },
+  }],
+}
+
+describe('PhysicsClient transport lifecycle', () => {
+  const clients: PhysicsClient[] = []
+  let nowMs = 100
+
+  function client(options: PhysicsClientOptions = {}) {
+    const value = new PhysicsClient('ws://localhost:2567', {
+      reconnectDelayMs: 1000, reconnectJitterMs: 0, ...options,
+    })
+    clients.push(value)
+    return value
+  }
+
+  async function join(value: PhysicsClient, room: TransportRoom, name = 'Captain') {
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(room)
+    value.connect()
+    value.sendHello('captain', undefined, name)
+    await vi.waitFor(() => expect(value.getConnectionInfo().roomId).toBe(room.roomId))
+  }
+
+  beforeEach(() => {
+    nowMs = 100
+    vi.useFakeTimers()
+    vi.spyOn(performance, 'now').mockImplementation(() => nowMs)
+    vi.spyOn(console, 'log').mockImplementation(() => {})
+    vi.spyOn(console, 'warn').mockImplementation(() => {})
+    vi.stubGlobal('fetch', vi.fn().mockImplementation(async () => new Response(JSON.stringify({ roomId: 'world' }))))
+    vi.spyOn(Client.prototype, 'joinById').mockRejectedValue(new Error('unplanned transport join'))
+    vi.spyOn(Client.prototype, 'getAvailableRooms').mockResolvedValue([])
+  })
+
+  afterEach(() => {
+    clients.forEach((value) => value.disconnect())
+    clients.length = 0
+    vi.restoreAllMocks()
+    vi.unstubAllGlobals()
+    vi.useRealTimers()
+  })
+
+  it('leaves an in-flight join completed after disconnect without reconnecting', async () => {
+    const pending = deferred<Room>()
+    const room = new TransportRoom('late')
+    const joinTransport = vi.spyOn(Client.prototype, 'joinById').mockReturnValue(pending.promise)
+    const value = client()
+    value.connect()
+    value.sendHello('captain')
+    await vi.waitFor(() => expect(joinTransport).toHaveBeenCalledTimes(1))
+    value.disconnect()
+    pending.resolve(room)
+    await vi.waitFor(() => expect(room.leaveCalls).toBe(1))
+    expect(value.isConnected()).toBe(false)
+    expect(value.getConnectionInfo().roomId).toBeNull()
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('ignores messages, errors, and close from a previous room after identity change', async () => {
+    const value = client()
+    const old = new TransportRoom('old')
+    await join(value, old)
+    const next = new TransportRoom('next')
+    await join(value, next, 'New Captain')
+    old.message('snapshot', snapshot)
+    expect(value.getLatestState()).toBeNull()
+    old.onError.invoke(1006, 'late error')
+    old.onLeave.invoke(1006)
+    expect(value.getLatestState()).toBeNull()
+    expect(value.isConnected()).toBe(true)
+    expect(value.getConnectionInfo().roomId).toBe('next')
+    expect(vi.getTimerCount()).toBe(1)
+  })
+
+  it('detects stale silence when connection starts at monotonic clock zero', async () => {
+    nowMs = 0
+    const value = client({ staleTimeoutMs: 100, staleCheckIntervalMs: 100 })
+    const room = new TransportRoom('silent')
+    await join(value, room)
+    nowMs = 100
+    await vi.advanceTimersByTimeAsync(100)
+    expect(value.isConnected()).toBe(false)
+    expect(room.leaveCalls).toBe(1)
+  })
+
+  it('rejoins immediately after stale disconnect instead of waiting base backoff', async () => {
+    const value = client({ staleTimeoutMs: 100, staleCheckIntervalMs: 100 })
+    await join(value, new TransportRoom('silent'))
+    const next = new TransportRoom('rejoined')
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(next)
+    nowMs += 100
+    await vi.advanceTimersByTimeAsync(101)
+    expect(value.getConnectionInfo().roomId).toBe('rejoined')
+  })
+
+  it('settles audit requests on disconnect and preserves control packet sequence', async () => {
+    const value = client()
+    const room = new TransportRoom('active')
+    await join(value, room)
+    const input = { throttle: 0.5, rudderAngleDeg: 3, driveEnabled: true, sailAngleRad: 0.2 }
+    value.sendControl(input)
+    value.sendControl(input)
+    expect(room.sent.slice(0, 2)).toEqual([
+      { type: 'control', payload: { ...input, seq: 1, clientTime: Date.now() } },
+      { type: 'control', payload: { ...input, seq: 2, clientTime: Date.now() } },
+    ])
+    const pending = value.requestAudit()
+    value.disconnect()
+    expect(await pending).toEqual([])
+    room.message('snapshot', snapshot)
+    value.sendControl(input)
+    expect(room.sent).toHaveLength(3)
+    expect(value.getLatestState()).toBeNull()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('keeps extrapolation finite for repeated and invalid snapshot times', async () => {
+    const value = client()
+    const room = new TransportRoom('active')
+    await join(value, room)
+    room.message('snapshot', snapshot)
+    room.message('snapshot', { ...snapshot, time: 10 })
+    room.message('snapshot', { ...snapshot, time: Number.NaN })
+    nowMs += 10000
+    const state = value.getRenderState()?.players[0].state
+    expect(state?.position.x).toBeCloseTo(0.6)
+    expect(state?.heading).toBe(0)
+  })
+
+  it('closes errored transport before reconnect and ignores its late messages', async () => {
+    const value = client()
+    const room = new TransportRoom('failed')
+    await join(value, room)
+    room.onError.invoke(1006, 'transport error')
+    room.message('snapshot', snapshot)
+    expect(room.leaveCalls).toBe(1)
+    expect(value.isConnected()).toBe(false)
+    expect(value.getLatestState()).toBeNull()
+  })
+
+  it('starts stale monitoring when sendHello is used as join entry point', async () => {
+    const value = client({ staleTimeoutMs: 100, staleCheckIntervalMs: 100 })
+    const room = new TransportRoom('hello-only')
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(room)
+    value.sendHello('captain')
+    await vi.waitFor(() => expect(value.isConnected()).toBe(true))
+    nowMs += 100
+    await vi.advanceTimersByTimeAsync(100)
+    expect(room.leaveCalls).toBe(1)
+  })
+
+  it('bounds outstanding audits when audit timeout is disabled', async () => {
+    const value = client({ auditTimeoutMs: 0 })
+    const room = new TransportRoom('active')
+    await join(value, room)
+    let settled = 0
+    const requests = Array.from({ length: 1000 }, () => value.requestAudit().then(() => { settled += 1 }))
+    await Promise.resolve()
+    expect(settled).toBeGreaterThan(0)
+    expect(room.sent.length).toBeLessThan(1000)
+    value.disconnect()
+    await Promise.all(requests)
+    expect(settled).toBe(1000)
+  })
+
+  it('falls back to bounded sample history for invalid configured capacity', async () => {
+    const value = client({ maxHistory: Number.NaN, interpolationDelayMs: 33000 })
+    const room = new TransportRoom('history')
+    await join(value, room)
+    for (let time = 1; time <= 40; time += 1) {
+      room.message('snapshot', {
+        ...snapshot, selfId: 'other', time,
+        players: [{ ...snapshot.players[0], state: { ...snapshot.players[0].state, position: { x: time, y: 0, z: 0 } } }],
+      })
+    }
+    expect(value.getRenderState()?.players[0].state.position.x).toBe(9)
+  })
+
+  it('cancels discovery before starting transport join after disconnect', async () => {
+    const discovery = deferred<Response>()
+    vi.stubGlobal('fetch', vi.fn().mockReturnValue(discovery.promise))
+    const joinTransport = vi.spyOn(Client.prototype, 'joinById')
+    const value = client()
+    value.sendHello('captain')
+    value.disconnect()
+    discovery.resolve(new Response(JSON.stringify({ roomId: 'world' })))
+    await vi.waitFor(() => expect(vi.getTimerCount()).toBe(0))
+    expect(joinTransport).not.toHaveBeenCalled()
+    expect(value.isConnected()).toBe(false)
+  })
+
+  it('discards an old identity join and connects queued identity only', async () => {
+    const pending = deferred<Room>()
+    const old = new TransportRoom('old-join')
+    const next = new TransportRoom('new-join')
+    const joinTransport = vi.spyOn(Client.prototype, 'joinById')
+      .mockReturnValueOnce(pending.promise).mockResolvedValueOnce(next)
+    const value = client()
+    const statuses: boolean[] = []
+    value.onStatusChange((connected) => statuses.push(connected))
+    value.sendHello('captain', undefined, 'Old Captain')
+    await vi.waitFor(() => expect(joinTransport).toHaveBeenCalledTimes(1))
+    value.sendHello('captain', undefined, 'New Captain')
+    pending.resolve(old)
+    await vi.waitFor(() => expect(value.getConnectionInfo().roomId).toBe('new-join'))
+    expect(old.leaveCalls).toBe(1)
+    expect(statuses).toEqual([true])
+    value.sendControl({ throttle: 1, rudderAngleDeg: 0, driveEnabled: true, sailAngleRad: 0 })
+    expect(old.sent).toHaveLength(0)
+    expect(next.sent).toHaveLength(1)
+  })
+
+  it('renders raw snapshots without prediction and unsubscribes status callbacks', async () => {
+    const value = client({ renderMode: 'raw' })
+    const statuses: boolean[] = []
+    const unsubscribe = value.onStatusChange((connected) => statuses.push(connected))
+    const room = new TransportRoom('raw')
+    await join(value, room)
+    room.message('snapshot', snapshot)
+    nowMs += 500
+    expect(value.getRenderState()?.players[0].state.position.x).toBe(0)
+    expect(value.getRenderState()?.time).toBe(10)
+    expect(value.getConnectionInfo().lastMessageAtMs).toBe(100)
+    unsubscribe()
+    value.disconnect()
+    expect(statuses).toEqual([true])
+  })
+
+  it('reconnects after current room close with one status change per transition', async () => {
+    const value = client()
+    const statuses: boolean[] = []
+    value.onStatusChange((connected) => statuses.push(connected))
+    const room = new TransportRoom('closed')
+    await join(value, room)
+    room.onLeave.invoke(1006)
+    expect(value.isConnected()).toBe(false)
+    const next = new TransportRoom('reconnected')
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(next)
+    nowMs += 1000
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(value.getConnectionInfo().roomId).toBe('reconnected')
+    expect(statuses).toEqual([true, false, true])
+    value.disconnect()
+    expect(statuses).toEqual([true, false, true, false])
+    await vi.advanceTimersByTimeAsync(0)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+})
