@@ -0,0 +1,154 @@
+import { Client, Room } from 'colyseus.js'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { PhysicsClient } from '../src/physicsClient.js'
+import { PhysicsClient as CompiledPhysicsClient } from '../dist/index.js'
+
+// Real Room.leave and subscriptions; only external connection I/O is replaced.
+class ConnectionRoom extends Room {
+  closeRequests = 0
+  readonly sentBytes: (ArrayBuffer | number[])[] = []
+
+  constructor(id: string) {
+    super('sailing')
+    this.roomId = id
+    const transport: Room['connection']['transport'] = {
+      isOpen: true,
+      send: (data) => { this.sentBytes.push(data) },
+      connect: () => {},
+      // Deliberately no peer onLeave: closing must not wait for remote response.
+      close: () => { this.closeRequests += 1; transport.isOpen = false },
+    }
+    this.connection = {
+      transport, events: {},
+      get isOpen() { return transport.isOpen },
+      send: (data) => transport.send(data),
+      connect: (url, options) => transport.connect(url, options),
+      close: (code, reason) => transport.close(code, reason),
+    }
+  }
+
+  snapshot() {
+    this.onMessageHandlers.emit('snapshot', {
+      type: 'snapshot', time: 1, selfId: 'captain', role: 'player',
+      windDirection: { x: 1, y: 0 }, windSpeed: 1, players: [],
+    })
+  }
+}
+
+describe.each([
+  ['source', PhysicsClient], ['compiled', CompiledPhysicsClient],
+])('PhysicsClient real Room retirement (%s)', (_name, ClientType) => {
+  const clients: PhysicsClient[] = []
+  let nowMs = 100
+
+  function client() {
+    const value = new ClientType('ws://localhost:2567', {
+      staleTimeoutMs: 100, staleCheckIntervalMs: 100,
+      reconnectDelayMs: 1000, reconnectJitterMs: 0,
+    })
+    clients.push(value)
+    return value
+  }
+
+  async function join(value: PhysicsClient, room: ConnectionRoom, name = 'Captain') {
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(room)
+    value.sendHello('captain', undefined, name)
+    await vi.waitFor(() => expect(value.getConnectionInfo().roomId).toBe(room.roomId))
+  }
+
+  beforeEach(() => {
+    nowMs = 100
+    vi.useFakeTimers()
+    vi.spyOn(performance, 'now').mockImplementation(() => nowMs)
+    vi.spyOn(console, 'log').mockImplementation(() => {})
+    vi.spyOn(console, 'warn').mockImplementation(() => {})
+    vi.stubGlobal('fetch', vi.fn().mockImplementation(async () => new Response(JSON.stringify({ roomId: 'world' }))))
+    vi.spyOn(Client.prototype, 'joinById').mockRejectedValue(new Error('unplanned join'))
+    vi.spyOn(Client.prototype, 'getAvailableRooms').mockResolvedValue([])
+  })
+
+  afterEach(async () => {
+    clients.forEach((value) => value.disconnect())
+    clients.length = 0
+    await vi.advanceTimersByTimeAsync(1000)
+    vi.restoreAllMocks()
+    vi.unstubAllGlobals()
+    vi.useRealTimers()
+  })
+
+  it('force closes errored transport and isolates late packets', async () => {
+    const value = client()
+    const room = new ConnectionRoom('error')
+    await join(value, room)
+    room.onError.invoke(1006, 'error')
+    expect(room.closeRequests).toBe(1)
+    expect(room.sentBytes).toHaveLength(0)
+    room.snapshot()
+    room.onLeave.invoke(1006)
+    expect(value.getLatestState()).toBeNull()
+    expect(value.isConnected()).toBe(false)
+  })
+
+  it('closes stale transport before immediate replacement without peer close', async () => {
+    const value = client()
+    const room = new ConnectionRoom('stale')
+    await join(value, room)
+    const next = new ConnectionRoom('replacement')
+    vi.spyOn(Client.prototype, 'joinById').mockResolvedValueOnce(next)
+    nowMs += 100
+    await vi.advanceTimersByTimeAsync(101)
+    expect(room.closeRequests).toBe(1)
+    expect(value.getConnectionInfo().roomId).toBe('replacement')
+    room.snapshot()
+    expect(value.getLatestState()).toBeNull()
+  })
+
+  it('replaces hello identity without waiting for retired peer close', async () => {
+    const value = client()
+    const room = new ConnectionRoom('old')
+    await join(value, room)
+    await join(value, new ConnectionRoom('next'), 'New Captain')
+    expect(room.closeRequests).toBe(1)
+    expect(value.getConnectionInfo().roomId).toBe('next')
+  })
+
+  it('force closes a canceled late join without awaiting peer close', async () => {
+    let resolve!: (room: Room) => void
+    const pending = new Promise<Room>((done) => { resolve = done })
+    const joining = vi.spyOn(Client.prototype, 'joinById').mockReturnValueOnce(pending)
+    const value = client()
+    value.sendHello('captain')
+    await vi.waitFor(() => expect(joining).toHaveBeenCalledTimes(1))
+    value.disconnect()
+    const room = new ConnectionRoom('canceled')
+    resolve(room)
+    await vi.waitFor(() => expect(room.closeRequests).toBe(1))
+    expect(value.isConnected()).toBe(false)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('preserves consented disconnect then force closes unresponsive peer within grace', async () => {
+    const value = client()
+    const room = new ConnectionRoom('normal')
+    await join(value, room)
+    value.disconnect()
+    expect(room.sentBytes).toHaveLength(1)
+    expect(room.closeRequests).toBe(0)
+    expect(value.isConnected()).toBe(false)
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(room.closeRequests).toBe(1)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+
+  it('finishes consented disconnect without forced close when peer closes', async () => {
+    const value = client()
+    const room = new ConnectionRoom('normal')
+    await join(value, room)
+    value.disconnect()
+    room.onLeave.invoke(1000)
+    await vi.advanceTimersByTimeAsync(1000)
+    expect(room.sentBytes).toHaveLength(1)
+    expect(room.closeRequests).toBe(0)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+})
