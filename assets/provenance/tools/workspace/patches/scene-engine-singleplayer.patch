+            max[axis] = volume?.max?.[axis] ?? (axis === 'y' ? Infinity : NaN);
+            if ((axis !== 'y' && (!Number.isFinite(min[axis]) || !Number.isFinite(max[axis]))) ||
+                Number.isNaN(min[axis]) || Number.isNaN(max[axis]) || min[axis] > max[axis]) {
+                throw new TypeError(`Invalid vegetation exclusion ${axis} bounds`);
+            }
+        }
+        return Object.freeze({ min: Object.freeze(min), max: Object.freeze(max) });
+    }));
+}
+
+// Swept extent covers every existing build-time yaw and tilt without moving RNG draws.
+// Derived from actual geometry vertices; no geometry/material allocations per candidate.
+export function vegetationIntersects(instance, type, volumes, worldOffset = 0) {
+    if (!volumes.length) return false;
+    if (!type.exclusionExtent) {
+        const positions = type.geometry.attributes.position;
+        let radius = 0, minY = Infinity, maxY = -Infinity;
+        for (let i = 0; i < positions.count; i++) {
+            radius = Math.max(radius, Math.hypot(positions.getX(i), positions.getZ(i)));
+            minY = Math.min(minY, positions.getY(i));
+            maxY = Math.max(maxY, positions.getY(i));
+        }
+        const tilt = type.id === 'grass' ? .125 + .175 : .125 + .1;
+        const vertical = Math.max(Math.abs(minY), Math.abs(maxY));
+        const expansion = radius * Math.sin(tilt) + vertical * (1 - Math.cos(tilt));
+        type.exclusionExtent = { radius: radius + vertical * Math.sin(tilt), minY: minY - expansion, maxY: maxY + expansion };
+    }
+    const extent = type.exclusionExtent;
+    const x = instance.x - worldOffset * CONFIG.chunkSize;
+    const z = instance.z - worldOffset * CONFIG.chunkSize;
+    const radius = extent.radius * instance.scale;
+    const minY = instance.y + extent.minY * instance.scale;
+    const maxY = instance.y + extent.maxY * instance.scale;
+    return volumes.some(volume => x + radius >= volume.min.x && x - radius <= volume.max.x &&
+        z + radius >= volume.min.z && z - radius <= volume.max.z &&
+        maxY >= volume.min.y && minY <= volume.max.y);
+}
