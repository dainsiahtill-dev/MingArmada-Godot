+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { CONFIG } from '../src/config/constants.js';
+import { World } from '../src/engine/world/World.js';
+import { InputController } from '../src/engine/controls/InputController.js';
+import { Boat } from '../src/engine/vehicles/Boat.js';
+import { IslandVegetationManager } from '../src/engine/world/IslandVegetationManager.js';
+import { IslandMesh } from '../src/engine/world/IslandMesh.js';
+import { registerHeightSampler, getHeightmapState } from '../src/engine/terrain/terrainHeight.js';
+
+globalThis.window = new EventTarget();
+const sample = { height: 4, normalized: .2, isUnderwater: false };
+const corridor = [{ min: { x: -1, z: -1 }, max: { x: 1, z: 1 } }];
+function manager(options = {}) {
+    return new IslandVegetationManager({ random: () => 0, ...options });
+}
+function matrices(m) {
+    return m.buildMeshes().flatMap(mesh => {
+        const rows = [];
+        for (let i = 0; i < mesh.count; i++) {
+            const matrix = new THREE.Matrix4();
+            mesh.getMatrixAt(i, matrix);
+            rows.push({ type: mesh.userData.typeId, matrix: matrix.toArray() });
+        }
+        return rows;
+    });
+}
+
+test('World keyboard switch clears real controller keys and survives flight mode changes', () => {
+    const listeners = new Set();
+    globalThis.window = {
+        addEventListener: (name, fn) => listeners.add(fn),
+        removeEventListener: (name, fn) => listeners.delete(fn)
+    };
+    const world = new World({});
+    world.inputController = new InputController();
+    world.setFlightMode(true);
+    assert.equal(listeners.size, 2);
+    world.inputController._onKeyDown({ code: 'KeyW', preventDefault() {} });
+    assert.equal(world.inputController.getState().moveForward, true);
+    assert.equal(world.getKeyboardInputEnabled(), true);
+    world.setKeyboardInputEnabled(false);
+    assert.equal(listeners.size, 0);
+    assert.equal(world.inputController.getState().moveForward, false);
+    world.setFlightMode(true);
+    assert.equal(world.getKeyboardInputEnabled(), false);
+    assert.equal(listeners.size, 0);
+    let dispatches = 0;
+    world.cycleWaterMode = () => dispatches++;
+    world.handleKeydown({ code: 'KeyG', preventDefault() {} });
+    assert.equal(dispatches, 0);
+    world.setKeyboardInputEnabled(true);
+    assert.equal(listeners.size, 2);
+    world.setMode('play');
+    assert.equal(listeners.size, 0);
+    world.dispose();
+});
+
+test('outside-centre canopy candidate is excluded before public instances/meshes', () => {
+    const m = manager({ vegetationExclusions: corridor });
+    m.tryAddInstance(2, 0, sample);
+    assert.equal(m.getInstances().length, 0);
+    assert.equal(m.buildMeshes().length, 0);
+});
+
+test('exclusion keeps later candidate attributes, matrices, RNG and cap identical to legacy', () => {
+    function rng() { let i = 0; return () => (++i % 5) * .001; }
+    const legacy = manager({ random: rng(), maxInstances: 2 });
+    const cleared = manager({ random: rng(), maxInstances: 2, vegetationExclusions: corridor });
+    const empty = manager({ random: rng(), maxInstances: 2, vegetationExclusions: [] });
+    for (const x of [2, 100, 200]) {
+        for (const m of [legacy, cleared, empty]) m.tryAddInstance(x, 0, sample);
+    }
+    assert.deepEqual(empty.getInstances(), legacy.getInstances());
+    assert.deepEqual(cleared.getInstances(), legacy.getInstances().slice(1));
+    const original = matrices(legacy);
+    assert.deepEqual(matrices(empty), original);
+    assert.deepEqual(matrices(cleared), original.slice(1));
+    for (const m of [legacy, cleared, empty]) m.dispose();
+});
+
+test('World snapshots config and sends exclusions/world offset through initial and streamed chunks', () => {
+    const config = [{ min: { x: -100000, z: -100000 }, max: { x: 100000, z: 100000 } }];
+    const world = new World({}, { vegetationExclusions: config });
+    config[0].min.x = 100000;
+    world.scene = new THREE.Scene();
+    world.camera = new THREE.PerspectiveCamera();
+    for (const [key, offset] of [['0,0', 0], ['1,0', 1]]) {
+        world.pendingChunkCreates.push({ key, chunkX: 0, chunkZ: 0, offset });
+        world.processChunkQueues();
+        const chunk = world.chunks.get(key);
+        const m = chunk.islandLevels[0].vegetationManager;
+        assert.equal(m.vegetationExclusions[0].min.x, -100000);
+        assert.equal(m.worldOffset, offset);
+        m.reset();
+        m.random = () => 0;
+        m.tryAddInstance(0, 0, sample);
+        assert.equal(m.getInstances().length, 0);
+    }
+    world.dispose();
+    assert.equal(world.scene.children.length, 0);
+});
+
+test('disabled keyboard keeps real boat disabled across physics mode changes', () => {
+    globalThis.document = { createElement: () => ({ getContext: () => ({
+        createLinearGradient: () => ({ addColorStop() {} }), fillRect() {}
+    }) }) };
+    const world = new World({});
+    world.scene = new THREE.Scene();
+    world.camera = new THREE.PerspectiveCamera();
+    world.boat = new Boat(world.scene, world.camera);
+    world.setMode('play');
+    world.setKeyboardInputEnabled(false);
+    world.setPhysicsDriven(true);
+    world.setPhysicsDriven(false);
+    world.boat.handleKey({ code: 'KeyW' }, true);
+    assert.equal(world.boat.inputs.forward, false);
+    world.dispose();
+});
+
+test('world offset, finite height and empty config retain nonintersecting trees', () => {
+    const m = manager({ vegetationExclusions: corridor, worldOffset: 1 });
+    m.tryAddInstance(CONFIG.chunkSize + 2, CONFIG.chunkSize, sample);
+    assert.equal(m.getInstances().length, 0);
+    const above = manager({ vegetationExclusions: [{ min: { x: -1, y: 100, z: -1 }, max: { x: 1, y: 110, z: 1 } }] });
+    above.tryAddInstance(0, 0, sample);
+    assert.equal(above.getInstances().length, 1);
+    assert.throws(() => manager({ vegetationExclusions: [{ min: { x: 2, z: 0 }, max: { x: 1, z: 1 } }] }), /bounds/);
+    m.dispose(); above.dispose();
+});
+
+test('excluded trees allocate no meshes; retained instances release without disposing shared assets', () => {
+    const m = manager({ vegetationExclusions: corridor });
+    m.tryAddInstance(2, 0, sample);
+    m.tryAddInstance(100, 0, sample);
+    const parent = new THREE.Group();
+    const [mesh] = m.attach(parent);
+    assert.equal(mesh.count, 1);
+    let released = 0, sharedReleased = 0;
+    mesh.addEventListener('dispose', () => released++);
+    const geometry = mesh.geometry;
+    const onShared = () => sharedReleased++;
+    geometry.addEventListener('dispose', onShared);
+    m.dispose(parent);
+    m.dispose(parent);
+    geometry.removeEventListener('dispose', onShared);
+    assert.equal(released, 1);
+    assert.equal(sharedReleased, 0);
+    assert.equal(parent.children.length, 0);
+});
+
+test('full real palm, broadleaf and grass geometry extents stay outside exclusion volume', () => {
+    for (const typeId of ['palm', 'broadleaf', 'grass']) {
+        const m = manager({ vegetationExclusions: corridor });
+        m.types = m.types.filter(type => type.id === typeId);
+        // All fixture trunks/patch centres are outside the corridor.
+        m.tryAddInstance(1.01, 0, sample);
+        m.tryAddInstance(100, 0, sample);
+        assert.equal(m.getInstances().length, 1, typeId);
+        const [mesh] = m.buildMeshes();
+        const matrix = new THREE.Matrix4();
+        mesh.getMatrixAt(0, matrix);
+        const extent = new THREE.Box3().setFromBufferAttribute(mesh.geometry.attributes.position).applyMatrix4(matrix);
+        assert.ok(extent.min.x > 1, typeId);
+        m.dispose();
+    }
+});
+
+test('all-excluded actual IslandMesh consumes ghost tilts before decorations and later chunk', () => {
+    const originalRandom = Math.random;
+    const originalSampler = getHeightmapState().customSampler;
+    const volume = [{ min: { x: -200, z: -200 }, max: { x: 200, z: 200 } }];
+    const meshMatrices = meshes => meshes.map(mesh => ({
+        type: mesh.userData.typeId,
+        count: mesh.count,
+        matrices: Array.from(mesh.instanceMatrix.array)
+    }));
+    function run(vegetationExclusions) {
+        let draws = 0;
+        Math.random = () => (++draws % 997) * .000001;
+        const islands = [];
+        try {
+            const first = new IslandMesh({ x: 0, z: 0, resolution: 2, vegetationExclusions });
+            islands.push(first);
+            const firstDraws = draws;
+            const later = new IslandMesh({ x: 10, z: 0, resolution: 2, vegetationExclusions });
+            islands.push(later);
+            return {
+                firstInstances: first.vegetationData.length,
+                firstMeshes: first.vegetationMeshes.length,
+                firstDraws,
+                decorations: structuredClone(first.decorationData),
+                decorationMatrices: meshMatrices(first.decorationMeshes),
+                laterInstances: structuredClone(later.vegetationData),
+                laterMatrices: meshMatrices(later.vegetationMeshes),
+                totalDraws: draws
+            };
+        } finally {
+            islands.forEach(island => island.dispose());
+            Math.random = originalRandom;
+        }
+    }
+    try {
+        registerHeightSampler(() => ({ height: 4, normalized: .61, isUnderwater: false }));
+        // Warm shared procedural assets before measuring the common deterministic stream.
+        new IslandMesh({ x: 0, z: 0, resolution: 1 }).dispose();
+        const legacy = run(undefined);
+        const cleared = run(volume);
+        assert.ok(legacy.firstInstances > 0);
+        assert.ok(legacy.decorations.length > 0);
+        assert.ok(legacy.laterInstances.length > 0);
+        assert.equal(cleared.firstInstances, 0);
+        assert.equal(cleared.firstMeshes, 0);
+        assert.equal(cleared.firstDraws, legacy.firstDraws, 'ghost tilts consume original first-chunk draws');
+        assert.deepEqual(cleared.decorations, legacy.decorations);
+        assert.deepEqual(cleared.decorationMatrices, legacy.decorationMatrices);
+        assert.deepEqual(cleared.laterInstances, legacy.laterInstances);
+        assert.deepEqual(cleared.laterMatrices, legacy.laterMatrices);
+        assert.equal(cleared.totalDraws, legacy.totalDraws);
+    } finally {
+        Math.random = originalRandom;
+        registerHeightSampler(originalSampler);
+    }
+});
