+/** Core heading is +X toward +Z; ship bow is +Z and starboard is -X. */
+export function physicsVisualToPose(visual) {
+    return {
+        position: { ...visual.position },
+        yaw: Math.PI / 2 - visual.heading,
+        pitch: -visual.pitch,
+        heel: visual.heel,
+        speed: Math.hypot(visual.velocity.x, visual.velocity.z)
+    };
+}
