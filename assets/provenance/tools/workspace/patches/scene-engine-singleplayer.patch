+    world.setPhysicsDriven(false);
+    world.boat.handleKey({ code: 'KeyW' }, true);
+    assert.equal(world.boat.inputs.forward, true);
+    world.update(.1, 8);
+    assert.notEqual(world.boat.position.x, 71);
+    world.dispose();
+});
+
+test('optional wind override clears to ambient while physics wind retains incoming convention and phase', () => {
+    const world = worldFixture();
+    const wind = world.windSystem = new WindSystem(world.scene, world.camera);
+    assert.equal(typeof wind.setWind, 'function');
+    assert.equal(typeof wind.clearWindOverride, 'function');
+    wind.setWind(new THREE.Vector3(3, 0, 4), 12);
+    wind.update(.1, 65);
+    near(wind.getWindData().direction.x, .6);
+    near(wind.getWindData().direction.z, .8);
+    near(wind.getWindData().speed, 12);
