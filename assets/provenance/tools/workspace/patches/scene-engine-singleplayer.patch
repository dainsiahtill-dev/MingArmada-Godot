+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import * as boatModule from '../src/engine/vehicles/Boat.js';
+import { World } from '../src/engine/world/World.js';
+import { WindSystem } from '../src/engine/environment/WindSystem.js';
+import { ProjectedWaterSurface } from '../src/engine/water/ProjectedWaterSurface.js';
+import { OriginalWaterSurface } from '../src/engine/water/OriginalWaterSurface.js';
+import { TerrainChunk } from '../src/engine/world/Chunk.js';
+import { IslandVegetationManager } from '../src/engine/world/IslandVegetationManager.js';
+import { BeachDecorationManager } from '../src/engine/world/BeachDecorationManager.js';
+import { Assets } from '../src/engine/assets/Assets.js';
+import { globalUniforms } from '../src/config/constants.js';
+import { createOceanWaveUniforms, packOceanWaves, sampleOceanUniforms } from '../src/engine/water/oceanWaves.js';
+
+globalThis.window = new EventTarget();
+globalThis.document = { createElement: () => ({
+    getContext: () => ({ createLinearGradient: () => ({ addColorStop() {} }), fillRect() {} })
+}), createElementNS: () => new EventTarget() };
+const near = (actual, expected) => assert.ok(Math.abs(actual - expected) < 1e-10, `${actual} != ${expected}`);
+const visual = (heading = 0) => ({ position: { x: 31, y: 2, z: -17 }, velocity: { x: 3, y: 99, z: 4 }, heading, pitch: 0, heel: 0 });
+const camera = () => new THREE.PerspectiveCamera(55, 1, 1, 5000);
+
+test('projected surface samples the unchanged original long-wave shader', () => {
+    const water = new ProjectedWaterSurface({ camera: camera(), resolution: 16 });
+    for (const [x, z, time] of [[0, 0, 1], [895, 337, 0], [-451, 216, 37], [671, 110, 2736.883333], [3000, -2000, 7200]]) {
+        const speed = time * 0.5;
+        const expected = Math.sin(x * .02 + speed) * Math.cos(z * .015 + speed * .8) * 2
+            + Math.sin(x * .05 - speed * 1.2)
+            + Math.sin(x * .1 + speed * 2) * Math.cos(z * .11 + speed * 2.1) * .5;
+        near(water.sampleOcean(x, z, time).height, expected);
+    }
+    water.dispose();
+});
+
+for (const [heading, forward, starboard] of [
+    [0, [1, 0, 0], [0, 0, 1]],
+    [Math.PI / 2, [0, 0, 1], [-1, 0, 0]],
+    [Math.PI, [-1, 0, 0], [0, 0, -1]],
+    [-Math.PI / 2, [0, 0, -1], [1, 0, 0]],
+]) {
+    test(`physics pose transforms ship +Z bow and -X starboard at heading ${heading}`, () => {
+        assert.equal(typeof boatModule.physicsVisualToPose, 'function');
+        const pose = boatModule.physicsVisualToPose(visual(heading));
+        const ship = new THREE.Object3D();
+        ship.rotation.set(pose.pitch, pose.yaw, pose.heel, 'YXZ');
+        const bow = new THREE.Vector3(0, 0, 1).applyQuaternion(ship.quaternion);
+        const side = new THREE.Vector3(-1, 0, 0).applyQuaternion(ship.quaternion);
+        bow.toArray().forEach((value, index) => near(value, forward[index]));
+        side.toArray().forEach((value, index) => near(value, starboard[index]));
+    });
+}
+
+test('positive physics pitch lifts bow and positive heel lowers starboard', () => {
+    assert.equal(typeof boatModule.physicsVisualToPose, 'function');
+    const pose = boatModule.physicsVisualToPose({ ...visual(), pitch: 0.2, heel: 0.3 });
+    const ship = new THREE.Object3D();
+    ship.rotation.set(pose.pitch, pose.yaw, pose.heel, 'YXZ');
+    assert.ok(new THREE.Vector3(0, 0, 1).applyQuaternion(ship.quaternion).y > 0);
+    assert.ok(new THREE.Vector3(-1, 0, 0).applyQuaternion(ship.quaternion).y < 0);
+});
+
+test('external drive keeps authoritative pose and camera proxy despite engine keys', () => {
+    const boat = new boatModule.Boat(new THREE.Scene(), camera());
+    const world = new World({});
+    world.boat = boat;
+    world.setMode('play');
+    assert.equal(typeof world.setPhysicsDriven, 'function');
+    world.setPhysicsDriven(true);
+    world.applyPhysicsState(visual(), { length: 42, width: 10, draft: 3 });
+    boat.handleKey({ code: 'KeyW' }, true);
+    boat.setInputEnabled(true);
+    world.update(0.1, 8);
+    boat.update(0.1, 8);
+    assert.deepEqual(boat.position.toArray(), [31, 2, -17]);
+    near(boat.speed, 5);
+    near(boat.heading, Math.PI / 2);
+    assert.equal(boat.dimensions.length, 42);
+    assert.equal(boat.dimensions.width, 10);
+    assert.equal(boat.dimensions.draft, 3);
+    assert.equal(boat.inputs.forward, false);
+    assert.ok(boat.getCameraFollowPose().eye.x < boat.position.x);
+    world.dispose();
+});
+
+test('external incoming wind remains authoritative while visual flow moves oppositely', () => {
+    const wind = new WindSystem(new THREE.Scene(), camera());
+    assert.equal(typeof wind.setWindFromPhysics, 'function');
+    wind.setWindFromPhysics({ x: 3, y: 4 }, 12);
+    wind.update(0.1, 65);
+    wind.update(0.1, 120);
+    near(wind.getWindData().direction.x, 0.6);
+    near(wind.getWindData().direction.z, 0.8);
+    near(wind.getWindData().speed, 12);
+    const flow = new THREE.Vector3(0, 0, 1).applyQuaternion(wind.mesh.quaternion);
+    near(flow.x, -0.6);
+    near(flow.z, -0.8);
+    near(wind.material.uniforms.uTime.value, 120);
+    wind.dispose();
+});
+
+test('wave descriptor helper reproduces independent height and gradient', () => {
+    const uniforms = createOceanWaveUniforms();
+    packOceanWaves(uniforms, [
+        { direction: { x: 1, y: 0 }, amplitude: 2, wavelength: 8, speed: 3 },
+        { direction: { x: 0, y: 1 }, amplitude: 0.5, wavelength: 4, speed: -2 },
+    ]);
+    assert.equal(uniforms.uWaveCount.value, 2);
+    const sample = sampleOceanUniforms(uniforms, 0, 0, Math.PI / 6);
+    near(sample.height, 2 - Math.sqrt(3) / 4);
+    near(sample.gradient.x, 0);
+    near(sample.gradient.z, Math.PI / 8);
+    const normal = new THREE.Vector3(0, 1, -Math.PI / 8).normalize();
+    near(sample.normal.y, normal.y);
+    near(sample.normal.z, normal.z);
+    packOceanWaves(uniforms, []);
+    assert.equal(uniforms.uWaveCount.value, 0);
+});
+
+test('wave slots clear when shrinking and reject more than eight authoritative waves', () => {
+    const uniforms = createOceanWaveUniforms();
+    const wave = { direction: { x: 1, y: 0 }, amplitude: 1, wavelength: 8, speed: 3 };
+    packOceanWaves(uniforms, Array.from({ length: 8 }, () => wave));
+    packOceanWaves(uniforms, [wave]);
+    assert.equal(uniforms.uWaveAmplitudes.value[1], 0);
+    assert.throws(() => packOceanWaves(uniforms, Array.from({ length: 9 }, () => wave)), /eight/i);
+});
+
+test('quality chunk resolution is chosen at construction and teardown preserves cached textures', () => {
+    const texture = new THREE.Texture();
+    let disposed = false;
+    texture.addEventListener('dispose', () => disposed = true);
+    Assets.waterTexture = texture;
+    const chunk = new TerrainChunk(0, 0, new THREE.Scene(), { resolution: 40 });
+    assert.equal(chunk.islandLevels[0].resolution, 40);
+    assert.equal(chunk.islandLevels[1].resolution, 24);
+    chunk.dispose();
+    const water = new ProjectedWaterSurface({ resolution: 16 });
+    water.dispose();
+    assert.equal(disposed, false);
+    Assets.waterTexture = null;
+});
+
+test('World quality changes clear stale queues, select radius, and teardown releases keyboard listeners', () => {
+    const scene = new THREE.Scene();
+    const world = new World({}, { quality: 'balanced' });
+    world.boat = new boatModule.Boat(scene, camera());
+    world.scene = scene;
+    world.camera = camera();
+    world.sunLight = new THREE.DirectionalLight();
+    assert.equal(typeof world.setQuality, 'function');
+    world.setQuality('low');
+    world.updateChunks();
+    assert.equal(world.requiredChunkKeys.size, 25);
+    assert.equal(world.chunks.values().next().value.islandLevels[0].resolution, 40);
+    assert.equal(world.sunLight.castShadow, false);
+    const boat = world.boat;
+    world.dispose();
+    const event = new Event('keydown');
+    event.code = 'KeyW';
+    window.dispatchEvent(event);
+    assert.equal(boat.inputs.forward, false);
+    assert.equal(scene.children.length, 0);
+    assert.equal(world.chunks.size, 0);
+    assert.equal(world.pendingChunkCreates.length, 0);
+    world.dispose();
+});
+
+test('wind teardown releases InstancedMesh GPU resources', () => {
+    const wind = new WindSystem(new THREE.Scene(), camera());
+    let released = 0;
+    wind.mesh.addEventListener('dispose', () => released++);
+    wind.dispose();
+    assert.equal(released, 1);
+});
+
+test('original water teardown releases reflection framebuffer', () => {
+    const water = new OriginalWaterSurface({ size: 20 });
+    const reflectionTarget = water.water.material.uniforms.mirrorSampler.value.renderTarget;
+    let released = 0;
+    reflectionTarget.addEventListener('dispose', () => released++);
+    water.dispose();
+    assert.equal(released, 1);
+});
+
+for (const [Manager, typeId] of [[IslandVegetationManager, 'palm'], [BeachDecorationManager, 'shell']]) {
+    test(`${typeId} teardown releases instances while preserving shared geometry and materials`, () => {
+        const manager = new Manager({ random: () => 0 });
+        manager.tryAddInstance(1, 3, { height: 2, normalized: 0.6, isUnderwater: false });
+        const parent = new THREE.Group();
+        const [mesh] = manager.attach(parent);
+        assert.equal(mesh.count, 1);
+        assert.equal(mesh.userData.typeId, typeId);
+        let instanceReleased = 0, sharedReleased = 0;
+        mesh.addEventListener('dispose', () => instanceReleased++);
+        mesh.geometry.addEventListener('dispose', () => sharedReleased++);
+        mesh.material.addEventListener('dispose', () => sharedReleased++);
+        manager.dispose(parent);
+        assert.equal(instanceReleased, 1);
+        assert.equal(sharedReleased, 0);
+        assert.equal(parent.children.length, 0);
+    });
+}
