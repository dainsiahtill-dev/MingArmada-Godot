+    world.update(.1, 120);
+    assert.ok(wind.getWindData().speed >= 25 && wind.getWindData().speed <= 35);
+    world.dispose();
+});
+
+test('manual wind override accepts upstream partial direction and speed updates', () => {
+    const world = worldFixture();
+    const wind = world.windSystem = new WindSystem(world.scene, world.camera);
+    wind.setWind(new THREE.Vector3(3, 0, 4), 12);
+    wind.setWind(undefined, 18);
+    wind.update(.1, 10);
+    near(wind.currentSpeed, 18);
+    near(wind.direction.x, .6);
