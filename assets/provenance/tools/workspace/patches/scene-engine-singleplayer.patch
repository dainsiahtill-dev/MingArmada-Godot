diff --git a/src/engine/water/oceanWaves.js b/src/engine/water/oceanWaves.js
new file mode 100644
index 0000000000000000000000000000000000000000..b71f83002e9451e3513c9fa7f03da5d99406743b
--- /dev/null
+++ b/src/engine/water/oceanWaves.js
@@ -0,0 +1,96 @@
+import * as THREE from 'three';
+
+export const MAX_OCEAN_WAVES = 8;
+
+// Exact sin(a)cos(b) expansion of the original ProjectedWaterShader. Keep the
+// renderer intact; physics and wakes adapt to its existing world-space waves.
+const originalWave = (amplitude, x, z, speed) => {
+    const k = Math.hypot(x, z);
+    return Object.freeze({ amplitude, direction: Object.freeze({ x: x / k, y: z / k }), wavelength: 2 * Math.PI / k, speed });
+};
+export const ORIGINAL_PROJECTED_WAVES = Object.freeze([
+    originalWave(1, .02, .015, .9),
+    originalWave(1, .02, -.015, .1),
+    originalWave(1, .05, 0, -.6),
+    originalWave(.25, .1, .11, 2.05),
+    originalWave(.25, .1, -.11, -.05)
+]);
+
+export function sampleOriginalProjectedOcean(x, z, time) {
+    let height = 0, gradX = 0, gradZ = 0;
+    for (const wave of ORIGINAL_PROJECTED_WAVES) {
+        const k = 2 * Math.PI / wave.wavelength;
+        const phase = k * (wave.direction.x * x + wave.direction.y * z) + wave.speed * time;
+        height += wave.amplitude * Math.sin(phase);
+        const slope = wave.amplitude * k * Math.cos(phase);
+        gradX += wave.direction.x * slope;
+        gradZ += wave.direction.y * slope;
+    }
+    const normal = new THREE.Vector3(-gradX, 1, -gradZ).normalize();
+    return { height, gradient: { x: gradX, z: gradZ }, normal: { x: normal.x, y: normal.y, z: normal.z } };
+}
+
+export function createOceanWaveUniforms() {
+    return {
+        uWaveCount: { value: 0 },
+        uWaveDirections: { value: Array.from({ length: MAX_OCEAN_WAVES }, () => new THREE.Vector2()) },
+        uWaveAmplitudes: { value: Array(MAX_OCEAN_WAVES).fill(0) },
+        uWaveNumbers: { value: Array(MAX_OCEAN_WAVES).fill(0) },
+        uWaveSpeeds: { value: Array(MAX_OCEAN_WAVES).fill(0) }
+    };
+}
+
+export function packOceanWaves(uniforms, waves) {
+    if (waves.length > MAX_OCEAN_WAVES) throw new RangeError('At most eight ocean waves are supported');
+    for (const wave of waves) {
+        if (!Number.isFinite(wave.wavelength) || wave.wavelength <= 0 ||
+            ![wave.direction.x, wave.direction.y, wave.amplitude, wave.speed].every(Number.isFinite)) {
+            throw new TypeError('Ocean waves need finite direction, amplitude, speed and positive wavelength');
+        }
+    }
+    uniforms.uWaveCount.value = waves.length;
+    for (let i = 0; i < MAX_OCEAN_WAVES; i++) {
+        const wave = waves[i];
+        uniforms.uWaveDirections.value[i].set(wave?.direction.x ?? 0, wave?.direction.y ?? 0);
+        uniforms.uWaveAmplitudes.value[i] = wave?.amplitude ?? 0;
+        uniforms.uWaveNumbers.value[i] = wave ? 2 * Math.PI / wave.wavelength : 0;
+        uniforms.uWaveSpeeds.value[i] = wave?.speed ?? 0;
+    }
+}
+
+/** CPU probe of the actual packed GPU contract, useful to consumers and diagnostics. */
+export function sampleOceanUniforms(uniforms, x, z, time) {
+    let height = 0, gradX = 0, gradZ = 0;
+    for (let i = 0; i < uniforms.uWaveCount.value; i++) {
+        const direction = uniforms.uWaveDirections.value[i];
+        const amplitude = uniforms.uWaveAmplitudes.value[i];
+        const k = uniforms.uWaveNumbers.value[i];
+        const phase = k * (direction.x * x + direction.y * z) + uniforms.uWaveSpeeds.value[i] * time;
+        height += amplitude * Math.sin(phase);
+        const derivative = amplitude * k * Math.cos(phase);
+        gradX += direction.x * derivative;
+        gradZ += direction.y * derivative;
+    }
+    const normal = new THREE.Vector3(-gradX, 1, -gradZ).normalize();
+    return { height, gradient: { x: gradX, z: gradZ }, normal: { x: normal.x, y: normal.y, z: normal.z } };
+}
+
+// Shared verbatim by both shader stages. Return (height, dHeight/dX, dHeight/dZ).
+export const OCEAN_WAVE_GLSL = `
+    uniform int uWaveCount;
+    uniform vec2 uWaveDirections[8];
+    uniform float uWaveAmplitudes[8];
+    uniform float uWaveNumbers[8];
+    uniform float uWaveSpeeds[8];
+    vec3 sampleOceanWaves(vec2 worldXZ) {
+        vec3 sampleValue = vec3(0.0);
+        for (int i = 0; i < 8; i++) {
+            if (i >= uWaveCount) break;
+            float phase = uWaveNumbers[i] * dot(uWaveDirections[i], worldXZ) + uWaveSpeeds[i] * uTime;
+            float gradient = uWaveAmplitudes[i] * uWaveNumbers[i] * cos(phase);
+            sampleValue.x += uWaveAmplitudes[i] * sin(phase);
+            sampleValue.yz += gradient * uWaveDirections[i];
+        }
+        return sampleValue;
+    }
+`;
