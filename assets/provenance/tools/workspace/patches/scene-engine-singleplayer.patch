+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { World } from '../src/index.js';
+import { Boat } from '../src/engine/vehicles/Boat.js';
+import { WindSystem } from '../src/engine/environment/WindSystem.js';
+import { CameraController } from '../src/engine/controls/CameraController.js';
+import { OriginalWaterSurface } from '../src/engine/water/OriginalWaterSurface.js';
+import { ProjectedWaterSurface } from '../src/engine/water/ProjectedWaterSurface.js';
+
+globalThis.window = new EventTarget();
+globalThis.document = { createElement: () => ({ getContext: () => ({
+    createLinearGradient: () => ({ addColorStop() {} }), fillRect() {}
+}) }), createElementNS: () => new EventTarget() };
+const near = (actual, expected) => assert.ok(Math.abs(actual - expected) < 1e-10, `${actual} != ${expected}`);
+const state = (x = 31, heading = 0) => ({ position: { x, y: 2, z: -17 }, velocity: { x: 3, y: 99, z: 4 }, heading, pitch: .2, heel: .3 });
+function worldFixture() {
+    const world = new World({});
+    world.scene = new THREE.Scene();
+    world.camera = new THREE.PerspectiveCamera();
+    world.boat = new Boat(world.scene, world.camera);
+    return world;
+}
+
+test('remote snapshots smooth render poses without local forces, keys, or camera ownership', () => {
+    const world = worldFixture();
+    world.setMode('play');
+    const localPosition = world.boat.position.clone();
+    assert.equal(typeof world.syncRemoteBoats, 'function');
+    world.syncRemoteBoats([{ id: 'peer', state: state(), ship: { length: 42, width: 10, draft: 3 } }]);
+    const remote = world.remoteBoats.get('peer');
+    assert.deepEqual(remote.mesh.position.toArray(), [31, 2, -17]);
+    near(remote.mesh.rotation.y, Math.PI / 2);
+    near(remote.mesh.rotation.x, -.2);
+    near(remote.mesh.rotation.z, .3);
+    near(remote.mesh.scale.x, 10 / 6.2);
+    near(remote.mesh.scale.z, 42 / 12);
+    assert.equal(remote.dimensions.draft, 3);
+    remote.setInputEnabled(true);
+    remote.handleKey({ code: 'KeyW' }, true);
+    assert.equal(remote.inputs.forward, false);
+    assert.equal(remote.cameraFollowEnabled, false);
+    const eye = world.camera.position.clone();
+    world.syncRemoteBoats([{ id: 'peer', state: state(71) }]);
+    // Both boats remain externally owned; only remote render interpolation advances.
+    world.setPhysicsDriven(true);
+    world.update(.1, 8);
+    near(remote.position.x, 41);
+    near(remote.position.y, 2);
+    near(remote.position.z, -17);
+    near(remote.speed, 5);
+    assert.deepEqual(world.boat.position.toArray(), localPosition.toArray());
+    assert.deepEqual(world.camera.position.toArray(), eye.toArray());
+    world.dispose();
+});
+
+test('remote removal, clear, reset and world disposal release owned meshes once', () => {
+    const world = worldFixture();
+    assert.equal(typeof world.syncRemoteBoats, 'function');
+    world.syncRemoteBoats([{ id: 'peer', state: state() }]);
+    const remote = world.remoteBoats.get('peer');
+    let released = 0;
+    remote.mesh.children[0].geometry.addEventListener('dispose', () => released++);
+    world.syncRemoteBoats([]);
+    assert.equal(released, 1);
+    assert.equal(remote.mesh.parent, null);
+    world.clearRemoteBoats();
+    world.syncRemoteBoats([{ id: 'next', state: state() }]);
+    world.resetWorld();
+    assert.equal(world.remoteBoats.size, 0);
+    world.syncRemoteBoats([{ id: 'last', state: state() }]);
+    const last = world.remoteBoats.get('last');
+    let lastReleased = 0;
+    last.mesh.children[0].geometry.addEventListener('dispose', () => lastReleased++);
+    world.dispose();
+    world.dispose();
+    assert.equal(lastReleased, 1);
+    assert.equal(world.remoteBoats.size, 0);
+    assert.equal(world.scene.children.length, 0);
+});
+
+test('external local owner toggles preserve immediate pose, draft, and standalone demo input', () => {
+    const world = worldFixture();
+    world.setMode('play');
+    world.boat.handleKey({ code: 'KeyW' }, true);
+    assert.equal(world.boat.inputs.forward, true);
+    world.setPhysicsDriven(true);
+    world.applyPhysicsState(state(), { length: 42, width: 10, draft: 3 });
+    world.applyPhysicsState(state(71));
+    world.update(.1, 8);
+    assert.deepEqual(world.boat.position.toArray(), [71, 2, -17]);
+    assert.equal(world.boat.dimensions.draft, 3);
