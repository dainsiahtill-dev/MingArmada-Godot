+    wind.update(.1, 10);
+    near(wind.currentSpeed, 18);
+    near(wind.direction.x, -1);
+    world.dispose();
+});
+
+test('nonfinite external snapshots and wind leave render state finite and unmodified', () => {
+    const world = worldFixture();
+    world.setPhysicsDriven(true);
+    world.applyPhysicsState(state());
+    world.applyPhysicsState({ ...state(), heading: Infinity });
+    world.update(.1, 8);
