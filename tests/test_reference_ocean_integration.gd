extends SceneTree
const Ocean = preload("res://modules/scene_engine/ocean/projected_ocean.gd")
const Coastal = preload("res://modules/physics_engine/ocean/coastal_wave_field.gd")
var assertions := 0
var failures := 0
func _initialize() -> void: _run.call_deferred()
func check(ok: bool, reason: String) -> void:
	assertions+=1
	if not ok: failures+=1; printerr("FAIL: ",reason)
func _run() -> void:
	var viewport:=SubViewport.new(); viewport.size=Vector2i(1600,900); root.add_child(viewport)
	var camera:=Camera3D.new(); viewport.add_child(camera)
	camera.position=Vector3(30,38,60); camera.look_at(Vector3.ZERO)
	var ocean: MeshInstance3D=Ocean.new(); viewport.add_child(ocean)
	ocean.configure(camera,load("res://assets/textures/waternormals.jpg"),16)
	ocean.configure_reflection(camera); ocean.enable_surface_optics(true)
	var material: ShaderMaterial=ocean.material_override
	check(material.shader.resource_path=="res://modules/scene_engine/ocean/reference_game_water.gdshader","formal style1 uses transplanted demo water material")
	var uniform_names: Array[String]=[]
	for uniform: Dictionary in material.shader.get_shader_uniform_list(): uniform_names.append(str(uniform.name))
	for name: String in ["normal_texture","reference_sparkle_texture","reference_deep_texture","reference_surface_texture","coastal_foam_texture_a","coastal_foam_texture_b","coast_distance_texture"]:
		check(name in uniform_names,"formal fusion consumes the preserved native detail and surf resource: "+name)
	var diagnostic: Dictionary=ocean.get_surface_optics_diagnostics()
	check(diagnostic.reflection_method=="planar-subviewport" and diagnostic.offscreen_targets==1,"formal entry uses actual planar target instead of SSR")
	check(bool(diagnostic.get("transparent_objects_supported",false)),"shared-world planar target supports ordinary transparent 3D materials")
	check(diagnostic.includes_transparent_objects,"active planar diagnostics do not inherit the old SSR transparency exclusion")
	check(ocean.has_method("get_sky_material"),"formal world can attach the source sky")
	check(ocean.has_method("set_near_shore_field"),"formal foam can read actual local terrain mesh height")
	check(material.get_shader_parameter("wave_count")==5,"formal source optics keep existing five-wave contract")
	var before: Variant=material.get_shader_parameter("wave_components")
	var height:=Image.create(3,3,false,Image.FORMAT_RF); height.fill(Color(-4,0,0))
	var texture:=ImageTexture.create_from_image(height)
	ocean.set_shore_field(texture,Vector4(-100,-200,300,400))
	if ocean.has_method("set_near_shore_field"):
		ocean.set_near_shore_field(texture,Vector4(10,20,50,60))
		check(material.get_shader_parameter("reference_near_height_texture")==texture,"near field forwards actual mesh RF texture")
		check(material.get_shader_parameter("reference_near_bounds")==Vector4(10,20,50,60),"near field preserves world bounds")
		check(material.get_shader_parameter("has_reference_near_field")==true,"near field activates only a valid region")
	ocean.set_simulation_time(12.25); ocean.update_projection()
	check(material.get_shader_parameter("simulation_time")==12.25 and material.get_shader_parameter("u_time")==12.25,"physics and source optics share accepted time")
	check(material.get_shader_parameter("wave_components")==before,"source optics do not alter accepted five-wave values")
	if ocean.has_method("get_sky_material"): check(ocean.get_sky_material()!=null,"source sky can be bound in the formal environment")
	var accepted_width: Variant=material.get_shader_parameter("u_foam_width")
	check(not ocean.set_reference_surface_state({"foamWidth":0.0}),"zero foam width is rejected before shader smoothstep")
	check(not ocean.set_reference_surface_state({"foamWidth":-1.0}),"negative foam width is rejected")
	check(not ocean.set_reference_surface_state({"strength":NAN,"foamWidth":2.0}),"invalid source state rejects the whole update")
	check(not ocean.set_reference_surface_state({"waves":false}),"render-only state cannot disable authoritative physical waves")
	check(not ocean.set_reference_surface_state({"tide":1.0}),"render-only state cannot move the authoritative sea level")
	check(material.get_shader_parameter("u_foam_width")==accepted_width,"rejected source update preserves accepted foam width")
	var accepted_texture: Variant=material.get_shader_parameter("shore_height_texture")
	var accepted_bounds: Variant=material.get_shader_parameter("shore_bounds")
	var one_pixel:=Image.create(1,1,false,Image.FORMAT_RF); one_pixel.fill(Color(-2,0,0))
	var undersized:=ImageTexture.create_from_image(one_pixel)
	ocean.set_shore_field(undersized,Vector4(-10,-10,10,10))
	check(material.get_shader_parameter("shore_height_texture")==accepted_texture,"one-pixel global RF cannot enter a four-texel sampler")
	ocean.set_shore_field(texture,Vector4(NAN,-10,10,10))
	check(material.get_shader_parameter("shore_bounds")==accepted_bounds,"nonfinite global bounds preserve the previous coastal field")
	ocean.set_shore_field(texture,Vector4(-100,-200,300,400))
	if ocean.has_method("get_reflection_viewport"):
		var reflected: SubViewport=ocean.get_reflection_viewport()
		check(reflected.size==Vector2i(768,432),"formal mirror retains original aspect and 768 width")
		var nodes:=ocean.get_child_count()
		ocean.update_projection(); ocean.set_simulation_time(12.25); ocean.update_projection()
		check(ocean.get_child_count()==nodes and ocean.get_reflection_viewport()==reflected,"accepted paused frame reuses real reflection nodes")
		ocean.set_reflection_enabled(false)
		check(reflected.render_target_update_mode==SubViewport.UPDATE_DISABLED,"formal reflection toggle actually disables mirror target")
		ocean.set_reflection_enabled(true)
		check(reflected.render_target_update_mode==SubViewport.UPDATE_ALWAYS,"formal reflection toggle restores same mirror target")
		viewport.remove_child(ocean); ocean.update_projection()
		check(not ocean.get_surface_optics_diagnostics().enabled,"detached water disables its real optics attachment")
		check(reflected.render_target_update_mode==SubViewport.UPDATE_DISABLED,"detached water stops the real mirror target")
		viewport.add_child(ocean); ocean.update_projection()
		check(ocean.get_surface_optics_diagnostics().enabled,"reattached water restores optics without a new target")
		check(ocean.get_reflection_viewport()==reflected,"water reattachment reuses the accepted mirror target")
		camera.h_offset=2.75; camera.v_offset=-1.25; ocean.update_projection()
		check(material.get_shader_parameter("u_eye").distance_to(camera.get_camera_transform().origin)<.00001,"source optics use the actual camera eye including offsets")
		camera.h_offset=0.0; camera.v_offset=0.0; ocean.update_projection()
		var mirror: Camera3D=ocean.get_reflection_camera()
		camera.environment=Environment.new(); camera.cull_mask=(1<<19)|1|(1<<7)
		camera.set_perspective(68.0,.15,2200.0); ocean.update_projection()
		check(mirror.environment==camera.environment,"mirror uses the actual game environment")
		check(mirror.cull_mask==(1|(1<<7)),"mirror preserves game layers while excluding every ocean surface")
		check(mirror.fov==68.0 and is_equal_approx(mirror.near,.15) and mirror.far==2200.0,"mirror tracks changed game lens and clip planes")
		var alternate:=SubViewport.new(); alternate.size=Vector2i(600,900); alternate.own_world_3d=true; root.add_child(alternate)
		var second_camera:=Camera3D.new(); alternate.add_child(second_camera)
		second_camera.position=Vector3(-15,22,35); second_camera.look_at(Vector3.ZERO)
		ocean.configure(second_camera,load("res://assets/textures/waternormals.jpg"),16)
		check(not ocean.get_surface_optics_diagnostics().enabled,"changing the projection camera requires explicit optical ownership")
		ocean.configure_reflection(second_camera); ocean.update_projection()
		check(ocean.get_reflection_viewport()==reflected and reflected.world_3d==second_camera.get_world_3d(),"camera replacement reuses mirror nodes and switches the shared source world")
		check(mirror.global_position.distance_to(Vector3(-15,-22,35))<.00001,"camera replacement updates the true reflected eye")
		check(reflected.size==Vector2i(600,900),"camera replacement updates the aspect using its source viewport")
		ocean.configure(camera,load("res://assets/textures/waternormals.jpg"),16); ocean.configure_reflection(camera)
		alternate.free()
	var first_mesh:=ocean.mesh
	var old_uniforms: Variant=material.get_shader_parameter("wave_components")
	var renderer_reference: WeakRef=weakref(ocean.get_reflection_viewport())
	ocean.set_visual_style(0)
	check(material.shader.resource_path=="res://modules/scene_engine/ocean/original_water.gdshader","formal historical style retains original shader")
	check(ocean.get_surface_optics_diagnostics().offscreen_targets==0,"historical style disposes real mirror resources")
	check(ocean.layers==1,"historical style restores the original caller render layer")
	check(renderer_reference.get_ref()==null,"historical style releases the previous mirror target")
	ocean.set_visual_style(1)
	check(material.shader.resource_path=="res://modules/scene_engine/ocean/reference_game_water.gdshader" and ocean.mesh==first_mesh,"restored formal source material reuses existing projected mesh")
	check(material.get_shader_parameter("wave_components")==old_uniforms,"style round trip preserves accepted wave input")
	check(ocean.layers==(1<<19),"restored formal ocean returns to its excluded reflection layer")
	viewport.remove_child(camera); ocean.update_projection()
	check(not ocean.get_surface_optics_diagnostics().enabled,"camera detach safely stops source optics")
	viewport.add_child(camera); ocean.update_projection()
	check(ocean.get_surface_optics_diagnostics().enabled,"camera reattach restores real mirror path")
	_check_wave_uniform_pipeline(material)
	var reflection_reference: WeakRef=weakref(ocean.get_reflection_viewport())
	ocean.free()
	check(reflection_reference.get_ref()==null,"freeing a formal ocean releases its real mirror viewport")
	camera.free(); viewport.free()
	print("REFERENCE_OCEAN_INTEGRATION_TESTS assertions=",assertions," failures=",failures)
	quit(1 if failures else 0)

func _check_wave_uniform_pipeline(material: ShaderMaterial) -> void:
	# Independent scalar evaluation of the actual accepted GPU uniforms. This is
	# a CPU/uniform contract test; the root capture suite verifies GPU execution.
	var components: PackedVector4Array=material.get_shader_parameter("wave_components")
	var count:=int(material.get_shader_parameter("wave_count"))
	var physics:=Coastal.new()
	check(physics.configure(func(x: float,z: float): return -.8-x*.03-z*.01),"coastal oracle accepts an independently linear depth field")
	for seconds: float in [0.0,1.0,12.25,-2.0]:
		for point: Vector2 in [Vector2(-80,-20),Vector2.ZERO,Vector2(70,40),Vector2(350,120)]:
			var height:=0.0
			var gradient:=Vector2.ZERO
			for index in count:
				var wave:=components[index]
				var phase:=point.dot(Vector2(wave.y,wave.z))+wave.w*seconds
				height+=wave.x*sin(phase)
				gradient+=wave.x*cos(phase)*Vector2(wave.y,wave.z)
			var depth:=.8+point.x*.03+point.y*.01
			var t:=clampf(depth/8.0,0.0,1.0)
			var scale:=t*t*(3.0-2.0*t)
			var derivative:=6.0*t*(1.0-t)/8.0
			gradient=gradient*scale+height*derivative*Vector2(.03,.01)
			var expected: Dictionary=physics.sample(point.x,point.y,seconds)
			check(absf(height*scale-expected.height)<.000002,"accepted packed shader waves retain coastal CPU height")
			check(Vector3(-gradient.x,1,-gradient.y).normalized().distance_to(expected.normal)<.000002,"accepted packed shader waves retain coastal CPU normal")
