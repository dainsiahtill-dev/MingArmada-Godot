extends SceneTree
const Renderer=preload("res://modules/scene_engine/fidelity_fx/source_shadow_renderer.gd")
const Effect=preload("res://modules/scene_engine/fidelity_fx/source_shadow_compositor.gd")
const Backend=preload("res://modules/scene_engine/fidelity_fx/source_shadow_rd.gd")
var failures:=0
func check(ok:bool,label:String)->void:
	if not ok:failures+=1;printerr("FAIL ",label)
func _initialize()->void:call_deferred("run")
func run()->void:
	var world:=Node3D.new();root.add_child(world)
	var camera:=Camera3D.new();world.add_child(camera)
	var actor:=Node3D.new();world.add_child(actor)
	var explicit_actor:=Node3D.new();world.add_child(explicit_actor)
	var renderer:=Renderer.new();renderer.configure(world,camera)
	var explicit_plane:=renderer.attach_ship_texture_plane(explicit_actor,"fluyt")
	var request:Dictionary={"sourceShadows":{"texturePlanes":{"a":"fluyt"}}}
	renderer.apply_snapshot(request,{"a":actor},{"epoch":1})
	check(actor.get_child_count()==1 and renderer.diagnostics().texturePlaneCount==2,"snapshot attach")
	var first_id:int=actor.get_child(0).get_instance_id()
	renderer.apply_snapshot(request,{"a":actor},{"epoch":1})
	check(actor.get_child(0).get_instance_id()==first_id,"same snapshot retains plane")
	renderer.apply_snapshot({}, {"a":actor},{"epoch":1})
	check(actor.get_child_count()==0 and renderer.diagnostics().texturePlaneCount==1,"empty snapshot removes owned plane")
	check(is_instance_valid(explicit_plane),"snapshot removal preserves imperative owner")
	renderer.apply_snapshot(request,{"a":actor},{"epoch":1})
	renderer.apply_snapshot({"sourceShadows":{"texturePlanes":{"a":"sloop"}}},{"a":actor},{"epoch":1})
	check(actor.get_child_count()==0,"resource change removes old selected resource")
	renderer.apply_snapshot(request,{"a":actor},{"epoch":1})
	first_id=actor.get_child(0).get_instance_id()
	renderer.apply_snapshot(request,{"a":actor},{"epoch":2})
	check(actor.get_child_count()==1 and actor.get_child(0).get_instance_id()!=first_id,"epoch rebuilds snapshot attachment")
	check(is_instance_valid(explicit_plane),"epoch preserves imperative owner")
	renderer.apply_snapshot(request,{}, {"epoch":2})
	check(actor.get_child_count()==0,"missing actor mapping removes snapshot plane")
	renderer.apply_snapshot(request,{"a":actor},{"epoch":2})
	var adopted:=renderer.attach_ship_texture_plane(actor,"fluyt")
	renderer.apply_snapshot({}, {}, {"epoch":3})
	check(is_instance_valid(adopted) and actor.get_child_count()==1,"imperative adoption preserves one shared attachment")
	actor.free();explicit_actor.free()
	check(renderer.diagnostics().texturePlaneCount==0,"diagnostics prunes freed actors without another snapshot")
	renderer.apply_snapshot({}, {}, {"epoch":4})
	check(renderer.diagnostics().texturePlaneCount==0,"dead entries remain pruned")
	renderer.dispose();world.free()
	# Exercise real backend retirement/control flow in headless mode. Empty RID
	# lists avoid fabricating a device; physical RID release is GPU-probed too.
	var effect:=Effect.new();var backend:=Backend.new();var owned:Array[RID]=[]
	backend.set("_mesh_cache",{"retired:1":{"owned":owned}})
	effect.set("_backend",backend);effect.submit([],Color.BLACK)
	effect._render_callback(effect.effect_callback_type,null)
	check(backend.get("_mesh_cache").is_empty(),"empty compositor submission retires last geometry")
	check(backend.draw_count==0,"empty retirement does not issue draw")
	effect.set("_backend",null)
	print("SOURCE_SHADOW_LIFECYCLE failures=",failures)
	quit(1 if failures else 0)
