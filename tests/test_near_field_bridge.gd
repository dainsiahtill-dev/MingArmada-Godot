extends SceneTree
const Campaign = preload("res://game/domain/mingqi/campaign.gd")
const Encounter = preload("res://modules/naval_simulation/encounter.gd")
const Simulation = preload("res://game/runtime/sailing_simulation.gd")
const Bridge = preload("res://game/runtime/near_field_bridge.gd")
var failures := 0
var assertions := 0
func check(ok: bool, detail: String) -> void:
	assertions += 1
	if not ok: failures += 1; printerr("FAIL: ",detail)
func _initialize() -> void:
	var campaign := Campaign.new()
	var epoch: String = campaign.allocate_native_epoch()
	var state: Dictionary = campaign.snapshot()
	var ids: Array = state.vessels.keys().filter(func(id): return id != state.campaignId+"-heritage" and state.vessels[id].ownerId != "enemy")
	var setups: Array = ids.map(func(id): return campaign.near_field_setup(state.vessels[id],"player" if state.vessels[id].profileId in ["flagship","fast"] else "neutral"))
	var policy: Dictionary = campaign.native_policy(ids)
	var encounter := Encounter.new({"mode":"continuous","battleId":epoch,"playerId":state.flagshipId,"ships":setups,"controllableShipIds":policy.controllableShipIds,"hostileTargets":policy.hostileTargets})
	var simulation := Simulation.new(encounter)
	var seen: Array = []
	var bridge := Bridge.new(campaign,simulation,func(events: Array): seen.append_array(events))
	check(campaign.project_native(bridge.command_context().native).ok,"fresh allocated epoch projects actual native fleet")
	check(not state.campaignId+"-heritage" in bridge.near_ids(),"idle inherited berth stays in route representation")
	var accepted: Dictionary = campaign.command({"type":"accept-convoy","commandId":"bridge-test-accept","expectedRevision":campaign.snapshot().revision},bridge.command_context())
	check(accepted.ok,"real convoy contract grants flagship helm authority")
	var context := bridge.command_context()
	check(context.native.validateCurrent.call().ok,"fresh native context validates identity/tick/sequences")
	encounter.command({"type":"controls","rudder":0.25,"sailDeployment":0.0})
	check(not context.native.validateCurrent.call().ok,"controls sequence mutation invalidates cached command context")
	context = bridge.command_context()
	encounter.step(1.0/60)
	check(not context.native.validateCurrent.call().ok,"actual physics tick invalidates old context")
	check(bridge.reconcile().ok,"real bridge reconciles authoritative native observation")
	context = bridge.command_context()
	var projected: Dictionary = context.native.project.call(campaign.snapshot(),[],"live")
	check(projected.ok and not context.native.validateCurrent.call().ok,"context project consumes fence exactly once")
	var before: Dictionary = encounter.snapshot()
	check(not context.native.project.call(campaign.snapshot(),[],"live").ok and before == encounter.snapshot(),"replayed projection rejects without touching engine")
	simulation.set_handling_mode("assisted")
	simulation.set_held("KeyW",true)
	for i in 120: simulation.advance(1.0/60)
	check(simulation.snapshot().ships[0].sailDeployment > 0.9,"real held forward raises sails using input adapter")
	simulation.set_paused(true)
	before = simulation.snapshot()
	simulation.advance(5.0)
	check(before == simulation.snapshot(),"pause freezes actual encounter and rejects accumulated wall time")
	simulation.set_paused(false)
	simulation.advance(1.0/60)
	check(simulation.snapshot().tick == before.tick+1,"resume advances one fresh tick with held keys cleared")
	check(bridge.sync().ok,"safe export synchronization works after real sailing input")
	bridge.dispose()
	print("NEAR_FIELD_BRIDGE_TESTS assertions=",assertions," failures=",failures)
	quit(1 if failures else 0)
