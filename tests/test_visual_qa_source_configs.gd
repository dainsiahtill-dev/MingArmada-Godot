func _initialize() -> void:
	var failures:=0
	var runtime=load("res://game/runtime/visual_qa_runtime.gd")
	var oracle: Dictionary=JSON.parse_string(SOURCE_JSON)
	for id: String in oracle:
		if JSON.parse_string(JSON.stringify(runtime.scenario_config(id),"",true,true))!=oracle[id]:
			failures+=1; printerr("FAIL: exact frozen source config ",id)
			difference(runtime.scenario_config(id),oracle[id],id)
	print("VISUAL_QA_SOURCE_CONFIG_TESTS assertions=15 failures=",failures)
	quit(1 if failures else 0)
func difference(actual,expected,path: String) -> void:
	if actual is Dictionary and expected is Dictionary:
		for key in expected:
			if actual.has(key): difference(actual[key],expected[key],path+"."+str(key))
	elif actual is Array and expected is Array:
		for index in mini(actual.size(),expected.size()): difference(actual[index],expected[index],path+"."+str(index))
	elif actual!=expected: printerr(path," actual=",actual," expected=",expected)
