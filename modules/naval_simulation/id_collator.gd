extends RefCounted
# Frozen host localeCompare seam. Product IDs and audited characters use source
# ICU weights generated by export-naval-reference.mjs. Unsupported external
# Unicode remains accepted and has deterministic scalar fallback, not ICU parity.
const DATA_PATH = "res://modules/naval_simulation/id-collation.json"
static var _shared_data: Dictionary = {}
var _data: Dictionary = {}
func _init() -> void:
	if _shared_data.is_empty(): _shared_data = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	_data = _shared_data
func compare(a: String, b: String) -> int:
	var ak = _key(a)
	var bk = _key(b)
	for level in ["primary", "secondary", "tertiary"]:
		var result = _compare_weights(ak[level], bk[level])
		if result != 0: return result
	return 0
func supports(value: String) -> bool:
	return _key(value).supported
func _key(value: String) -> Dictionary:
	var result = {"primary": [], "secondary": [], "tertiary": [], "supported": true}
	var index = 0
	while index < value.length():
		var match_key = ""
		for length in range(mini(4, value.length() - index), 0, -1):
			var candidate = value.substr(index, length)
			if _data.weights.has(candidate): match_key = candidate; break
		if match_key.is_empty():
			var codepoint = value.unicode_at(index)
			result.primary.append(1000000 + codepoint)
			result.secondary.append(0); result.tertiary.append(0)
			result.supported = false; index += 1
		else:
			var weights = _data.weights[match_key]
			for level in ["primary", "secondary", "tertiary"]: result[level].append_array(weights[level])
			index += match_key.length()
	return result
func _compare_weights(a: Array, b: Array) -> int:
	for index in mini(a.size(), b.size()):
		if a[index] != b[index]: return -1 if a[index] < b[index] else 1
	return -1 if a.size() < b.size() else 1 if a.size() > b.size() else 0
